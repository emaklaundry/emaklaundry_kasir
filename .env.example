# ==============================================
# EMAK LAUNDRY - Environment Configuration
# ==============================================
# Salin ke .env lalu isi nilainya:  cp .env.example .env
# Di Vercel, isi variabel yang sama di Project → Settings → Environment Variables.

# ----------------------------------------------
# SUPABASE (wajib)
# ----------------------------------------------
# Dapatkan dari: Supabase Dashboard > Project Settings > API
# Anon key memang terlihat di browser; keamanan data dijaga Row Level Security.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ----------------------------------------------
# GOOGLE CONTACTS (opsional)
# ----------------------------------------------
# Untuk fitur import kontak Google di halaman Pelanggan.
# Dapatkan dari: https://console.cloud.google.com/apis/credentials (aktifkan People API)

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ----------------------------------------------
# CATATAN
# ----------------------------------------------
# 1. Semua variabel VITE_ terbaca di browser. JANGAN taruh service role key di sini;
#    service role hanya dipakai Edge Functions (otomatis tersedia di Supabase).
# 2. Versi aplikasi (VITE_APP_VERSION) diisi otomatis dari package.json saat build.
# 3. JANGAN commit .env ke Git (sudah ada di .gitignore).
