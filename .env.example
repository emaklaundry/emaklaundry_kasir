# ==============================================
# EMAK LAUNDRY - Environment Configuration
# ==============================================
# Copy file ini ke .env dan isi dengan nilai sebenarnya
# cp .env.example .env

# ----------------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------------
# Dapatkan dari: Supabase Dashboard > Settings > API
# Project URL: https://your-project.supabase.co
# Anon Key: eyJhbGciOi...

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ----------------------------------------------
# OPTIONAL: SUPABASE SERVICE KEY (Server-side only)
# ----------------------------------------------
# HANYA untuk development/testing
# JANGAN PERNAH commit ke repository!
# Dapatkan dari: Supabase Dashboard > Settings > API > Service Role

# SUPABASE_SERVICE_KEY=your-service-key-here

# ----------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------
# Mode: development | production
VITE_APP_ENV=development

# App Name (untuk branding)
VITE_APP_NAME=Emak Laundry

# ----------------------------------------------
# FEATURES FLAGS (Optional)
# ----------------------------------------------
# Enable/disable fitur tertentu

# VITE_ENABLE_PWA=true
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=true

# ----------------------------------------------
# GOOGLE API CONFIGURATION (Optional)
# ----------------------------------------------
# Untuk integrasi Google Contacts
# Dapatkan dari: https://console.cloud.google.com/apis/credentials
# Pastikan People API sudah di-enable

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ----------------------------------------------
# DEPLOYMENT (Optional)
# ----------------------------------------------
# Base URL untuk production deployment

# VITE_BASE_URL=https://your-domain.com

# ----------------------------------------------
# NOTES
# ----------------------------------------------
# 1. Semua variabel dengan prefix VITE_ akan di-expose ke client
# 2. Variabel tanpa VITE_ hanya tersedia di server-side (build time)
# 3. JANGAN commit .env ke Git (sudah ada di .gitignore)
# 4. Update .env.example setiap ada variabel baru
