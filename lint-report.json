talErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import * as React from 'react';\nimport { useParams, Link, useNavigate } from 'react-router-dom';\nimport { useQuery } from '@tanstack/react-query';\nimport { PrinterIcon, ChevronLeftIcon, ShoppingCartIcon } from '../../components/icons';\nimport EmptyState from '../../components/EmptyState';\nimport { useSettings } from '../../contexts/SettingsContext';\nimport { useTransactions } from '../../contexts/TransactionContext';\nimport { fetchCustomers } from '../../contexts/CustomerContext';\nimport { useAuditLogs } from '../../contexts/AuditLogContext';\n\nimport { supabase } from '../../utils/supabaseClient';\n\nconst ReceiptPage: React.FC = () => {\n  const { id } = useParams<{ id: string }>();\n\n  const { settings } = useSettings();\n  const { transactions } = useTransactions();\n  const navigate = useNavigate();\n  const { addAuditLog } = useAuditLogs();\n\n  const { data: customersRaw = [] } = useQuery({\n    queryKey: ['customers', { page: 1, pageSize: 1000 }],\n    queryFn: () => fetchCustomers({ page: 1, pageSize: 1000 }),\n  });\n\n  // Normalize customers to always be an array\n  const customers = Array.isArray(customersRaw) ? customersRaw : (customersRaw?.data ?? []);\n\n  const transaction = transactions.find((t) => t.id === id);\n  const [fetchedTransaction, setFetchedTransaction] = React.useState<any>(null);\n  React.useEffect(() => {\n    if (!transaction && id) {\n      supabase\n        .from('transactions')\n        .select('*')\n        .eq('id', id)\n        .single()\n        .then(({ data }) => {\n          if (data) setFetchedTransaction(data);\n        });\n    }\n  }, [transaction, id]);\n\n  const tx = transaction || fetchedTransaction;\n  const customer = tx ? customers.find((c) => c.id === tx.customerId) : null;\n\n  if (!tx || !customer) {\n    return (\n      <EmptyState\n        icon={<ShoppingCartIcon className=\"mx-auto w-12 h-12 text-slate-400\" />}\n        title=\"Transaksi tidak ditemukan\"\n        description=\"Transaksi yang Anda cari tidak tersedia atau telah dihapus.\"\n      >\n        <Link to=\"/transactions\" className=\"mt-4 inline-block text-blue-600 hover:underline\">\n          Kembali ke Daftar Transaksi\n        </Link>\n      </EmptyState>\n    );\n  }\n\n  const remainingBalance = tx.total - tx.amountPaid;\n\n  return (\n    <div className=\"max-w-md mx-auto bg-slate-50 dark:bg-slate-800 p-8 rounded-lg shadow-lg receipt-print\">\n      <div className=\"text-center mb-8\">\n        <h1 className=\"text-3xl font-bold text-slate-900 dark:text-white\">Laundry POS</h1>\n        <p className=\"text-base text-slate-500 dark:text-slate-400\">Struk Transaksi</p>\n      </div>\n\n      <div className=\"border-b-2 border-dashed border-slate-300 dark:border-slate-600 pb-4 mb-4\">\n        <div className=\"flex justify-between text-base\">\n          <span className=\"text-slate-500 dark:text-slate-400\">No. Invoice</span>\n          <span className=\"font-semibold text-slate-800 dark:text-slate-200\">\n            {tx.invoiceCode || tx.id}\n          </span>\n        </div>\n        <div className=\"flex justify-between text-base\">\n          <span className=\"text-slate-500 dark:text-slate-400\">Tanggal</span>\n          <span className=\"font-semibold text-slate-800 dark:text-slate-200\">\n            {new Date(tx.createdAt).toLocaleString('id-ID')}\n          </span>\n        </div>\n        <div className=\"flex justify-between text-base\">\n          <span className=\"text-slate-500 dark:text-slate-400\">Pelanggan</span>\n          <span className=\"font-semibold text-slate-800 dark:text-slate-200\">{customer.name}</span>\n        </div>\n        <div className=\"flex justify-between text-base\">\n          <span className=\"text-slate-500 dark:text-slate-400\">Status Bayar</span>\n          <span className=\"font-semibold text-slate-800 dark:text-slate-200\">\n            {tx.paymentStatus}\n          </span>\n        </div>\n      </div>\n\n      <div className=\"space-y-2 mb-4\">\n        {tx.items.map((item: any, index: number) => (\n          <div key={index} className=\"flex flex-col text-base py-1\">\n            <div className=\"flex justify-between\">\n              <div>\n                <p className=\"font-semibold text-slate-800 dark:text-slate-200\">\n                  {item.serviceName}\n                </p>\n                <p className=\"text-slate-500 dark:text-slate-400\">\n                  {item.quantity} {item.unit} @ Rp {item.price.toLocaleString('id-ID')}\n                </p>\n              </div>\n              <p className=\"font-semibold text-slate-800 dark:text-slate-200\">\n                Rp {item.subtotal.toLocaleString('id-ID')}\n              </p>\n            </div>\n            {item.itemDetails?.slice(0, item.quantity).some((d: any) => d.note) && (\n              <div className=\"pl-4 mt-1 space-y-0.5\">\n                {item.itemDetails?.slice(0, item.quantity).map(\n                  (detail: any, detailIndex: number) =>\n                    detail.note && (\n                      <p key={detailIndex} className=\"text-sm text-slate-500 dark:text-slate-400\">\n                        - Item #{detailIndex + 1}: {detail.note}\n                      </p>\n                    ),\n                )}\n              </div>\n            )}\n            {item.taggedItems && (\n              <div className=\"pl-4 mt-1\">\n                <p className=\"text-sm text-slate-500 dark:text-slate-400 whitespace-pre-wrap\">\n                  Rincian: {item.taggedItems}\n                </p>\n              </div>\n            )}\n          </div>\n        ))}\n      </div>\n\n      <div className=\"border-t-2 border-dashed border-slate-300 dark:border-slate-600 pt-4 mt-4 space-y-2\">\n        <div className=\"flex justify-between text-base text-slate-600 dark:text-slate-400\">\n          <span>Subtotal</span>\n          <span>Rp {tx.subtotal.toLocaleString('id-ID')}</span>\n        </div>\n        {tx.discount > 0 && (\n          <div className=\"flex justify-between text-base text-slate-600 dark:text-slate-400\">\n            <span>Diskon</span>\n            <span>- Rp {tx.discount.toLocaleString('id-ID')}</span>\n          </div>\n        )}\n        {tx.tax > 0 && (\n          <div className=\"flex justify-between text-base text-slate-600 dark:text-slate-400\">\n            <span>Pajak</span>\n            <span>+ Rp {tx.tax.toLocaleString('id-ID')}</span>\n          </div>\n        )}\n        <div className=\"flex justify-between font-bold text-xl text-slate-900 dark:text-white pt-2 border-t border-slate-300 dark:border-slate-600\">\n          <span>Total</span>\n          <span>Rp {tx.total.toLocaleString('id-ID')}</span>\n        </div>\n      </div>\n\n      <div className=\"border-t-2 border-dashed border-slate-300 dark:border-slate-600 pt-4 mt-4 space-y-2\">\n        <div className=\"flex justify-between text-base text-slate-600 dark:text-slate-400\">\n          <span>Metode Bayar</span>\n          <span>{tx.paymentMethod || '-'}</span>\n        </div>\n        <div className=\"flex justify-between text-base text-slate-600 dark:text-slate-400\">\n          <span>Dibayar</span>\n          <span>Rp {tx.amountPaid.toLocaleString('id-ID')}</span>\n        </div>\n        {tx.change > 0 && (\n          <div className=\"flex justify-between text-base text-slate-600 dark:text-slate-400\">\n            <span>Kembalian</span>\n            <span>Rp {tx.change.toLocaleString('id-ID')}</span>\n          </div>\n        )}\n        <div className=\"flex justify-between font-semibold text-lg text-slate-900 dark:text-white\">\n          <span>Sisa Tagihan</span>\n          <span>Rp {remainingBalance > 0 ? remainingBalance.toLocaleString('id-ID') : 0}</span>\n        </div>\n      </div>\n\n      <div className=\"text-center mt-8 text-sm text-slate-500 dark:text-slate-400\">\n        <p>\n          Estimasi Selesai:{' '}\n          {tx.estimatedCompletionDate\n            ? new Date(tx.estimatedCompletionDate).toLocaleString('id-ID', {\n                dateStyle: 'medium',\n                timeStyle: 'short',\n              })\n            : '-'}\n        </p>\n        <p className=\"mt-2\">\n          {settings?.receiptMessage ?? 'Terima kasih telah menggunakan layanan kami.'}\n        </p>\n      </div>\n\n      <div className=\"mt-10 flex flex-col sm:flex-row gap-4 print-hide\">\n        <button\n          onClick={() => navigate(-1)}\n          className=\"flex-1 flex items-center justify-center text-slate-900 bg-white border border-slate-300 hover:bg-slate-100 font-medium rounded-lg text-lg px-6 py-3.5 dark:bg-slate-700 dark:text-slate-300 dark:border-slate-500 dark:hover:bg-slate-600\"\n        >\n          <ChevronLeftIcon className=\"w-5 h-5 mr-2\" />\n          Kembali\n        </button>\n        <button\n          onClick={() => {\n            if (tx) {\n              addAuditLog(`Mencetak receipt untuk transaksi ${tx.id}.`, tx.storeId);\n            }\n            window.print();\n          }}\n          className=\"flex-1 flex items-center justify-center text-white bg-blue-600 hover:bg-blue-700 font-medium rounded-lg text-lg px-6 py-3\"\n        >\n          <PrinterIcon className=\"w-5 h-5 mr-2\" />\n          Cetak\n        </button>\n      </div>\n    </div>\n  );\n};\n\nexport default ReceiptPage;\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\transactions\\TransactionDetailPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'useNavigate' is defined but never used.","line":2,"column":21,"nodeType":null,"messageId":"unusedVar","endLine":2,"endColumn":32},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'addAuditLog' is assigned a value but never used.","line":43,"column":11,"nodeType":null,"messageId":"unusedVar","endLine":43,"endColumn":22}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useMemo, useState } from 'react';\nimport { useParams, useNavigate } from 'react-router-dom';\nimport { Link } from 'react-router-dom';\nimport { AlertCircle } from 'lucide-react';\nimport { useQuery, useQueryClient } from '@tanstack/react-query';\nimport { useTransactions } from '../../contexts/TransactionContext';\nimport { supabase } from '../../utils/supabaseClient';\nimport { fetchCustomers } from '../../contexts/CustomerContext';\nimport {\n  ChevronLeftIcon,\n  PrinterIcon,\n  UsersIcon,\n  ShoppingCartIcon,\n  // SendIcon, // Import icon Send (unused)\n} from '../../components/icons';\nimport EmptyState from '../../components/EmptyState';\nimport useAppContext from '../../contexts/useAppContext';\nimport useToasts from '../../contexts/useToasts';\nimport PaymentModal from '../../components/PaymentModal';\nimport WhatsAppModal from '../../components/WhatsAppModal'; // Import WhatsAppModal\nimport { getStatusBadge, getPaymentStatusBadge } from '@/utils/uiHelpers';\nimport { OrderStatus, PaymentStatus, Transaction, Customer, TransactionItem } from '@/types';\nimport { useAuditLogs } from '../../contexts/AuditLogContext';\n\nconst DetailItem: React.FC<{ label: string; value: React.ReactNode; className?: string }> = ({\n  label,\n  value,\n  className,\n}) => (\n  <div className={`flex justify-between items-start py-2 ${className}`}>\n    <span className=\"text-base text-slate-500 dark:text-slate-400\">{label}</span>\n    <span className=\"text-base font-semibold text-slate-800 dark:text-slate-200 text-right\">\n      {value}\n    </span>\n  </div>\n);\n\nconst TransactionDetailPage: React.FC = () => {\n  const { id } = useParams<{ id: string }>();\n\n  // Mengambil fungsi updateTransaction dari context\n  const { updateTransaction } = useTransactions({ enabled: false });\n  const { addAuditLog } = useAuditLogs();\n\n  // Query untuk mengambil SATU transaksi berdasarkan ID\n  const {\n    data: transaction,\n    isLoading: isTransactionLoading,\n    error: transactionError,\n  } = useQuery<Transaction, Error>({\n    queryKey: ['transaction', id],\n    queryFn: async () => {\n      if (!id) throw new Error('Transaction ID is missing');\n      const { data, error } = await supabase.from('transactions').select('*').eq('id', id).single();\n      if (error) throw error;\n      // Map Supabase result to app Transaction type\n      return {\n        ...data,\n        customerId: data.customerId ?? '',\n        createdByUserId: data.createdByUserId ?? '',\n        storeId: data.storeId ?? '',\n        notes: data.notes ?? undefined,\n        idempotencyKey: data.idempotencyKey ?? undefined,\n        items: Array.isArray(data.items)\n          ? (data.items as unknown as TransactionItem[]).map((item) => ({\n              ...item,\n              itemDetails: item.itemDetails ?? [],\n            }))\n          : [],\n        createdAt: data.createdAt ? new Date(data.createdAt) : new Date(),\n        estimatedCompletionDate: data.estimatedCompletionDate ?? '',\n        invoiceCode: data.invoice_code ?? undefined,\n        paymentStatus: data.paymentStatus as import('../../types').PaymentStatus,\n        orderStatus: data.orderStatus as import('../../types').OrderStatus,\n        paymentMethod: data.paymentMethod\n          ? (data.paymentMethod as import('../../types').PaymentMethod)\n          : undefined,\n      };\n    },\n    enabled: !!id,\n  });\n\n  const customersQuery = useQuery({\n    queryKey: ['customers', { page: 1, pageSize: 1000 }],\n    queryFn: () => fetchCustomers({ page: 1, pageSize: 1000 }),\n  });\n\n  const customers = useMemo(() => {\n    return Array.isArray(customersQuery.data)\n      ? customersQuery.data\n      : (customersQuery.data?.data ?? []);\n  }, [customersQuery.data]);\n\n  const customer = transaction ? customers.find((c) => c.id === transaction.customerId) : null;\n\n  // FIXED: Add loading state guard to prevent premature error display\n  if (isTransactionLoading || customersQuery.isLoading) {\n    return (\n      <div className=\"text-center py-12 text-slate-500 dark:text-slate-400\">\n        Memuat detail transaksi...\n      </div>\n    );\n  }\n\n  // FIXED: More comprehensive null checks with better error handling\n  if (transactionError) {\n    console.error('Transaction detail error:', transactionError);\n    return (\n      <EmptyState\n        icon={<AlertCircle className=\"w-12 h-12\" />}\n        title=\"Terjadi Kesalahan\"\n        description=\"Terjadi kesalahan saat memuat transaksi\"\n      />\n    );\n  }\n\n  if (!transaction) {\n    console.warn('Transaction not found for ID:', id);\n    return (\n      <EmptyState\n        icon={<AlertCircle className=\"w-12 h-12\" />}\n        title=\"Tidak Ditemukan\"\n        description=\"Transaksi tidak ditemukan\"\n      />\n    );\n  }\n\n  if (!customer) {\n    console.warn('Customer not found for transaction:', {\n      transactionId: transaction.id,\n      customerId: transaction.customerId,\n    });\n    return (\n      <EmptyState\n        icon={<AlertCircle className=\"w-12 h-12\" />}\n        title=\"Tidak Ditemukan\"\n        description=\"Data pelanggan tidak ditemukan\"\n      />\n    );\n  }\n\n  const remainingBalance = transaction.total - transaction.amountPaid;\n\n  return (\n    <div className=\"space-y-6\">\n      <Link\n        to=\"/transactions\"\n        className=\"flex items-center text-base text-blue-600 hover:underline dark:text-blue-400\"\n      >\n        <ChevronLeftIcon className=\"w-4 h-4 mr-1\" />\n        Kembali ke Daftar Transaksi\n      </Link>\n\n      <div className=\"bg-slate-50 dark:bg-slate-800 p-6 rounded-lg shadow-md\">\n        <div className=\"flex flex-col md:flex-row justify-between items-start mb-6 gap-4\">\n          <div>\n            <h1 className=\"text-3xl font-bold text-slate-900 dark:text-white\">Detail Transaksi</h1>\n            <p className=\"text-lg text-slate-500 dark:text-slate-400\">\n              {transaction.invoiceCode || `#${transaction.id.substring(0, 8)}`}\n            </p>\n          </div>\n          <div className=\"flex gap-2\">\n            {/* Tombol Kirim WA Manual */}\n            {/*\n            <button\n              onClick={() => setIsHeaderWAOpen(true)}\n              className=\"flex items-center justify-center text-white bg-green-600 hover:bg-green-700 font-medium rounded-lg text-lg px-4 py-3\"\n              title=\"Kirim Struk WhatsApp\"\n            >\n              <SendIcon className=\"h-5 w-5\" />\n            </button>\n            */}\n            <Link\n              to={`/transactions/${transaction.id}/receipt`}\n              className=\"flex items-center justify-center text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-lg px-6 py-3\"\n            >\n              <PrinterIcon className=\"h-5 w-5 mr-2\" />\n              Cetak Struk\n            </Link>\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6\">\n          <div>\n            <h2 className=\"text-2xl font-semibold text-slate-900 dark:text-white border-b dark:border-slate-700 pb-2 mb-3 flex items-center\">\n              <UsersIcon className=\"w-6 h-6 mr-3 text-slate-500\" />\n              Info Pelanggan\n            </h2>\n            <DetailItem label=\"Nama\" value={customer.name} />\n            <DetailItem label=\"Telepon\" value={customer.phone} />\n            <DetailItem label=\"Alamat\" value={customer.address || '-'} />\n          </div>\n          <div>\n            <h2 className=\"text-2xl font-semibold text-slate-900 dark:text-white border-b dark:border-slate-700 pb-2 mb-3 flex items-center\">\n              <ShoppingCartIcon className=\"w-6 h-6 mr-3 text-slate-500\" />\n              Info Transaksi\n            </h2>\n            <DetailItem\n              label=\"Tanggal Masuk\"\n              value={new Date(transaction.createdAt).toLocaleString('id-ID')}\n            />\n            <DetailItem\n              label=\"Estimasi Selesai\"\n              value={new Date(transaction.estimatedCompletionDate).toLocaleString('id-ID')}\n            />\n            <DetailItem\n              label=\"Status Pesanan\"\n              value={\n                <span\n                  className={`px-2 py-1 text-sm font-medium rounded-full ${getStatusBadge(\n                    transaction.orderStatus,\n                  )}`}\n                >\n                  {transaction.orderStatus}\n                </span>\n              }\n            />\n            <DetailItem\n              label=\"Status Bayar\"\n              value={\n                <span\n                  className={`px-2 py-1 text-sm font-medium rounded-full ${getPaymentStatusBadge(\n                    transaction.paymentStatus,\n                  )}`}\n                >\n                  {transaction.paymentStatus}\n                </span>\n              }\n            />\n            <DetailItem label=\"Metode Bayar\" value={transaction.paymentMethod || '-'} />\n          </div>\n        </div>\n        {transaction.notes && (\n          <div className=\"mt-6\">\n            <h3 className=\"text-xl font-semibold text-slate-900 dark:text-white mb-2\">Catatan</h3>\n            <p className=\"text-base p-3 bg-slate-50 dark:bg-slate-700/50 rounded-lg whitespace-pre-wrap\">\n              {transaction.notes}\n            </p>\n          </div>\n        )}\n\n        {/* Action buttons passing updateTransaction and customer */}\n        <ActionButtons\n          transaction={transaction}\n          customer={customer}\n          updateTransaction={updateTransaction}\n        />\n      </div>\n\n      <div className=\"bg-slate-50 dark:bg-slate-800 p-6 rounded-lg shadow-md\">\n        <h2 className=\"text-2xl font-semibold text-slate-900 dark:text-white mb-4\">Rincian Item</h2>\n        {/* Tampilan Tabel Desktop */}\n        <div className=\"overflow-x-auto hidden md:block\">\n          <table className=\"w-full text-base text-left text-slate-500 dark:text-slate-400\">\n            <thead className=\"text-sm text-slate-700 uppercase bg-slate-50 dark:bg-slate-700 dark:text-slate-400\">\n              <tr>\n                <th className=\"px-4 py-3\">Layanan</th>\n                <th className=\"px-4 py-3 text-center\">Jumlah</th>\n                <th className=\"px-4 py-3 text-right\">Harga Satuan</th>\n                <th className=\"px-4 py-3 text-right\">Subtotal</th>\n              </tr>\n            </thead>\n            <tbody>\n              {transaction.items.map((item, index) => (\n                <tr key={index} className=\"border-b dark:border-slate-700\">\n                  <td className=\"px-4 py-3 font-medium text-slate-900 dark:text-white\">\n                    {item.serviceName}\n                    {item.itemDetails?.slice(0, item.quantity).some((d) => d.note) && (\n                      <div className=\"pl-4 mt-1 space-y-0.5\">\n                        {item.itemDetails?.slice(0, item.quantity).map(\n                          (detail, detailIndex) =>\n                            detail.note && (\n                              <p\n                                key={detailIndex}\n                                className=\"text-sm font-normal text-slate-500 dark:text-slate-400\"\n                              >\n                                - Item #{detailIndex + 1}: {detail.note}\n                              </p>\n                            ),\n                        )}\n                      </div>\n                    )}\n                    {item.taggedItems && (\n                      <div className=\"pl-4 mt-1\">\n                        <p className=\"text-sm font-normal text-slate-500 dark:text-slate-400 whitespace-pre-wrap\">\n                          Rincian: {item.taggedItems}\n                        </p>\n                      </div>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-3 text-center\">\n                    {item.quantity} {item.unit}\n                  </td>\n                  <td className=\"px-4 py-3 text-right\">Rp {item.price.toLocaleString('id-ID')}</td>\n                  <td className=\"px-4 py-3 text-right font-semibold text-slate-700 dark:text-slate-200\">\n                    Rp {item.subtotal.toLocaleString('id-ID')}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Tampilan Kartu Mobile */}\n        <div className=\"md:hidden space-y-3\">\n          {transaction.items.map((item, index) => (\n            <div key={index} className=\"bg-slate-50 dark:bg-slate-700/50 p-4 rounded-lg shadow-sm\">\n              <div className=\"flex justify-between items-start\">\n                <span className=\"font-semibold text-slate-800 dark:text-slate-100\">\n                  {item.serviceName}\n                </span>\n                <span className=\"font-semibold text-right text-slate-700 dark:text-slate-200\">\n                  Rp {item.subtotal.toLocaleString('id-ID')}\n                </span>\n              </div>\n              <p className=\"text-sm text-slate-500 dark:text-slate-400 mt-1\">\n                {item.quantity} {item.unit} @ Rp {item.price.toLocaleString('id-ID')}\n              </p>\n              {item.itemDetails?.slice(0, item.quantity).some((d) => d.note) && (\n                <div className=\"pl-2 mt-2 space-y-0.5 border-l-2 border-slate-300 dark:border-slate-600\">\n                  {item.itemDetails?.slice(0, item.quantity).map(\n                    (detail, detailIndex) =>\n                      detail.note && (\n                        <p\n                          key={detailIndex}\n                          className=\"text-sm font-normal text-slate-500 dark:text-slate-400\"\n                        >\n                          - Item #{detailIndex + 1}: {detail.note}\n                        </p>\n                      ),\n                  )}\n                </div>\n              )}\n              {item.taggedItems && (\n                <div className=\"pl-2 mt-2 border-l-2 border-slate-300 dark:border-slate-600\">\n                  <p className=\"text-sm font-normal text-slate-500 dark:text-slate-400 whitespace-pre-wrap\">\n                    Rincian: {item.taggedItems}\n                  </p>\n                </div>\n              )}\n            </div>\n          ))}\n        </div>\n\n        <div className=\"w-full md:w-1/2 lg:w-1/3 ml-auto mt-6 space-y-2\">\n          <DetailItem\n            label=\"Subtotal\"\n            value={`Rp ${transaction.subtotal.toLocaleString('id-ID')}`}\n          />\n          {transaction.discount > 0 && (\n            <DetailItem\n              label=\"Diskon\"\n              value={`- Rp ${transaction.discount.toLocaleString('id-ID')}`}\n              className=\"!text-red-600 dark:!text-red-400\"\n            />\n          )}\n          {transaction.tax > 0 && (\n            <DetailItem label=\"Pajak\" value={`+ Rp ${transaction.tax.toLocaleString('id-ID')}`} />\n          )}\n          <DetailItem\n            label=\"Grand Total\"\n            value={`Rp ${transaction.total.toLocaleString('id-ID')}`}\n            className=\"text-xl font-bold border-t dark:border-slate-700 pt-3 !text-slate-900 dark:!text-white\"\n          />\n          <DetailItem\n            label=\"Sudah Dibayar\"\n            value={`Rp ${transaction.amountPaid.toLocaleString('id-ID')}`}\n          />\n          <DetailItem\n            label=\"Sisa Tagihan\"\n            value={`Rp ${remainingBalance > 0 ? remainingBalance.toLocaleString('id-ID') : 0}`}\n            className=\"text-lg font-bold !text-slate-900 dark:!text-white\"\n          />\n        </div>\n      </div>\n\n      {/* WhatsApp Modal untuk tombol manual di header */}\n      {/*\n      {isHeaderWAOpen && (\n        <WhatsAppModal\n          isOpen={isHeaderWAOpen}\n          onClose={() => setIsHeaderWAOpen(false)}\n          transaction={transaction}\n          customer={customer}\n        />\n      )}\n      */}\n    </div>\n  );\n};\n\nexport default TransactionDetailPage;\n\ninterface ActionButtonsProps {\n  transaction: Transaction;\n  customer: Customer; // Customer prop added\n  updateTransaction: (id: string, data: Partial<Transaction>) => Promise<Transaction | null>;\n}\n\nconst ActionButtons: React.FC<ActionButtonsProps> = ({\n  transaction,\n  customer,\n  updateTransaction,\n}) => {\n  const { currentUser } = useAppContext();\n  const { addToast, updateToast } = useToasts();\n  const { addAuditLog } = useAuditLogs();\n  const queryClient = useQueryClient();\n  const [loading, setLoading] = useState(false);\n  const [isPaymentOpen, setIsPaymentOpen] = useState(false);\n\n  // State untuk WhatsApp Modal otomatis setelah aksi\n  const [isWhatsAppOpen, setIsWhatsAppOpen] = useState(false);\n\n  const isKasir = currentUser?.role === 'Kasir';\n  const isAdmin = currentUser?.role === 'Admin' || currentUser?.role === 'Super Admin';\n\n  if (!isKasir && !isAdmin) return null;\n\n  function handleOpenPaymentModal() {\n    setIsPaymentOpen(true);\n  }\n\n  async function onSavePayment(updatedTransaction: Transaction) {\n    setLoading(true);\n    const toastId = addToast('Menyimpan pembayaran...', 'info');\n    const shouldShowWhatsAppModal =\n      updatedTransaction.paymentStatus === PaymentStatus.Paid &&\n      (updatedTransaction.orderStatus === OrderStatus.Completed ||\n        updatedTransaction.orderStatus === OrderStatus.Ready);\n    try {\n      await updateTransaction(transaction.id, {\n        amountPaid: updatedTransaction.amountPaid,\n        change: updatedTransaction.change,\n        paymentMethod: updatedTransaction.paymentMethod ?? undefined,\n        paymentStatus: updatedTransaction.paymentStatus,\n      });\n      addAuditLog(\n        `Menerima pembayaran untuk transaksi ${transaction.id}. Status bayar: ${updatedTransaction.paymentStatus}.`,\n        transaction.storeId,\n      );\n      await queryClient.invalidateQueries({ queryKey: ['transaction', transaction.id] });\n      updateToast(toastId, 'Pembayaran berhasil disimpan', 'success');\n      if (shouldShowWhatsAppModal) {\n        setIsWhatsAppOpen(true);\n      }\n    } catch (err: unknown) {\n      const message = err instanceof Error ? err.message : 'Gagal memperbarui status pembayaran';\n      updateToast(toastId, message, 'error');\n    } finally {\n      setLoading(false);\n      setIsPaymentOpen(false);\n    }\n  }\n\n  async function handleMarkReady() {\n    setLoading(true);\n    const toastId = addToast('Memperbarui status pesanan...', 'info');\n    try {\n      await updateTransaction(transaction.id, { orderStatus: OrderStatus.Ready });\n      addAuditLog(\n        `Mengubah status transaksi ${transaction.id} menjadi \"${OrderStatus.Ready}\".`,\n        transaction.storeId,\n      );\n      updateToast(toastId, 'Status pesanan diperbarui: Siap Ambil', 'success');\n      // Otomatis tawarkan kirim WA saat Ready\n      setIsWhatsAppOpen(true);\n    } catch (err: unknown) {\n      const message = err instanceof Error ? err.message : 'Gagal memperbarui status pesanan';\n      updateToast(toastId, message, 'error');\n    } finally {\n      setLoading(false);\n    }\n  }\n\n  async function handleMarkCompleted() {\n    if (transaction.paymentStatus !== PaymentStatus.Paid) {\n      addToast(\n        'Transaksi belum lunas. Harap lunasi tagihan sebelum menyelesaikan pesanan.',\n        'error',\n      );\n      return;\n    }\n\n    setLoading(true);\n    const toastId = addToast('Memperbarui status pesanan...', 'info');\n    try {\n      await updateTransaction(transaction.id, { orderStatus: OrderStatus.Completed });\n      addAuditLog(\n        `Mengubah status transaksi ${transaction.id} menjadi \"${OrderStatus.Completed}\".`,\n        transaction.storeId,\n      );\n      updateToast(toastId, 'Status pesanan diperbarui: Selesai', 'success');\n    } catch (err: unknown) {\n      const message = err instanceof Error ? err.message : 'Gagal memperbarui status pesanan';\n      updateToast(toastId, message, 'error');\n    } finally {\n      setLoading(false);\n    }\n  }\n\n  return (\n    <div className=\"mt-6 flex gap-3 relative flex-wrap\">\n      {loading && (\n        <div className=\"absolute inset-0 z-50 bg-white/60 dark:bg-black/50 rounded-md flex items-center justify-center\">\n          <div className=\"flex items-center gap-3\">\n            <svg\n              className=\"animate-spin h-6 w-6 text-blue-700\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              fill=\"none\"\n              viewBox=\"0 0 24 24\"\n              aria-hidden\n            >\n              <circle\n                className=\"opacity-25\"\n                cx=\"12\"\n                cy=\"12\"\n                r=\"10\"\n                stroke=\"currentColor\"\n                strokeWidth=\"4\"\n              ></circle>\n              <path\n                className=\"opacity-75\"\n                fill=\"currentColor\"\n                d=\"M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z\"\n              ></path>\n            </svg>\n            <span className=\"text-base font-medium text-slate-900 dark:text-white\">\n              Memproses...\n            </span>\n          </div>\n        </div>\n      )}\n\n      {/* Tombol Bayar HANYA muncul jika BELUM Lunas */}\n      {transaction.paymentStatus !== PaymentStatus.Paid && (\n        <button\n          disabled={loading}\n          onClick={handleOpenPaymentModal}\n          className=\"bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg px-6 py-3 text-lg disabled:bg-green-400 disabled:cursor-not-allowed\"\n          title=\"Input Pembayaran\"\n        >\n          Bayar\n        </button>\n      )}\n\n      <button\n        disabled={\n          loading ||\n          transaction.orderStatus === OrderStatus.Ready ||\n          transaction.orderStatus === OrderStatus.Completed\n        }\n        onClick={handleMarkReady}\n        className=\"bg-yellow-500 hover:bg-yellow-600 text-white font-medium rounded-lg px-6 py-3 text-lg disabled:bg-yellow-300 disabled:cursor-not-allowed\"\n      >\n        Tandai Siap Ambil\n      </button>\n\n      <button\n        disabled={\n          loading ||\n          transaction.orderStatus === OrderStatus.Completed ||\n          transaction.paymentStatus !== PaymentStatus.Paid\n        }\n        onClick={handleMarkCompleted}\n        className=\"bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg px-6 py-3 text-lg disabled:bg-blue-400 disabled:cursor-not-allowed\"\n        title={\n          transaction.paymentStatus !== PaymentStatus.Paid\n            ? 'Pelunasan diperlukan sebelum menyelesaikan pesanan'\n            : 'Selesaikan Pesanan'\n        }\n      >\n        Tandai Selesai\n      </button>\n\n      <PaymentModal\n        isOpen={isPaymentOpen}\n        onClose={() => setIsPaymentOpen(false)}\n        transaction={transaction}\n        onSave={onSavePayment}\n        disabled={loading}\n      />\n\n      {/* Modal WA Otomatis setelah aksi */}\n      {isWhatsAppOpen && (\n        <WhatsAppModal\n          isOpen={isWhatsAppOpen}\n          onClose={() => setIsWhatsAppOpen(false)}\n          transaction={transaction}\n          customer={customer}\n        />\n      )}\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\transactions\\TransactionPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'updatingStatusId' is assigned a value but never used.","line":62,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":62,"endColumn":26}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo, useEffect } from 'react';\nimport { Link, useSearchParams } from 'react-router-dom';\nimport { useQuery } from '@tanstack/react-query';\n\nimport { useSortableData } from '../../hooks/useSortableData';\nimport { useDebounce } from '../../hooks/useDebounce';\n\nimport { useTransactions } from '../../contexts/TransactionContext';\nimport { fetchCustomers } from '../../contexts/CustomerContext';\nimport { useAuditLogs } from '../../contexts/AuditLogContext';\nimport useToasts from '../../contexts/useToasts';\n\nimport {\n  PlusCircleIcon,\n  SearchIcon,\n  PrinterIcon,\n  SendIcon,\n  EyeIcon,\n  DollarSignIcon,\n  ShoppingCartIcon,\n  ArrowUpIcon,\n  ArrowDownIcon,\n  ChevronDownIcon,\n} from '../../components/icons';\nimport EmptyState from '../../components/EmptyState';\nimport PaymentModal from '../../components/PaymentModal';\nimport WhatsAppModal from '../../components/WhatsAppModal';\nimport ConfirmationModal from '../../components/ConfirmationModal';\nimport Pagination from '../../components/Pagination';\n\nimport { Transaction, OrderStatus, PaymentStatus, Customer } from '@/types';\nimport { getStatusBadge, getPaymentStatusBadge } from '@/utils/uiHelpers';\n\n// Tipe kustom untuk transaksi dengan nama pelanggan\ntype TransactionWithCustomer = Transaction & { customerName: string; customerPhone: string };\n\nconst TransactionPage: React.FC = () => {\n  const [searchParams, setSearchParams] = useSearchParams();\n  const [searchTerm, setSearchTerm] = useState('');\n  const debouncedSearchTerm = useDebounce(searchTerm, 300);\n\n  const [selectedDate, setSelectedDate] = useState('');\n  const [statusFilter, setStatusFilter] = useState<OrderStatus | 'all'>(() => {\n    const status = searchParams.get('status');\n    return status && Object.values(OrderStatus).includes(status as OrderStatus)\n      ? (status as OrderStatus)\n      : 'all';\n  });\n  const [paymentFilter, setPaymentFilter] = useState<PaymentStatus | 'all'>('all');\n  const [customerFilter, setCustomerFilter] = useState<string | 'all'>('all');\n\n  // Modal & selection state\n  const [isPaymentModalOpen, setIsPaymentModalOpen] = useState(false);\n  const [selectedTransaction, setSelectedTransaction] = useState<Transaction | null>(null);\n  const [isSavingPayment, setIsSavingPayment] = useState(false);\n  const [isWhatsAppModalOpen, setIsWhatsAppModalOpen] = useState(false);\n  const [transactionForWhatsApp, setTransactionForWhatsApp] = useState<Transaction | null>(null);\n  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());\n  const [isBulkConfirmOpen, setIsBulkConfirmOpen] = useState(false);\n  const [bulkActionStatus, setBulkActionStatus] = useState<OrderStatus | null>(null);\n  const [isBulkProcessing, setIsBulkProcessing] = useState(false);\n  const [updatingStatusId, setUpdatingStatusId] = useState<string | null>(null);\n\n  // Pagination and data\n  const customersQuery = useQuery({\n    queryKey: ['customers', { page: 1, pageSize: 1000 }],\n    queryFn: () => fetchCustomers({ page: 1, pageSize: 1000 }),\n  });\n\n  const customers = useMemo(() => {\n    return Array.isArray(customersQuery.data)\n      ? customersQuery.data\n      : (customersQuery.data?.data ?? []);\n  }, [customersQuery.data]);\n\n  const { addAuditLog } = useAuditLogs();\n  const { addToast, updateToast } = useToasts();\n\n  // State untuk server-side pagination\n  const [currentPage, setCurrentPage] = useState(1);\n  const pageSize = 15;\n\n  // Build date range dari selectedDate\n  const dateRange = useMemo(() => {\n    if (!selectedDate) return undefined;\n    return {\n      from: selectedDate,\n      to: selectedDate,\n    };\n  }, [selectedDate]);\n\n  // Ambil data transaksi dengan server-side filtering dan pagination\n  const { transactions, totalCount, updateTransaction } = useTransactions({\n    page: currentPage,\n    pageSize: pageSize,\n    dateRange: dateRange,\n    orderStatus: statusFilter !== 'all' ? statusFilter : undefined,\n    paymentStatus: paymentFilter !== 'all' ? paymentFilter : undefined,\n  });\n\n  const transactionsWithCustomer = useMemo(() => {\n    return transactions.map((t: Transaction): TransactionWithCustomer => {\n      const customer = customers.find((c: Customer) => c.id === t.customerId);\n      return {\n        ...t,\n        customerName: customer ? customer.name : 'N/A',\n        customerPhone: customer ? customer.phone : 'N/A',\n      };\n    });\n  }, [transactions, customers]);\n\n  // Filter hanya untuk customer filter dan search (server sudah handle date, status, payment)\n  const filteredTransactions = useMemo(() => {\n    return transactionsWithCustomer.filter((t: TransactionWithCustomer) => {\n      // Customer filter\n      if (customerFilter !== 'all' && t.customerId !== customerFilter) return false;\n\n      // Search term (client-side untuk invoice, customer name, phone)\n      if (!debouncedSearchTerm) return true;\n      const term = debouncedSearchTerm.toLowerCase();\n      return (\n        t.id.toLowerCase().includes(term) ||\n        (t.invoiceCode && t.invoiceCode.toLowerCase().includes(term)) ||\n        t.customerName.toLowerCase().includes(term) ||\n        t.customerPhone.includes(term)\n      );\n    });\n  }, [transactionsWithCustomer, debouncedSearchTerm, customerFilter]);\n\n  // Client-side sorting untuk hasil yang sudah di-filter\n  const {\n    items: sortedTransactions,\n    requestSort,\n    sortConfig,\n  } = useSortableData<TransactionWithCustomer>(filteredTransactions, {\n    key: 'createdAt',\n    direction: 'descending',\n  });\n\n  // Total pages dari server\n  const totalPages = Math.ceil(totalCount / pageSize);\n  const paginatedTransactions = sortedTransactions;\n\n  const getSortIcon = (key: keyof TransactionWithCustomer) => {\n    if (!sortConfig || sortConfig.key !== key) return null;\n    if (sortConfig.direction === 'ascending')\n      return <ArrowUpIcon className=\"w-4 h-4 inline ml-1\" />;\n    return <ArrowDownIcon className=\"w-4 h-4 inline ml-1\" />;\n  };\n\n  const handleOrderStatusChange = async (id: string, newStatus: OrderStatus) => {\n    const targetTransaction = transactions.find((t: Transaction) => t.id === id);\n    if (!targetTransaction) return;\n\n    // --- TAMBAHAN GUARD CLAUSE ---\n    if (\n      newStatus === OrderStatus.Completed &&\n      targetTransaction.paymentStatus !== PaymentStatus.Paid\n    ) {\n      addToast('Pesanan tidak dapat diselesaikan karena belum lunas.', 'error');\n      // Reset visual dropdown kembali ke nilai lama (opsional, tergantung implementasi UI)\n      return;\n    }\n    // --- AKHIR TAMBAHAN ---\n\n    const updatedTransaction = { ...targetTransaction, orderStatus: newStatus };\n    const shouldShowWhatsAppModal =\n      newStatus === OrderStatus.Ready && targetTransaction.orderStatus !== OrderStatus.Ready;\n\n    setUpdatingStatusId(id);\n    const toastId = addToast('Memperbarui status...', 'info');\n    try {\n      await updateTransaction(id, { orderStatus: newStatus });\n      addAuditLog(\n        `Mengubah status transaksi ${id} menjadi \"${newStatus}\".`,\n        targetTransaction.storeId,\n      );\n      updateToast(toastId, `Status transaksi ${id} diubah menjadi ${newStatus}.`, 'success');\n      if (shouldShowWhatsAppModal) {\n        setTransactionForWhatsApp(updatedTransaction);\n        setIsWhatsAppModalOpen(true);\n      }\n    } catch (error: unknown) {\n      const errMsg = error instanceof Error ? error.message : String(error);\n      updateToast(toastId, `Gagal memperbarui status: ${errMsg}`, 'error');\n    } finally {\n      setUpdatingStatusId(null);\n    }\n  };\n\n  const handleOpenPaymentModal = (transaction: Transaction) => {\n    setSelectedTransaction(transaction);\n    setIsPaymentModalOpen(true);\n  };\n\n  const handleSavePayment = async (updatedTransaction: Transaction) => {\n    const shouldShowModal =\n      updatedTransaction.paymentStatus === PaymentStatus.Paid &&\n      updatedTransaction.orderStatus === OrderStatus.Completed;\n    setIsSavingPayment(true);\n    const toastId = addToast('Menyimpan pembayaran...', 'info');\n    try {\n      // Send only DB columns (partial) to avoid sending client-only fields like customerName\n      const payload: Partial<Transaction> = {\n        amountPaid: updatedTransaction.amountPaid,\n        paymentStatus: updatedTransaction.paymentStatus,\n        paymentMethod: updatedTransaction.paymentMethod,\n        change: updatedTransaction.change,\n      };\n\n      await updateTransaction(updatedTransaction.id, payload);\n      addAuditLog(\n        `Menerima pembayaran untuk transaksi ${updatedTransaction.id}. Status bayar: ${updatedTransaction.paymentStatus}.`,\n        updatedTransaction.storeId,\n      );\n      updateToast(toastId, 'Pembayaran berhasil disimpan.', 'success');\n      setIsPaymentModalOpen(false);\n      setSelectedTransaction(null);\n      if (shouldShowModal) {\n        setTransactionForWhatsApp(updatedTransaction);\n        setIsWhatsAppModalOpen(true);\n      }\n    } catch (error: unknown) {\n      const errMsg = error instanceof Error ? error.message : String(error);\n      updateToast(toastId, `Gagal memperbarui pembayaran: ${errMsg}`, 'error');\n    } finally {\n      setIsSavingPayment(false);\n    }\n  };\n\n  const handleOpenWhatsAppModal = (transaction: Transaction) => {\n    setTransactionForWhatsApp(transaction);\n    setIsWhatsAppModalOpen(true);\n  };\n\n  const handleStatusFilterChange = (status: OrderStatus | 'all') => {\n    setStatusFilter(status);\n    if (status === 'all') {\n      searchParams.delete('status');\n    } else {\n      searchParams.set('status', status);\n    }\n    setSearchParams(searchParams);\n  };\n\n  const resetFilters = () => {\n    setSearchTerm('');\n    setSelectedDate('');\n    setStatusFilter('all');\n    setPaymentFilter('all');\n    setCustomerFilter('all');\n    setCurrentPage(1);\n    // Reset searchParams in URL\n    const params = new URLSearchParams();\n    setSearchParams(params);\n  };\n\n  // Handler untuk pagination\n  const handlePageChange = (page: number) => {\n    setCurrentPage(page);\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n  };\n\n  // Reset ke halaman 1 saat filter berubah\n  useEffect(() => {\n    setCurrentPage(1);\n  }, [statusFilter, paymentFilter, selectedDate, customerFilter, debouncedSearchTerm]);\n\n  const customerForWhatsApp = useMemo(() => {\n    if (!transactionForWhatsApp) return null;\n    return customers.find((c: Customer) => c.id === transactionForWhatsApp.customerId);\n  }, [transactionForWhatsApp, customers]);\n\n  // Bulk Action Handlers\n  const handleSelectAll = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.checked) {\n      setSelectedIds(new Set(sortedTransactions.map((t: TransactionWithCustomer) => t.id)));\n    } else {\n      setSelectedIds(new Set());\n    }\n  };\n\n  const handleSelectOne = (id: string) => {\n    const newSelectedIds = new Set(selectedIds);\n    if (newSelectedIds.has(id)) {\n      newSelectedIds.delete(id);\n    } else {\n      newSelectedIds.add(id);\n    }\n    setSelectedIds(newSelectedIds);\n  };\n\n  const handleBulkStatusChange = (status: OrderStatus) => {\n    setBulkActionStatus(status);\n    setIsBulkConfirmOpen(true);\n  };\n\n  const confirmBulkAction = async () => {\n    if (!bulkActionStatus) return;\n\n    const transactionsToUpdate = transactions.filter((t: Transaction) => selectedIds.has(t.id));\n\n    // FIXED: Extended guard clause - prevent marking unpaid transactions as Ready or Completed\n    const unpaidTransactions = transactionsToUpdate.filter(\n      (t: Transaction) =>\n        (bulkActionStatus === OrderStatus.Ready || bulkActionStatus === OrderStatus.Completed) &&\n        t.paymentStatus !== PaymentStatus.Paid,\n    );\n\n    if (unpaidTransactions.length > 0) {\n      const statusText = bulkActionStatus === OrderStatus.Ready ? 'siap' : 'diselesaikan';\n      addToast(\n        `${unpaidTransactions.length} transaksi belum lunas dan tidak dapat ditandai ${statusText}.`,\n        'error',\n      );\n      setIsBulkConfirmOpen(false);\n      setBulkActionStatus(null);\n      return;\n    }\n\n    setIsBulkProcessing(true);\n    const toastId = addToast('Memproses aksi massal...', 'info');\n    try {\n      const updatePromises = transactionsToUpdate.map((t: Transaction) =>\n        updateTransaction(t.id, { orderStatus: bulkActionStatus }),\n      );\n      await Promise.all(updatePromises);\n      addAuditLog(\n        `Mengubah status ${selectedIds.size} transaksi menjadi \"${bulkActionStatus}\" secara massal.`,\n      );\n      setSelectedIds(new Set());\n      updateToast(\n        toastId,\n        `Berhasil mengubah status ${selectedIds.size} transaksi menjadi ${bulkActionStatus}.`,\n        'success',\n      );\n    } catch (error: unknown) {\n      const errMsg = error instanceof Error ? error.message : String(error);\n      updateToast(toastId, `Gagal memperbarui status massal: ${errMsg}`, 'error');\n    } finally {\n      setIsBulkConfirmOpen(false);\n      setBulkActionStatus(null);\n      setIsBulkProcessing(false);\n    }\n  };\n\n  const statusOptions: (OrderStatus | 'all')[] = ['all', ...Object.values(OrderStatus)];\n\n  return (\n    <>\n      <div className=\"relative bg-slate-50 dark:bg-slate-800 p-6 rounded-lg shadow-md\">\n        {(isSavingPayment || isBulkProcessing) && (\n          <div className=\"absolute inset-0 bg-white/70 dark:bg-slate-900/60 flex items-center justify-center rounded-lg z-20\">\n            <div className=\"flex items-center gap-3\">\n              <svg\n                className=\"animate-spin h-6 w-6 text-blue-600\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n                fill=\"none\"\n                viewBox=\"0 0 24 24\"\n              >\n                <circle\n                  className=\"opacity-25\"\n                  cx=\"12\"\n                  cy=\"12\"\n                  r=\"10\"\n                  stroke=\"currentColor\"\n                  strokeWidth=\"4\"\n                ></circle>\n                <path\n                  className=\"opacity-75\"\n                  fill=\"currentColor\"\n                  d=\"M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z\"\n                ></path>\n              </svg>\n              <span className=\"text-slate-700 dark:text-slate-200 font-medium\">Memproses...</span>\n            </div>\n          </div>\n        )}\n        <div className=\"flex flex-col md:flex-row justify-between items-center mb-4 gap-4\">\n          <h1 className=\"text-2xl font-semibold text-slate-900 dark:text-white\">\n            Daftar Transaksi\n          </h1>\n          <Link\n            to=\"/transactions/new\"\n            className=\"flex-shrink-0 flex items-center justify-center text-white bg-blue-600 hover:bg-blue-700 font-medium rounded-lg text-lg px-6 py-3\"\n          >\n            <PlusCircleIcon className=\"h-5 w-5 mr-2\" />\n            Transaksi Baru\n          </Link>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-4 pb-4 border-b border-slate-200 dark:border-slate-700\">\n          <div className=\"relative\">\n            <label htmlFor=\"searchTerm\" className=\"sr-only\">\n              Cari Transaksi\n            </label>\n            <SearchIcon className=\"absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400\" />\n            <input\n              id=\"searchTerm\"\n              type=\"text\"\n              placeholder=\"Cari ID, Invoice, Nama, atau No. HP...\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              className=\"bg-slate-50 border border-slate-300 text-slate-900 text-sm sm:text-base rounded-lg block w-full pl-10 p-2 sm:p-3 dark:bg-slate-700 dark:border-slate-600 dark:te