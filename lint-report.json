\n\ndescribe('formatRupiah', () => {\n  it('should format number correctly', () => {\n    expect(formatRupiah(10000)).toBe('10.000');\n    expect(formatRupiah(1000000)).toBe('1.000.000');\n    expect(formatRupiah(0)).toBe('0');\n  });\n\n  it('should format string input', () => {\n    expect(formatRupiah('10000')).toBe('10.000');\n    expect(formatRupiah('1.000.000')).toBe('1.000.000');\n  });\n\n  it('should handle invalid input gracefully', () => {\n    expect(formatRupiah('invalid')).toBe('0');\n    expect(formatRupiah(NaN)).toBe('0');\n    expect(formatRupiah(null as any)).toBe('0');\n    expect(formatRupiah(undefined as any)).toBe('0');\n    expect(formatRupiah('')).toBe('0');\n  });\n\n  it('should handle negative numbers', () => {\n    expect(formatRupiah(-10000)).toBe('-10.000');\n  });\n\n  it('should handle decimal numbers', () => {\n    expect(formatRupiah(10000.5)).toBe('10.000,5');\n  });\n});\n\ndescribe('parseRupiah', () => {\n  it('should parse formatted string correctly', () => {\n    expect(parseRupiah('10.000')).toBe(10000);\n    expect(parseRupiah('1.000.000')).toBe(1000000);\n  });\n\n  it('should handle Rp prefix', () => {\n    expect(parseRupiah('Rp 10.000')).toBe(10000);\n    expect(parseRupiah('Rp10.000')).toBe(10000);\n  });\n\n  it('should handle plain numbers', () => {\n    expect(parseRupiah('10000')).toBe(10000);\n  });\n\n  it('should handle invalid input gracefully', () => {\n    expect(parseRupiah('')).toBe(0);\n    expect(parseRupiah('invalid')).toBe(0);\n    expect(parseRupiah(null as any)).toBe(0);\n    expect(parseRupiah(undefined as any)).toBe(0);\n  });\n\n  it('should extract numbers from mixed string', () => {\n    expect(parseRupiah('Total: Rp 15.000,-')).toBe(15000);\n  });\n});\n\ndescribe('calculateNextDueDate', () => {\n  it('should add days correctly', () => {\n    const date = new Date('2023-01-01');\n    const result = calculateNextDueDate(date, 5, 'days');\n    expect(result.getDate()).toBe(6);\n    expect(result.getMonth()).toBe(0); // January\n  });\n\n  it('should add weeks correctly', () => {\n    const date = new Date('2023-01-01');\n    const result = calculateNextDueDate(date, 2, 'weeks');\n    expect(result.getDate()).toBe(15);\n  });\n\n  it('should add months correctly', () => {\n    const date = new Date('2023-01-01');\n    const result = calculateNextDueDate(date, 1, 'months');\n    expect(result.getMonth()).toBe(1); // February\n    expect(result.getFullYear()).toBe(2023);\n  });\n\n  it('should add years correctly', () => {\n    const date = new Date('2023-01-01');\n    const result = calculateNextDueDate(date, 1, 'years');\n    expect(result.getFullYear()).toBe(2024);\n    expect(result.getMonth()).toBe(0); // Still January\n  });\n\n  it('should handle invalid date input with fallback', () => {\n    const invalidDate = new Date('invalid');\n    const result = calculateNextDueDate(invalidDate, 1, 'days');\n\n    // Should return a valid date (fallback to 30 days from now)\n    expect(result instanceof Date).toBe(true);\n    expect(!isNaN(result.getTime())).toBe(true);\n\n    // Should be in the future\n    expect(result.getTime()).toBeGreaterThan(Date.now());\n  });\n\n  it('should handle edge cases for month-end dates', () => {\n    const date = new Date('2023-01-31');\n    const result = calculateNextDueDate(date, 1, 'months');\n\n    // JavaScript Date handles this automatically\n    // Jan 31 + 1 month = Feb 28/29 or Mar 3 depending on implementation\n    expect(result.getMonth()).toBeGreaterThanOrEqual(1);\n  });\n\n  it('should handle leap year correctly', () => {\n    const date = new Date('2024-02-29'); // Leap year\n    const result = calculateNextDueDate(date, 1, 'years');\n    expect(result.getFullYear()).toBe(2025);\n    // Feb 29 + 1 year in non-leap year becomes Feb 28 or Mar 1\n    expect([1, 2]).toContain(result.getMonth());\n  });\n\n  it('should handle zero value', () => {\n    const date = new Date('2023-01-15');\n    const result = calculateNextDueDate(date, 0, 'days');\n    expect(result.getDate()).toBe(15);\n    expect(result.getMonth()).toBe(0);\n  });\n\n  it('should handle large values', () => {\n    const date = new Date('2023-01-01');\n    const result = calculateNextDueDate(date, 365, 'days');\n    expect(result.getFullYear()).toBe(2024);\n  });\n\n  it('should handle multiple month additions spanning years', () => {\n    const date = new Date('2023-11-01');\n    const result = calculateNextDueDate(date, 3, 'months');\n    expect(result.getFullYear()).toBe(2024);\n    expect(result.getMonth()).toBe(1); // February\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\utils\\dateHelpers.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\utils\\excelUtils.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\utils\\formatting.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\utils\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\utils\\performance.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":177,"column":11,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":177,"endColumn":14,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4562,4565],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4562,4565],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":183,"column":47,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":183,"endColumn":50,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4718,4721],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4718,4721],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Performance Monitoring Utilities\n * Untuk tracking performance dan debugging bottleneck\n */\n\ninterface PerformanceMetric {\n  name: string;\n  duration: number;\n  timestamp: number;\n}\n\nclass PerformanceMonitor {\n  private metrics: PerformanceMetric[] = [];\n  private readonly maxMetrics = 100; // Simpan max 100 metrics terakhir\n  private readonly slowThreshold = 100; // Warn jika operasi > 100ms\n\n  /**\n   * Measure waktu eksekusi function\n   * @param name - Nama operasi\n   * @param fn - Function yang akan diukur\n   * @returns Hasil dari function\n   */\n  measure<T>(name: string, fn: () => T): T {\n    const start = performance.now();\n    const result = fn();\n    const end = performance.now();\n    const duration = end - start;\n\n    this.recordMetric(name, duration);\n\n    if (duration > this.slowThreshold) {\n      console.warn(`ΓÜá∩╕Å Slow operation detected: \"${name}\" took ${duration.toFixed(2)}ms`);\n    }\n\n    return result;\n  }\n\n  /**\n   * Measure waktu eksekusi async function\n   * @param name - Nama operasi\n   * @param fn - Async function yang akan diukur\n   * @returns Promise hasil dari function\n   */\n  async measureAsync<T>(name: string, fn: () => Promise<T>): Promise<T> {\n    const start = performance.now();\n    const result = await fn();\n    const end = performance.now();\n    const duration = end - start;\n\n    this.recordMetric(name, duration);\n\n    if (duration > this.slowThreshold) {\n      console.warn(`ΓÜá∩╕Å Slow async operation detected: \"${name}\" took ${duration.toFixed(2)}ms`);\n    }\n\n    return result;\n  }\n\n  /**\n   * Start manual performance measurement\n   * @param name - Nama operasi\n   * @returns Function untuk stop measurement\n   */\n  start(name: string): () => void {\n    const start = performance.now();\n\n    return () => {\n      const end = performance.now();\n      const duration = end - start;\n      this.recordMetric(name, duration);\n\n      if (duration > this.slowThreshold) {\n        console.warn(`ΓÜá∩╕Å Slow operation detected: \"${name}\" took ${duration.toFixed(2)}ms`);\n      }\n    };\n  }\n\n  /**\n   * Record metric ke storage\n   * @param name - Nama operasi\n   * @param duration - Durasi dalam ms\n   */\n  private recordMetric(name: string, duration: number): void {\n    this.metrics.push({\n      name,\n      duration,\n      timestamp: Date.now(),\n    });\n\n    // Keep only last maxMetrics\n    if (this.metrics.length > this.maxMetrics) {\n      this.metrics.shift();\n    }\n  }\n\n  /**\n   * Get semua metrics\n   */\n  getMetrics(): PerformanceMetric[] {\n    return [...this.metrics];\n  }\n\n  /**\n   * Get metrics untuk operasi tertentu\n   * @param name - Nama operasi\n   */\n  getMetricsByName(name: string): PerformanceMetric[] {\n    return this.metrics.filter((m) => m.name === name);\n  }\n\n  /**\n   * Get rata-rata durasi untuk operasi tertentu\n   * @param name - Nama operasi\n   */\n  getAverageDuration(name: string): number {\n    const metrics = this.getMetricsByName(name);\n    if (metrics.length === 0) return 0;\n\n    const total = metrics.reduce((sum, m) => sum + m.duration, 0);\n    return total / metrics.length;\n  }\n\n  /**\n   * Get operasi paling lambat\n   * @param limit - Jumlah operasi yang ditampilkan (default: 10)\n   */\n  getSlowestOperations(limit: number = 10): PerformanceMetric[] {\n    return [...this.metrics].sort((a, b) => b.duration - a.duration).slice(0, limit);\n  }\n\n  /**\n   * Clear semua metrics\n   */\n  clear(): void {\n    this.metrics = [];\n  }\n\n  /**\n   * Generate performance report\n   */\n  generateReport(): string {\n    if (this.metrics.length === 0) {\n      return 'No performance metrics recorded.';\n    }\n\n    const slowest = this.getSlowestOperations(5);\n    const uniqueOperations = [...new Set(this.metrics.map((m) => m.name))];\n\n    let report = '≡ƒôè Performance Report\\n';\n    report += '='.repeat(50) + '\\n\\n';\n\n    report += `Total Operations: ${this.metrics.length}\\n`;\n    report += `Unique Operations: ${uniqueOperations.length}\\n\\n`;\n\n    report += '≡ƒÉî Top 5 Slowest Operations:\\n';\n    slowest.forEach((m, i) => {\n      report += `  ${i + 1}. ${m.name}: ${m.duration.toFixed(2)}ms\\n`;\n    });\n\n    report += '\\n≡ƒôê Average Duration by Operation:\\n';\n    uniqueOperations.forEach((name) => {\n      const avg = this.getAverageDuration(name);\n      const count = this.getMetricsByName(name).length;\n      report += `  ${name}: ${avg.toFixed(2)}ms (${count} calls)\\n`;\n    });\n\n    return report;\n  }\n}\n\nexport const performanceMonitor = new PerformanceMonitor();\n\n/**\n * Decorator untuk measure performance (untuk development)\n */\nexport function measurePerformance(\n  target: any,\n  propertyKey: string,\n  descriptor: PropertyDescriptor,\n) {\n  const originalMethod = descriptor.value;\n\n  descriptor.value = async function (...args: any[]) {\n    const stop = performanceMonitor.start(`${target.constructor.name}.${propertyKey}`);\n    try {\n      return await originalMethod.apply(this, args);\n    } finally {\n      stop();\n    }\n  };\n\n  return descriptor;\n}\n\n/**\n * Log performance report ke console (dev only)\n */\nexport function logPerformanceReport(): void {\n  if (import.meta.env.DEV) {\n    console.log(performanceMonitor.generateReport());\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\utils\\rateLimiter.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\utils\\retryUtils.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":131,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":131,"endColumn":31,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3288,3291],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3288,3291],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":139,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":139,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3458,3461],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3458,3461],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Retry Utility with Exponential Backoff\n * Untuk memastikan operasi critical berhasil dengan retry otomatis\n */\n\ninterface RetryOptions {\n  maxRetries?: number;\n  initialDelay?: number;\n  maxDelay?: number;\n  backoffMultiplier?: number;\n  onRetry?: (attempt: number, error: Error) => void;\n}\n\n/**\n * Retry async function dengan exponential backoff\n * @param fn - Function yang akan di-retry\n * @param options - Retry configuration\n * @returns Promise hasil dari function\n */\nexport async function retryWithBackoff<T>(\n  fn: () => Promise<T>,\n  options: RetryOptions = {},\n): Promise<T> {\n  const {\n    maxRetries = 3,\n    initialDelay = 1000,\n    maxDelay = 10000,\n    backoffMultiplier = 2,\n    onRetry,\n  } = options;\n\n  let lastError: Error;\n  let delay = initialDelay;\n\n  for (let attempt = 0; attempt <= maxRetries; attempt++) {\n    try {\n      return await fn();\n    } catch (error) {\n      lastError = error as Error;\n\n      // Jangan retry jika sudah attempt terakhir\n      if (attempt === maxRetries) {\n        break;\n      }\n\n      // Callback untuk logging/notification\n      if (onRetry) {\n        onRetry(attempt + 1, lastError);\n      }\n\n      // Wait dengan exponential backoff\n      await new Promise((resolve) => setTimeout(resolve, delay));\n\n      // Increase delay untuk next attempt\n      delay = Math.min(delay * backoffMultiplier, maxDelay);\n    }\n  }\n\n  throw new Error(\n    `Operation failed after ${maxRetries + 1} attempts. Last error: ${lastError!.message}`,\n  );\n}\n\n/**\n * Retry khusus untuk Supabase operations\n * Dengan detection untuk network errors\n */\nexport async function retrySupabaseOperation<T>(\n  fn: () => Promise<T>,\n  operationName: string = 'operation',\n): Promise<T> {\n  return retryWithBackoff(fn, {\n    maxRetries: 3,\n    initialDelay: 1000,\n    onRetry: (attempt, error) => {\n      console.warn(`[Retry ${attempt}/3] ${operationName} failed:`, error.message);\n    },\n  });\n}\n\n/**\n * Verify data setelah save dengan polling\n * Memastikan data benar-benar tersimpan di database\n */\nexport async function verifyDataSaved<T>(\n  fetchFn: () => Promise<T | null>,\n  validateFn: (data: T | null) => boolean,\n  options: {\n    maxAttempts?: number;\n    pollInterval?: number;\n    timeoutMs?: number;\n  } = {},\n): Promise<T> {\n  const { maxAttempts = 5, pollInterval = 500, timeoutMs = 5000 } = options;\n\n  const startTime = Date.now();\n\n  for (let attempt = 0; attempt < maxAttempts; attempt++) {\n    // Check timeout\n    if (Date.now() - startTime > timeoutMs) {\n      throw new Error(\n        'Verification timeout: Data tidak dapat diverifikasi dalam waktu yang ditentukan',\n      );\n    }\n\n    try {\n      const data = await fetchFn();\n\n      if (validateFn(data)) {\n        return data as T;\n      }\n    } catch (error) {\n      console.warn(`Verification attempt ${attempt + 1} failed:`, error);\n    }\n\n    // Wait sebelum retry\n    if (attempt < maxAttempts - 1) {\n      await new Promise((resolve) => setTimeout(resolve, pollInterval));\n    }\n  }\n\n  throw new Error('Verification failed: Data tidak dapat diverifikasi setelah disimpan');\n}\n\n/**\n * Transaction wrapper dengan rollback support\n * Untuk operasi multi-step yang harus atomic\n */\nexport async function executeWithRollback<T>(\n  operations: Array<{\n    execute: () => Promise<any>;\n    rollback?: () => Promise<void>;\n    description: string;\n  }>,\n): Promise<T> {\n  const completed: Array<() => Promise<void>> = [];\n\n  try {\n    let lastResult: any;\n\n    for (const op of operations) {\n      console.log(`Executing: ${op.description}`);\n      lastResult = await op.execute();\n\n      if (op.rollback) {\n        completed.push(op.rollback);\n      }\n    }\n\n    return lastResult;\n  } catch (error) {\n    console.error('Transaction failed, rolling back...', error);\n\n    // Rollback dalam urutan terbalik\n    for (const rollback of completed.reverse()) {\n      try {\n        await rollback();\n      } catch (rollbackError) {\n        console.error('Rollback failed:', rollbackError);\n      }\n    }\n\n    throw error;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\utils\\supabaseClient.ts","messages":[{"ruleId":null,"message":"Unused eslint-disable directive (no problems were reported from 'no-var').","line":18,"column":3,"severity":1,"nodeType":null,"fix":{"range":[632,666],"text":" "}}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":1,"source":"import { createClient } from '@supabase/supabase-js';\nimport { Database } from '../types/supabase';\n\nconst supabaseUrl = import.meta.env.VITE_SUPABASE_URL;\nconst supabaseAnonKey = import.meta.env.VITE_SUPABASE_ANON_KEY;\n\nif (!supabaseUrl) {\n  throw new Error('VITE_SUPABASE_URL is not defined. Please check your .env file.');\n}\nif (!supabaseAnonKey) {\n  throw new Error('VITE_SUPABASE_ANON_KEY is not defined. Please check your .env file.');\n}\n\n// Pola Singleton agar tidak terjadi multiple GoTrueClient instance (HMR/dev)\nconst createSupabaseClient = () => createClient<Database>(supabaseUrl, supabaseAnonKey);\n\ndeclare global {\n  // eslint-disable-next-line no-var\n  var supabase: ReturnType<typeof createSupabaseClient> | undefined;\n}\n\nexport const supabase = globalThis.supabase ?? createSupabaseClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalThis.supabase = supabase;\n}\n\n/**\n * Helper RPC call to fetch a minimal, safe projection of a transaction for public/customer-facing views.\n * This calls the database function `get_laundry_status(transaction_id_input uuid)` which must be created\n * in the Supabase SQL editor and defined as SECURITY DEFINER (see database/get_laundry_status.sql).\n */\nexport async function getLaundryStatus(identifier: string) {\n  const { data, error } = await supabase.rpc('get_laundry_status', {\n    input_identifier: identifier,\n  });\n  if (error) throw error;\n  // If data is empty or not found, throw error to match test expectation\n  if (!data || (Array.isArray(data) && data.length === 0)) {\n    throw new Error('Kode invoice tidak ditemukan atau data tidak valid.');\n  }\n  // Return first element if array, else null\n  return Array.isArray(data) ? data[0] : data;\n}\n\n/**\n * Helper RPC call to fetch public service list for a store.\n * Calls `get_public_services(store_id_input uuid)` defined in the DB.\n */\nexport async function getPublicServices(storeId: string) {\n  const { data, error } = await supabase.rpc('get_public_services', { store_id_input: storeId });\n  if (error) throw error;\n  return data;\n}\n\n/**\n * Helper to call update_transaction_progress RPC which atomically updates allowed progress fields\n * and writes an audit log server-side.\n */\nexport async function updateTransactionProgress(\n  transactionId: string,\n  params: {\n    amountPaid?: number | null;\n    change?: number | null;\n    paymentMethod?: string | null;\n    paymentStatus?: string | null;\n    orderStatus?: string | null;\n  },\n) {\n  const { amountPaid, change, paymentMethod, paymentStatus, orderStatus } = params;\n  const { data, error } = await supabase.rpc('update_transaction_progress', {\n    transaction_id_input: transactionId,\n    p_amount_paid: amountPaid ?? undefined,\n    p_change: change ?? undefined,\n    p_payment_method: paymentMethod ?? undefined,\n    p_payment_status: paymentStatus ?? undefined,\n    p_order_status: orderStatus ?? undefined,\n  });\n  if (error) throw error;\n  return data;\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gma