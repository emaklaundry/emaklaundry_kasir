arningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\components\\SuccessModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\components\\ToastContainer.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\components\\UserFormModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\components\\VersionInfo.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\components\\WhatsAppModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\components\\icons.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\AppContext.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isRefreshing' is assigned a value but never used.","line":149,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":149,"endColumn":21},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'e' is defined but never used.","line":151,"column":33,"nodeType":null,"messageId":"unusedVar","endLine":151,"endColumn":34}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, ReactNode, useEffect, useRef, useCallback } from 'react';\nimport AppContext from './AppContextContext';\nimport { User, Store } from '../types/index';\nimport { supabase } from '../utils/supabaseClient';\nimport { useStores } from './StoreContext';\nimport useToasts from './useToasts'; // 1. IMPOR useToasts\n\n// Konfigurasi waktu timeout (5 menit)\nconst INACTIVITY_TIMEOUT = 5 * 60 * 1000; // 5 menit = 300000ms\n\nexport interface AppContextType {\n  currentUser: User | null;\n  signOut: () => Promise<void>;\n  stores: Store[];\n  selectedStoreId: string; // 'all' or a specific store ID\n  setSelectedStoreId: (storeId: string) => void;\n}\n\nexport const AppProvider: React.FC<{ children: ReactNode }> = ({ children }) => {\n  const { stores } = useStores();\n  const [selectedStoreId, setSelectedStoreId] = useState<string>('all');\n  const [currentUser, setCurrentUser] = useState<User | null>(null);\n  const { addToast } = useToasts(); // 2. INISIALISASI HOOK\n\n  const prevLoggedInRef = useRef(false);\n\n  // Online/Offline detection dipindahkan ke Header component (persistent indicator)\n\n  useEffect(() => {\n    const getProfile = async () => {\n      const {\n        data: { session },\n      } = await supabase.auth.getSession();\n      if (session?.user) {\n        const { data, error } = await supabase\n          .from('profiles')\n          .select('*')\n          .eq('id', session.user.id)\n          .maybeSingle();\n        if (error) {\n          console.error('Error fetching profile:', error);\n        }\n        if (data) {\n          if (data.isActive === false) {\n            addToast('Akun Anda tidak aktif. Silakan hubungi administrator.', 'error');\n            await supabase.auth.signOut();\n            setCurrentUser(null);\n            prevLoggedInRef.current = false;\n          } else {\n            // Deteksi transisi dari logout ke login\n            if (!prevLoggedInRef.current) {\n              const newLog = {\n                timestamp: new Date().toISOString(),\n                user: data.name ?? null,\n                action: 'Melakukan login.',\n                storeId: data.store_id ?? null,\n              };\n              supabase.from('audit_logs').insert([newLog]).then();\n            }\n            setCurrentUser({\n              id: data.id,\n              name: data.name,\n              role: data.role as import('../types').UserRole,\n              storeId: data.store_id ?? undefined,\n              createdAt: data.created_at ? new Date(data.created_at) : undefined,\n              isActive: data.isActive ?? false,\n              canGiveDiscount: data.canGiveDiscount ?? false,\n            });\n            prevLoggedInRef.current = true;\n          }\n        } else {\n          // Profil tidak ditemukan (bisa karena trigger belum jalan)\n          console.warn('User login berhasil, tapi profil tidak ditemukan di database.');\n          // Opsi: Logout otomatis atau biarkan null\n          // await supabase.auth.signOut();\n          setCurrentUser(null);\n          prevLoggedInRef.current = false;\n        }\n      } else {\n        setCurrentUser(null);\n        prevLoggedInRef.current = false;\n      }\n    };\n    getProfile();\n    const { data: listener } = supabase.auth.onAuthStateChange(() => {\n      getProfile();\n    });\n    return () => {\n      listener.subscription.unsubscribe();\n    };\n  }, [addToast]);\n\n  // Bungkus signOut dengan useCallback agar stabil di dalam useEffect dependency\n  const signOut = useCallback(async () => {\n    if (currentUser) {\n      const newLog = {\n        timestamp: new Date().toISOString(),\n        user: currentUser.name ?? null,\n        action: 'Melakukan logout.',\n        storeId: currentUser.storeId ?? null,\n      };\n      supabase.from('audit_logs').insert([newLog]).then();\n    }\n    await supabase.auth.signOut();\n    setCurrentUser(null);\n  }, [currentUser]);\n\n  // --- LOGIC AUTO LOGOUT ---\n  useEffect(() => {\n    // Hanya jalankan jika user sedang login\n    if (!currentUser) return;\n\n    let timeoutId: NodeJS.Timeout;\n\n    const handleInactivity = () => {\n      signOut();\n      addToast('Sesi Anda telah berakhir karena tidak ada aktivitas.', 'info');\n    };\n\n    const resetTimer = () => {\n      if (timeoutId) clearTimeout(timeoutId);\n      timeoutId = setTimeout(handleInactivity, INACTIVITY_TIMEOUT);\n    };\n\n    // Event yang dianggap sebagai aktivitas\n    const events = ['mousedown', 'mousemove', 'keydown', 'scroll', 'touchstart', 'click'];\n    events.forEach((event) => {\n      document.addEventListener(event, resetTimer);\n    });\n\n    // Mulai timer pertama kali\n    resetTimer();\n\n    // Cleanup saat unmount atau currentUser berubah (logout)\n    return () => {\n      if (timeoutId) clearTimeout(timeoutId);\n      events.forEach((event) => {\n        document.removeEventListener(event, resetTimer);\n      });\n    };\n  }, [currentUser, signOut, addToast]);\n  // -------------------------\n\n  // --- AUTO LOGOUT SAAT TUTUP BROWSER/TAB ---\n  useEffect(() => {\n    if (!currentUser) return;\n\n    // Track jika sedang refresh/reload\n    let isRefreshing = false;\n\n    const handleBeforeUnload = (e: BeforeUnloadEvent) => {\n      // Set flag bahwa user sedang refresh/reload\n      isRefreshing = true;\n      sessionStorage.setItem('isRefreshing', 'true');\n    };\n\n    const handleUnload = async () => {\n      // Tunggu sebentar untuk cek apakah ini refresh atau close\n      await new Promise((resolve) => setTimeout(resolve, 50));\n\n      const wasRefreshing = sessionStorage.getItem('isRefreshing');\n\n      // Jika bukan refresh, logout\n      if (!wasRefreshing) {\n        await signOut();\n      }\n\n      // Clear flag refresh\n      sessionStorage.removeItem('isRefreshing');\n    };\n\n    const handleVisibilityChange = () => {\n      // Clear refresh flag saat page visible lagi (setelah refresh selesai)\n      if (!document.hidden) {\n        sessionStorage.removeItem('isRefreshing');\n      }\n    };\n\n    // Clear refresh flag saat component mount (setelah refresh selesai)\n    sessionStorage.removeItem('isRefreshing');\n\n    window.addEventListener('beforeunload', handleBeforeUnload);\n    window.addEventListener('unload', handleUnload);\n    document.addEventListener('visibilitychange', handleVisibilityChange);\n\n    return () => {\n      window.removeEventListener('beforeunload', handleBeforeUnload);\n      window.removeEventListener('unload', handleUnload);\n      document.removeEventListener('visibilitychange', handleVisibilityChange);\n    };\n  }, [currentUser, signOut]);\n  // -------------------------\n\n  return (\n    <AppContext.Provider\n      value={{ currentUser, signOut, stores, selectedStoreId, setSelectedStoreId }}\n    >\n      {children}\n    </AppContext.Provider>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\AppContextContext.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\AppProviders.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\AssetContext.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":31,"column":74,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":31,"endColumn":77,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1328,1331],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1328,1331],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';\nimport { Asset } from '../types';\nimport { supabase } from '../utils/supabaseClient';\n\nconst fetchAssets = async (): Promise<Asset[]> => {\n  const { data, error } = await supabase.from('assets').select('*');\n  if (error) throw error;\n  // Convert null to undefined for optional fields\n  return (data || []).map((a) => ({\n    ...a,\n    purchaseDate: a.purchaseDate ?? undefined,\n    serialNumber: a.serialNumber ?? undefined,\n    purchaseCost: a.purchaseCost ?? undefined,\n    storeId: a.storeId ?? undefined,    maintenanceHistory: Array.isArray(a.maintenanceHistory) ? a.maintenanceHistory : [],  })) as unknown as Asset[];\n};\n\nexport function useAssets() {\n  const queryClient = useQueryClient();\n  const { data: assets = [], ...query } = useQuery({ queryKey: ['assets'], queryFn: fetchAssets });\n\n  const addAsset = useMutation({\n    mutationFn: async (asset: Omit<Asset, 'id'>) => {\n      // Convert undefined to null for Supabase\n      const dbAsset = {\n        ...asset,\n        purchaseDate: asset.purchaseDate ?? null,\n        serialNumber: asset.serialNumber ?? null,\n        purchaseCost: asset.purchaseCost ?? null,\n        storeId: asset.storeId ?? null,\n      };\n      const { error } = await supabase.from('assets').insert([dbAsset as any]);\n      if (error) throw error;\n      // We invalidate and refetch the assets list, caller doesn't rely on returned row\n      return null;\n    },\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['assets'] }),\n  });\n\n  const updateAsset = useMutation({\n    mutationFn: async (variables: { id: string; data: Partial<Asset> }) => {\n      const { id, data } = variables;\n      // Convert undefined to null for Supabase\n      const dbData: Record<string, unknown> = {};\n      for (const key in data) {\n        dbData[key] = (data as Record<string, unknown>)[key] ?? null;\n      }\n      const { data: updated, error } = await supabase\n        .from('assets')\n        .update(dbData)\n        .eq('id', id)\n        .select();\n      if (error) throw error;\n      return updated?.[0] || null;\n    },\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['assets'] }),\n  });\n\n  const deleteAsset = useMutation({\n    mutationFn: async (id: string) => {\n      const { error } = await supabase.from('assets').delete().eq('id', id);\n      if (error) throw error;\n      return id;\n    },\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['assets'] }),\n  });\n\n  return {\n    assets,\n    addAsset: addAsset.mutateAsync,\n    updateAsset: (id: string, data: Partial<Asset>) => updateAsset.mutateAsync({ id, data }),\n    deleteAsset: deleteAsset.mutateAsync,\n    ...query,\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\AuditLogContext.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\CustomerContext.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":56,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":56,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1868,1871],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1868,1871],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useMutation, useQueryClient } from '@tanstack/react-query';\nimport { Customer } from '../types';\nimport { supabase } from '../utils/supabaseClient';\n\nexport interface CustomerFilter {\n  page?: number;\n  pageSize?: number;\n  searchTerm?: string;\n  storeId?: string;\n}\n\nexport async function fetchCustomers(\n  filter: CustomerFilter = {},\n): Promise<{ data: Customer[]; count: number }> {\n  const { page = 1, pageSize = 50, searchTerm, storeId } = filter;\n  let query = supabase.from('customers').select('*', { count: 'exact' });\n  if (storeId && storeId !== 'all') {\n    query = query.eq('storeId', storeId);\n  }\n  if (searchTerm) {\n    query = query.ilike('name', `%${searchTerm}%`);\n  }\n  const from = (page - 1) * pageSize;\n  const to = from + pageSize - 1;\n  query = query.range(from, to);\n  const { data, error, count } = await query;\n  if (error) throw error;\n  // Convert null to undefined for optional fields\n  const customers = (data || []).map((c) => ({\n    ...c,\n    address: c.address ?? undefined,\n    notes: c.notes ?? undefined,\n    phone: c.phone ?? undefined,\n    defaultDiscount: c.defaultDiscount ?? undefined,\n    storeId: c.storeId ?? undefined,\n  })) as unknown as Customer[];\n  return { data: customers, count: count || 0 };\n}\n\nexport function useCustomerMutations() {\n  const queryClient = useQueryClient();\n\n  const addCustomer = useMutation({\n    mutationFn: async (customer: Omit<Customer, 'id'>) => {\n      // Convert undefined to null for Supabase\n      const dbCustomer = {\n        ...customer,\n        address: customer.address ?? null,\n        notes: customer.notes ?? null,\n        phone: customer.phone ?? null,\n        defaultDiscount: customer.defaultDiscount ?? null,\n        storeId: customer.storeId ?? null,\n      };\n      const { data, error } = await supabase\n        .from('customers')\n        .insert([dbCustomer as any])\n        .select();\n      if (error) throw error;\n      return data?.[0] || null;\n    },\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['customers'] }),\n  });\n\n  const updateCustomer = useMutation({\n    mutationFn: async (variables: { id: string; data: Partial<Customer> }) => {\n      const { id, data } = variables;\n      // Convert undefined to null for Supabase\n      const dbData: Record<string, unknown> = {};\n      for (const key in data) {\n        dbData[key] = (data as Record<string, unknown>)[key] ?? null;\n      }\n      const { data: updated, error } = await supabase\n        .from('customers')\n        .update(dbData)\n        .eq('id', id)\n        .select();\n      if (error) throw error;\n      return updated?.[0] || null;\n    },\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['customers'] }),\n  });\n\n  const deleteCustomer = useMutation({\n    mutationFn: async (id: string) => {\n      const { error } = await supabase.from('customers').delete().eq('id', id);\n      if (error) throw error;\n      return id;\n    },\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['customers'] }),\n  });\n\n  return {\n    addCustomer: addCustomer.mutateAsync,\n    updateCustomer: (id: string, data: Partial<Customer>) =>\n      updateCustomer.mutateAsync({ id, data }),\n    deleteCustomer: deleteCustomer.mutateAsync,\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\ExpenseContext.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\InventoryContext.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\ScheduledMaintenanceContext.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\ServiceContext.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\SettingsContext.tsx","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'_ignoredId' is assigned a value but never used.","line":24,"column":19,"nodeType":null,"messageId":"unusedVar","endLine":24,"endColumn":29,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\StoreContext.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\ToastContext.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\ToastContextContext.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\TransactionContext.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":126,"column":39,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":126,"endColumn":42,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4509,4512],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4509,4512],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":176,"column":16,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":176,"endColumn":19,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6118,6121],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6118,6121],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient, keepPreviousData } from '@tanstack/react-query';\nimport { supabase, updateTransactionProgress } from '../utils/supabaseClient';\nimport { retrySupabaseOperation, verifyDataSaved } from '../utils/retryUtils';\nimport { Transaction } from '@/types';\n// import { sanitizeTransactionUpdate } from '../../utils/sanitizeTransaction';\n\n// Pagination-aware fetchTransactions\n\nexport interface TransactionFilter {\n  page?: number;\n  pageSize?: number;\n  dateRange?: { from: string; to: string };\n  storeId?: string;\n  paymentStatus?: string;\n  orderStatus?: string;\n  enabled?: boolean; // Untuk optimasi query\n}\n\nconst fetchTransactions = async (\n  filter: TransactionFilter = {},\n): Promise<{ data: Transaction[]; count: number }> => {\n  try {\n    const { page = 1, pageSize = 50, dateRange, storeId, paymentStatus, orderStatus } = filter;\n\n    // Validasi input\n    if (page < 1) {\n      throw new Error('Page number must be greater than 0');\n    }\n    if (pageSize < 1 || pageSize > 100) {\n      throw new Error('Page size must be between 1 and 100');\n    }\n\n    let query = supabase.from('transactions').select('*', { count: 'exact' });\n\n    if (dateRange) {\n      // Validasi date range\n      if (!dateRange.from || !dateRange.to) {\n        throw new Error('Invalid date range: both from and to are required');\n      }\n\n      // Atur Start Date (Awal Hari Lokal)\n      const fromDate = new Date(dateRange.from);\n      if (isNaN(fromDate.getTime())) {\n        throw new Error('Invalid from date');\n      }\n      fromDate.setHours(0, 0, 0, 0);\n\n      // Atur End Date (Akhir Hari Lokal)\n      const toDate = new Date(dateRange.to);\n      if (isNaN(toDate.getTime())) {\n        throw new Error('Invalid to date');\n      }\n      toDate.setHours(23, 59, 59, 999);\n\n      // Kirim sebagai ISO String (browser akan konversi ke UTC)\n      query = query.gte('createdAt', fromDate.toISOString()).lte('createdAt', toDate.toISOString());\n    }\n\n    if (storeId && storeId !== 'all') {\n      query = query.eq('storeId', storeId);\n    }\n\n    if (paymentStatus) {\n      query = query.eq('paymentStatus', paymentStatus);\n    }\n\n    if (orderStatus) {\n      query = query.eq('orderStatus', orderStatus);\n    }\n\n    const from = (page - 1) * pageSize;\n    const to = from + pageSize - 1;\n    query = query.range(from, to).order('createdAt', { ascending: false });\n\n    const { data, error, count } = await query;\n    if (error) throw error;\n\n    // Convert null to undefined for optional fields\n    const transactions = (data || []).map((t) => ({\n      ...t,\n      customerId: t.customerId ?? undefined,\n      createdByUserId: t.createdByUserId ?? undefined,\n      paymentMethod: t.paymentMethod ?? undefined,\n    })) as unknown as Transaction[];\n\n    return { data: transactions, count: count || 0 };\n  } catch (error) {\n    console.error('Error fetching transactions:', error);\n    throw error;\n  }\n};\n\nexport function useTransactions(filter: TransactionFilter = {}) {\n  const queryClient = useQueryClient();\n  // Ambil enabled dari filter, default true\n  const { enabled = true, ...queryFilter } = filter;\n  const { data: result, ...query } = useQuery({\n    queryKey: ['transactions', queryFilter],\n    queryFn: () => fetchTransactions(queryFilter),\n    placeholderData: keepPreviousData,\n    enabled: enabled,\n    // HANYA untuk TransactionPage: refetch on window focus\n    // Untuk halaman lain (form input), ini akan disabled\n    refetchOnWindowFocus: queryFilter.page !== undefined, // Hanya jika ada pagination\n    staleTime: queryFilter.page !== undefined ? 30 * 1000 : 5 * 60 * 1000, // 30s untuk list, 5min untuk detail\n  });\n  const transactions = result?.data || [];\n  const totalCount = result?.count || 0;\n\n  const addTransaction = useMutation({\n    mutationFn: async (transaction: Omit<Transaction, 'id'>) => {\n      try {\n        // Convert undefined to null and Date to string for Supabase\n        const dbTransaction = {\n          ...transaction,\n          customerId: transaction.customerId ?? null,\n          createdByUserId: transaction.createdByUserId ?? null,\n          estimatedCompletionDate: transaction.estimatedCompletionDate ?? null,\n          paymentMethod: transaction.paymentMethod ?? null,\n        };\n\n        // Retry operation untuk memastikan sukses\n        const savedTransaction = await retrySupabaseOperation(async () => {\n          const { data, error } = await supabase\n            .from('transactions')\n            .insert([dbTransaction as any])\n            .select();\n          if (error) throw error;\n          if (!data || data.length === 0) {\n            throw new Error('No data returned after insert');\n          }\n          return data[0];\n        }, 'Insert Transaction');\n\n        // Verify data benar-benar tersimpan\n        const verified = await verifyDataSaved(\n          async () => {\n            const { data } = await supabase\n              .from('transactions')\n              .select('*')\n              .eq('id', savedTransaction.id)\n              .single();\n            return data;\n          },\n          (data) => data !== null && data.id === savedTransaction.id,\n          { maxAttempts: 3, pollInterval: 300 },\n        );\n\n        return verified;\n      } catch (error) {\n        console.error('Error adding transaction:', error);\n        throw new Error(\n          `Gagal menyimpan transaksi: ${error instanceof Error ? error.message : 'Unknown error'}. Data tidak tersimpan, silakan coba lagi.`,\n        );\n      }\n    },\n    onSuccess: () => {\n      // Invalidate untuk force refresh dari server\n      queryClient.invalidateQueries({ queryKey: ['transactions'] });\n    },\n  });\n\n  const updateTransaction = useMutation({\n    mutationFn: async (variables: { id: string; data: Partial<Transaction> }) => {\n      const { id, data } = variables;\n      // Pisahkan data untuk RPC dan update biasa\n      const {\n        amountPaid = undefined,\n        change = undefined,\n        paymentMethod = undefined,\n        paymentStatus = undefined,\n        orderStatus = undefined,\n        ...otherFields\n      } = data;\n\n      let row: any = null;\n      // 1. Jalankan RPC untuk update progress jika ada field terkait\n      if (amountPaid !== undefined || paymentStatus !== undefined || orderStatus !== undefined) {\n        const updated = await updateTransactionProgress(id, {\n          amountPaid,\n          change,\n          paymentMethod,\n          paymentStatus,\n          orderStatus,\n        });\n        if (Array.isArray(updated) && updated[0]) row = updated[0];\n        else if (updated && typeof updated === 'object') row = updated;\n      }\n      // 2. Jalankan update standar untuk field lain (notes, estimatedCompletionDate, dll)\n      if (Object.keys(otherFields).length > 0) {\n        // Convert undefined to null and Date to string for Supabase\n        const dbOtherFields: Record<string, unknown> = {};\n        for (const key in otherFields) {\n          const value = (otherFields as Record<string, unknown>)[key];\n          if (value instanceof Date) {\n            dbOtherFields[key] = value.toISOString();\n          } else {\n            dbOtherFields[key] = value ?? null;\n          }\n        }\n        const { data: updatedRow, error } = await supabase\n          .from('transactions')\n          .update(dbOtherFields)\n          .eq('id', id)\n          .select();\n        if (error) throw error;\n        if (updatedRow && updatedRow[0]) row = updatedRow[0];\n      }\n      if (!row) return null;\n      // Explicitly map all required Transaction fields\n      return {\n        id: row.id ?? '',\n        invoiceCode: row.invoiceCode ?? undefined,\n        customerId: row.customerId ?? '',\n        items: Array.isArray(row.items)\n          ? (row.items as import('../types').TransactionItem[]).map((item) => ({\n              ...item,\n              itemDetails: item.itemDetails ?? [],\n            }))\n          : [],\n        subtotal: row.subtotal ?? 0,\n        discount: row.discount ?? 0,\n        tax: row.tax ?? 0,\n        total: row.total ?? 0,\n        paymentStatus: row.paymentStatus as import('../types').PaymentStatus,\n        orderStatus: row.orderStatus as import('../types').OrderStatus,\n        createdAt: row.createdAt ? new Date(row.createdAt) : new Date(),\n        estimatedCompletionDate: row.estimatedCompletionDate ?? '',\n        amountPaid: row.amountPaid ?? 0,\n        change: row.change ?? 0,\n        paymentMethod: row.paymentMethod\n          ? (row.paymentMethod as import('../types').PaymentMethod)\n          : undefined,\n        createdByUserId: row.createdByUserId ?? '',\n        storeId: row.storeId ?? '',\n        notes: row.notes ?? undefined,\n        idempotencyKey: row.idempotencyKey ?? undefined,\n      };\n    },\n    // Conservative approach: TIDAK ada optimistic update\n    // Tunggu hingga server confirm sebelum update UI\n    onSuccess: async (result, variables) => {\n      // Verify update berhasil\n      if (result) {\n        try {\n          await verifyDataSaved(\n            async () => {\n              const { data } = await supabase\n                .from('transactions')\n                .select('*')\n                .eq('id', variables.id)\n                .single();\n              return data;\n            },\n            (data) => {\n              if (!data) return false;\n              // Verify semua field yang diupdate\n              return Object.keys(variables.data).every((key) => {\n                const expectedValue = variables.data[key as keyof typeof variables.data];\n                const actualValue = (data as Record<string, unknown>)[key];\n                return expectedValue === undefined || actualValue === expectedValue;\n              });\n            },\n            { maxAttempts: 3, pollInterval: 300 },\n          );\n        } catch (verifyError) {\n          console.error('Verification failed after update:', verifyError);\n          throw new Error(\n            'Update berhasil disimpan tetapi verifikasi gagal. Silakan refresh halaman.',\n          );\n        }\n      }\n\n      // Force refresh data dari server\n      await queryClient.invalidateQueries({ queryKey: ['transactions'] });\n      if (variables && variables.id) {\n        await queryClient.invalidateQueries({ queryKey: ['transaction', variables.id] });\n      }\n    },\n    onError: (error) => {\n      console.error('Transaction update failed:', error);\n      // Force refresh untuk memastikan UI sync dengan database\n      queryClient.invalidateQueries({ queryKey: ['transactions'] });\n    },\n  });\n\n  return {\n    transactions,\n    totalCount,\n    addTransaction: addTransaction.mutateAsync,\n    updateTransaction: (id: string, data: Partial<Transaction>) =>\n      updateTransaction.mutateAsync({ id, data }),\n    ...query,\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\UserContext.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\useAppContext.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\contexts\\useToasts.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\global.d.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\hooks\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\hooks\\useCommandPalette.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\hooks\\useDebounce.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\hooks\\usePagination.ts","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'currentPage'. Either include it or remove the dependency array.","line":31,"column":6,"nodeType":"ArrayExpression","endLine":31,"endColumn":18,"suggestions":[{"desc":"Update the dependencies array to be: [currentPage, totalPages]","fix":{"range":[1177,1189],"text":"[currentPage, totalPages]"}}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\hooks\\useSortableData.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\hooks\\useStoreFilteredData.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\hooks\\useTheme.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\AuditLogPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":14,"column":48,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":14,"endColumn":51,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[727,730],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[727,730],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useMemo, useState } from 'react';\nimport { useAuditLogs } from '../contexts/AuditLogContext';\nimport useStoreFilteredData from '../hooks/useStoreFilteredData';\nimport useAppContext from '../contexts/useAppContext';\nimport { HistoryIcon, SearchIcon, ArrowUpIcon, ArrowDownIcon } from '../components/icons';\nimport useSortableData from '../hooks/useSortableData';\nimport usePagination from '../hooks/usePagination';\nimport Pagination from '../components/Pagination';\nimport { UserRole } from '@/types';\n\nconst AuditLogPage: React.FC = () => {\n  const { logs: allLogs, isLoading } = useAuditLogs();\n  const { currentUser, selectedStoreId, stores } = useAppContext();\n  const logs = useStoreFilteredData(allLogs as any) as unknown as typeof allLogs;\n\n  const [searchTerm, setSearchTerm] = useState('');\n  const [startDate, setStartDate] = useState('');\n  const [endDate, setEndDate] = useState('');\n\n  const filteredLogs = useMemo(() => {\n    return logs.filter((log) => {\n      // Search filter\n      const searchLower = searchTerm.toLowerCase().trim();\n      const matchesSearch =\n        !searchLower ||\n        log.user.toLowerCase().includes(searchLower) ||\n        log.action.toLowerCase().includes(searchLower);\n\n      // Date range filter\n      const logDate = new Date(log.timestamp);\n      logDate.setHours(0, 0, 0, 0); // Reset to start of day for comparison\n\n      let matchesDateRange = true;\n\n      if (startDate) {\n        const start = new Date(startDate);\n        start.setHours(0, 0, 0, 0);\n        matchesDateRange = matchesDateRange && logDate >= start;\n      }\n\n      if (endDate) {\n        const end = new Date(endDate);\n        end.setHours(23, 59, 59, 999);\n        matchesDateRange = matchesDateRange && logDate <= end;\n      }\n\n      return matchesSearch && matchesDateRange;\n    });\n  }, [logs, searchTerm, startDate, endDate]);\n\n  const logsWithStore = useMemo(() => {\n    return filteredLogs.map((log) => ({\n      ...log,\n      storeName: stores.find((s) => s.id === log.storeId)?.name || '-',\n    }));\n  }, [filteredLogs, stores]);\n\n  type LogWithStore = (typeof logsWithStore)[0];\n\n  const {\n    items: sortedLogs,\n    requestSort,\n    sortConfig,\n  } = useSortableData<LogWithStore>(logsWithStore, { key: 'timestamp', direction: 'descending' });\n  const {\n    currentData: paginatedLogs,\n    currentPage,\n    totalPages,\n    onPageChange,\n  } = usePagination(sortedLogs, 20);\n\n  const getSortIcon = (key: keyof LogWithStore) => {\n    if (!sortConfig || sortConfig.key !== key) return null;\n    if (sortConfig.direction === 'ascending')\n      return <ArrowUpIcon className=\"w-4 h-4 inline ml-1\" />;\n    return <ArrowDownIcon className=\"w-4 h-4 inline ml-1\" />;\n  };\n\n  const handleResetFilters = () => {\n    setSearchTerm('');\n    setStartDate('');\n    setEndDate('');\n  };\n\n  const filtersApplied = Boolean(searchTerm || startDate || endDate);\n\n  const getStoreName = (storeId?: string) => {\n    if (!storeId) return '-';\n    const store = stores.find((s) => s.id === storeId);\n    return store?.name || 'Unknown Store';\n  };\n\n  if (isLoading) {\n    return (\n      <div className=\"flex justify-center items-center h-96\">\n        <div className=\"animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-brand-blue-500\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"bg-white dark:bg-slate-800 p-6 rounded-lg shadow-md\">\n      <h1 className=\"text-2xl font-semibold mb-4 text-slate-900 dark:text-white\">Log Audit</h1>\n\n      <div className=\"flex flex-col md:flex-row items-center gap-4 mb-4 pb-4 border-b border-slate-200 dark:border-slate-700 flex-wrap\">\n        <div className=\"relative w-full md:w-64\">\n          <SearchIcon className=\"absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Cari pengguna atau aksi...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"bg-slate-50 border border-slate-300 text-slate-900 text-base rounded-lg block w-full pl-10 p-3 dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n          />\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <label\n            htmlFor=\"startDate\"\n            className=\"text-base text-slate-600 dark:text-slate-300 flex-shrink-0\"\n          >\n            Dari:\n          </label>\n          <input\n            id=\"startDate\"\n            type=\"date\"\n            value={startDate}\n            onChange={(e) => setStartDate(e.target.value)}\n            max={endDate || undefined}\n            className=\"bg-slate-50 border border-slate-300 text-slate-900 text-base rounded-lg block w-full p-2.5 dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n          />\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <label\n            htmlFor=\"endDate\"\n            className=\"text-base text-slate-600 dark:text-slate-300 flex-shrink-0\"\n          >\n            Hingga:\n          </label>\n          <input\n            id=\"endDate\"\n            type=\"date\"\n            value={endDate}\n            onChange={(e) => setEndDate(e.target.value)}\n            min={startDate || undefined}\n            className=\"bg-slate-50 border border-slate-300 text-slate-900 text-base rounded-lg block w-full p-2.5 dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n          />\n        </div>\n        {filtersApplied && (\n          <button\n            onClick={handleResetFilters}\n            className=\"px-4 py-2 text-sm bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-300 dark:hover:bg-slate-600\"\n          >\n            Reset Filter\n          </button>\n        )}\n      </div>\n\n      <div className=\"overflow-x-auto\">\n        <table className=\"w-full text-base text-left text-slate-500 dark:text-slate-400\">\n          <thead className=\"text-sm text-slate-700 uppercase bg-slate-50 dark:bg-slate-700 dark:text-slate-400\">\n            <tr>\n              <th className=\"px-4 py-3\">\n                <button\n                  onClick={() => requestSort('timestamp')}\n                  className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                >\n                  Waktu {getSortIcon('timestamp')}\n                </button>\n              </th>\n              <th className=\"px-4 py-3\">\n                <button\n                  onClick={() => requestSort('user')}\n                  className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                >\n                  Pengguna {getSortIcon('user')}\n                </button>\n              </th>\n              {currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' && (\n                <th className=\"px-4 py-3\">\n                  <button\n                    onClick={() => requestSort('storeName')}\n                    className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                  >\n                    Cabang {getSortIcon('storeName')}\n                  </button>\n                </th>\n              )}\n              <th className=\"px-4 py-3\">Aksi</th>\n            </tr>\n          </thead>\n          <tbody>\n            {paginatedLogs.length > 0 ? (\n              paginatedLogs.map((log) => (\n                <tr key={log.id} className=\"border-b dark:border-slate-700\">\n                  <td className=\"px-4 py-3\">\n                    {log.timestamp.toLocaleString('id-ID', {\n                      dateStyle: 'medium',\n                      timeStyle: 'medium',\n                    })}\n                  </td>\n                  <td className=\"px-4 py-3\">{log.user}</td>\n                  {currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' && (\n                    <td className=\"px-4 py-3\">{getStoreName(log.storeId)}</td>\n                  )}\n                  <td className=\"px-4 py-3\">{log.action}</td>\n                </tr>\n              ))\n            ) : (\n              <tr>\n                <td\n                  colSpan={\n                    currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' ? 4 : 3\n                  }\n                  className=\"text-center py-12\"\n                >\n                  <HistoryIcon className=\"mx-auto w-12 h-12 text-slate-400\" />\n                  <h3 className=\"mt-2 text-xl font-semibold text-slate-800 dark:text-slate-200\">\n                    Tidak Ada Log Ditemukan\n                  </h3>\n                  <p className=\"mt-1 text-base text-slate-500\">\n                    {filtersApplied\n                      ? 'Tidak ada log yang cocok dengan kriteria filter Anda.'\n                      : 'Belum ada aktivitas yang tercatat.'}\n                  </p>\n                </td>\n              </tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n      <Pagination currentPage={currentPage} totalPages={totalPages} onPageChange={onPageChange} />\n    </div>\n  );\n};\n\nexport default AuditLogPage;\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\Dashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\LoginPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\QuickActionsPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\ReportsPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\management\\AssetsPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isSavingAsset' is assigned a value but never used.","line":43,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":43,"endColumn":23}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo, useRef } from 'react';\nimport { useSearchParams } from 'react-router-dom';\nimport {\n  PlusCircleIcon,\n  EditIcon,\n  Trash2Icon,\n  HistoryIcon,\n  WrenchIcon,\n  CalendarIcon,\n  SearchIcon,\n  ArrowUpIcon,\n  ArrowDownIcon,\n  DownloadIcon,\n  UploadIcon,\n} from '../../components/icons';\nimport {\n  exportAssetsToExcel,\n  importAssetsFromExcel,\n  downloadAssetTemplate,\n} from '../../utils/excelUtils';\nimport EmptyState from '../../components/EmptyState';\nimport ConfirmationModal from '../../components/ConfirmationModal';\nimport { useAssets } from '../../contexts/AssetContext';\n// (hapus import useExpenses)\nimport useAppContext from '../../contexts/useAppContext';\nimport AssetFormModal from '../../components/AssetFormModal';\nimport MaintenanceFormModal from '../../components/MaintenanceFormModal';\nimport MaintenanceHistoryModal from '../../components/MaintenanceHistoryModal';\nimport ScheduledMaintenanceModal from '../../components/ScheduledMaintenanceModal';\nimport { useAuditLogs } from '../../contexts/AuditLogContext';\nimport useToasts from '../../contexts/useToasts';\nimport { useScheduledMaintenances } from '../../contexts/ScheduledMaintenanceContext';\nimport { useSortableData } from '../../hooks/useSortableData';\nimport { getStatusBadge } from '@/utils/uiHelpers';\nimport { Asset, MaintenanceLog, UserRole } from '@/types';\n\nconst AssetsPage: React.FC = () => {\n  const { assets, addAsset, updateAsset, deleteAsset } = useAssets();\n  // Tidak perlu lagi addExpense, pencatatan pengeluaran aset otomatis di laporan\n  const { currentUser, selectedStoreId, stores } = useAppContext();\n  const { addAuditLog } = useAuditLogs();\n  const { addToast, updateToast } = useToasts();\n  const [isSavingAsset, setIsSavingAsset] = useState(false);\n  const { scheduledMaintenances } = useScheduledMaintenances();\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  const [searchParams, setSearchParams] = useSearchParams();\n\n  const [isAssetFormModalOpen, setIsAssetFormModalOpen] = useState(false);\n  const [isMaintenanceFormModalOpen, setIsMaintenanceFormModalOpen] = useState(false);\n  const [isHistoryModalOpen, setIsHistoryModalOpen] = useState(false);\n  const [isScheduleModalOpen, setIsScheduleModalOpen] = useState(false);\n\n  const [currentAsset, setCurrentAsset] = useState<Asset | null>(null);\n  const [assetToDelete, setAssetToDelete] = useState<Asset | null>(null);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [maintenanceFilter, setMaintenanceFilter] = useState<'all' | 'due'>(() =>\n    searchParams.get('filter') === 'maintenance_due' ? 'due' : 'all',\n  );\n\n  const handleOpenAssetForm = (asset: Asset | null = null) => {\n    setCurrentAsset(asset);\n    setIsAssetFormModalOpen(true);\n  };\n\n  const handleOpenMaintenanceForm = (asset: Asset) => {\n    setCurrentAsset(asset);\n    setIsMaintenanceFormModalOpen(true);\n  };\n\n  const handleOpenHistory = (asset: Asset) => {\n    setCurrentAsset(asset);\n    setIsHistoryModalOpen(true);\n  };\n\n  const handleOpenSchedule = (asset: Asset) => {\n    setCurrentAsset(asset);\n    setIsScheduleModalOpen(true);\n  };\n\n  const handleSaveAsset = async (asset: Omit<Asset, 'id' | 'maintenanceHistory' | 'storeId'>) => {\n    if (!currentUser) {\n      addToast('User context belum siap.', 'error');\n      return;\n    }\n    const storeId =\n      currentAsset?.storeId ||\n      (currentUser.role === UserRole.SuperAdmin ? selectedStoreId : currentUser.storeId);\n    if (!storeId || storeId === 'all') {\n      addToast('Silakan pilih cabang spesifik untuk menambah atau mengedit aset.', 'warning');\n      return;\n    }\n    const toastId = addToast('Menyimpan aset...', 'info');\n    setIsSavingAsset(true);\n    try {\n      if (currentAsset && currentAsset.id) {\n        // Edit Mode: Hanya update data aset\n        await updateAsset(currentAsset.id, { ...asset, storeId });\n        addAuditLog(`Memperbarui data aset: \"${asset.name}\".`, storeId);\n        updateToast(toastId, 'Data aset berhasil diperbarui!', 'success');\n      } else {\n        // Create Mode: Tambah aset saja, tidak perlu catat ke pengeluaran\n        await addAsset({ ...asset, maintenanceHistory: [], storeId });\n        addAuditLog(`Menambahkan aset baru: \"${asset.name}\".`, storeId);\n        updateToast(toastId, 'Aset baru berhasil ditambahkan!', 'success');\n      }\n      setIsAssetFormModalOpen(false);\n      setCurrentAsset(null);\n    } catch (error: unknown) {\n      const errMsg = error instanceof Error ? error.message : String(error);\n      updateToast(toastId, `Gagal menyimpan: ${errMsg}`, 'error');\n    } finally {\n      setIsSavingAsset(false);\n    }\n  };\n\n  const handleAddMaintenance = async (log: Omit<MaintenanceLog, 'id'>) => {\n    if (currentAsset) {\n      const newLog = { ...log, id: Date.now().toString() };\n      const updatedHistory = [...currentAsset.maintenanceHistory, newLog];\n\n      try {\n        await updateAsset(currentAsset.id, { maintenanceHistory: updatedHistory });\n        addAuditLog(\n          `Menambahkan log pemeliharaan untuk aset \"${currentAsset.name}\": ${log.description}.`,\n          currentAsset.storeId,\n        );\n      } catch (error) {\n        console.error('Error updating asset maintenance:', error);\n        addToast('Gagal menyimpan log perawatan.', 'error');\n      }\n    }\n    setIsMaintenanceFormModalOpen(false);\n    setCurrentAsset(null);\n  };\n\n  const handleDelete = (asset: Asset) => {\n    setAssetToDelete(asset);\n  };\n\n  const confirmDelete = async () => {\n    if (assetToDelete) {\n      const toastId = addToast('Menghapus aset...', 'info');\n      setIsSavingAsset(true);\n      try {\n        await deleteAsset(assetToDelete.id);\n        addAuditLog(`Menghapus aset: \"${assetToDelete.name}\".`, assetToDelete.storeId);\n        updateToast(toastId, 'Aset berhasil dihapus!', 'success');\n      } catch (error: unknown) {\n        if (error && typeof error === 'object' && 'message' in error) {\n          updateToast(\n            toastId,\n            `Gagal menghapus: ${(error as { message: string }).message}`,\n            'error',\n          );\n        } else {\n          updateToast(toastId, 'Gagal menghapus: Unknown error', 'error');\n        }\n      } finally {\n        setAssetToDelete(null);\n        setIsSavingAsset(false);\n      }\n    }\n  };\n\n  const assetsWithStore = useMemo(\n    () =>\n      assets.map((asset) => ({\n        ...asset,\n        storeName: stores.find((s) => s.id === asset.storeId)?.name || 'N/A',\n      })),\n    [assets, stores],\n  );\n\n  type AssetWithStore = (typeof assetsWithStore)[0];\n\n  const dueMaintenanceAssetIds = useMemo(() => {\n    if (maintenanceFilter !== 'due') return new Set();\n    const now = new Date();\n    now.setHours(23, 59, 59, 999);\n    return new Set(\n      scheduledMaintenances.filter((sm) => new Date(sm.nextDueDate) <= now).map((sm) => sm.assetId),\n    );\n  }, [scheduledMaintenances, maintenanceFilter]);\n\n  const filteredAssets = useMemo(\n    () =>\n      assetsWithStore.filter((asset) => {\n        if (maintenanceFilter === 'due' && !dueMaintenanceAssetIds.has(asset.id)) {\n          return false;\n        }\n        return (\n          asset.name.toLowerCase().includes(searchTerm.toLowerCase()) ||\n          (asset.serialNumber &&\n            asset.serialNumber.toLowerCase().includes(searchTerm.toLowerCase()))\n        );\n      }),\n    [assetsWithStore, searchTerm, maintenanceFilter, dueMaintenanceAssetIds],\n  );\n\n  const {\n    items: sortedAssets,\n    requestSort,\n    sortConfig,\n  } = useSortableData<AssetWithStore>(filteredAssets);\n\n  const getSortIcon = (key: keyof AssetWithStore) => {\n    if (!sortConfig || sortConfig.key !== key) return null;\n    if (sortConfig.direction === 'ascending')\n      return <ArrowUpIcon className=\"w-4 h-4 inline ml-1\" />;\n    return <ArrowDownIcon className=\"w-4 h-4 inline ml-1\" />;\n  };\n\n  const canAddNewAsset =\n    !!currentUser && !(currentUser.role === UserRole.SuperAdmin && selectedStoreId === 'all');\n\n  const handleFilterChange = (filter: 'all' | 'due') => {\n    setMaintenanceFilter(filter);\n    if (filter === 'due') {\n      searchParams.set('filter', 'maintenance_due');\n    } else {\n      searchParams.delete('filter');\n    }\n    setSearchParams(searchParams);\n  };\n\n  // Excel Export\n  const handleExportToExcel = async () => {\n    try {\n      await exportAssetsToExcel(assets);\n      addToast('Data aset berhasil di-export ke Excel', 'success');\n    } catch (error) {\n      console.error('Export error:', error);\n      addToast('Gagal export data ke Excel', 'error');\n    }\n  };\n\n  // Excel Import\n  const handleImportFromExcel = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    setIsSavingAsset(true);\n    const toastId = addToast('Memproses import data...', 'info');\n\n    try {\n      const importedAssets = await importAssetsFromExcel(file);\n\n      let successCount = 0;\n      let errorCount = 0;\n      let skipCount = 0;\n\n      for (const asset of importedAssets) {\n        try {\n          if (asset.id) {\n            // Validate UUID format before UPDATE\n            const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n            if (!uuidRegex.test(asset.id)) {\n              console.warn('Invalid UUID skipped:', asset.id);\n              skipCount++;\n              continue;\n            }\n\n            // Update existing asset\n            await updateAsset(asset.id, {\n              name: asset.name!,\n              serialNumber: asset.serialNumber,\n              purchaseDate: asset.purchaseDate!,\n              purchaseCost: asset.purchaseCost!,\n              status: asset.status!,\n              storeId: selectedStoreId === 'all' ? undefined : selectedStoreId,\n            });\n            successCount++;\n          } else {\n            // Check for duplicate before adding new asset\n            const existingAsset = assets.find((a) => {\n              if (asset.serialNumber) {\n                return a.serialNumber === asset.serialNumber;\n              } else {\n                return a.name.toLowerCase() === asset.name!.toLowerCase();\n              }\n            });\n            if (existingAsset) {\n              console.warn('Duplicate asset skipped:', asset.name);\n              skipCount++;\n              continue;\n            }\n\n            // Ensure storeId is set for INSERT (RLS policy requirement)\n            const storeId = selectedStoreId === 'all' ? currentUser?.storeId : selectedStoreId;\n\n            if (!storeId) {\n              console.error('storeId is required for new assets');\n              errorCount++;\n              continue;\n            }\n\n            // Add new asset\n            await addAsset({\n              name: asset.name!,\n              serialNumber: asset.serialNumber,\n              purchaseDate: asset.purchaseDate!,\n              purchaseCost: asset.purchaseCost!,\n              status: asset.status!,\n              maintenanceHistory: [],\n              storeId: storeId,\n            });\n            successCount++;\n          }\n        } catch (error) {\n          console.error('Error importing asset:', asset, error);\n          errorCount++;\n        }\n      }\n\n      if (skipCount > 0) {\n        updateToast(\n          toastId,\n          `Import selesai: ${successCount} berhasil, ${errorCount} gagal, ${skipCount} dilewati (duplikat/invalid)`,\n          'warning',\n        );\n      } else if (errorCount > 0) {\n        updateToast(\n          toastId,\n          `Import selesai: ${successCount} berhasil, ${errorCount} gagal`,\n          'warning',\n        );\n      } else {\n        updateToast(toastId, `Berhasil import ${successCount} aset`, 'success');\n      }\n\n      addAuditLog(\n        `Import ${successCount} aset dari Excel`,\n        selectedStoreId === 'all' ? undefined : selectedStoreId,\n      );\n    } catch (error) {\n      console.error('Import error:', error);\n      updateToast(toastId, 'Gagal import data dari Excel', 'error');\n    } finally {\n      setIsSavingAsset(false);\n      // Reset file input\n      if (fileInputRef.current) {\n        fileInputRef.current.value = '';\n      }\n    }\n  };\n\n  // Download Template\n  const handleDownloadTemplate = async () => {\n    try {\n      await downloadAssetTemplate();\n      addToast('Template Excel berhasil didownload', 'success');\n    } catch (error) {\n      console.error('Download template error:', error);\n      addToast('Gagal download template', 'error');\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col sm:flex-row justify-between gap-4\">\n        <h1 className=\"text-2xl font-bold text-slate-900 dark:text-white\">\n          Manajemen Aset & Pemeliharaan\n        </h1>\n        <div className=\"flex gap-2\">\n          {/* Excel Import/Export Buttons */}\n          <button\n            onClick={handleDownloadTemplate}\n            className=\"flex items-center gap-2 px-3 py-2 text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 dark:bg-slate-700 dark:text-white dark:border-slate-600 dark:hover:bg-slate-600\"\n            title=\"Download Template Excel\"\n          >\n            <DownloadIcon className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline text-sm\">Template</span>\n          </button>\n\n          <input\n            ref={fileInputRef}\n            type=\"file\"\n            accept=\".xlsx,.xls\"\n            onChange={handleImportFromExcel}\n            className=\"hidden\"\n          />\n          <button\n            onClick={() => fileInputRef.current?.click()}\n            disabled={!canAddNewAsset}\n            className=\"flex items-center gap-2 px-3 py-2 text-white bg-green-600 rounded-lg hover:bg-green-700 disabled:bg-green-400 disabled:cursor-not-allowed\"\n            title=\"Import dari Excel\"\n          >\n            <UploadIcon className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline text-sm\">Import</span>\n          </button>\n\n          <button\n            onClick={handleExportToExcel}\n            disabled={assets.length === 0}\n            className=\"flex items-center gap-2 px-3 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700 disabled:bg-blue-400 disabled:cursor-not-allowed\"\n            title=\"Export ke Excel\"\n          >\n            <DownloadIcon className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline text-sm\">Export</span>\n          </button>\n\n          <button\n            onClick={() => handleOpenAssetForm()}\n            className=\"px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:bg-blue-400 disabled:cursor-not-allowed\"\n            disabled={!canAddNewAsset}\n          >\n            Tambah Aset\n          </button>\n        </div>\n      </div>\n      {!canAddNewAsset && (\n        <p className=\"text-sm text-yellow-600 dark:text-yellow-400\">\n          Pilih cabang spesifik di header untuk menambah aset baru.\n        </p>\n      )}\n\n      <div className=\"flex flex-col sm:flex-row gap-4\">\n        <div className=\"relative flex-1\">\n          <SearchIcon className=\"absolute left-3 top-3 w-5 h-5 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Cari aset...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"w-full pl-10 p-2 rounded-lg border dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n          />\n        </div>\n        <select\n          value={maintenanceFilter}\n          onChange={(e) => handleFilterChange(e.target.value as 'all' | 'due')}\n          className=\"w-full sm:w-48 p-2 rounded-lg border dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n        >\n          <option value=\"all\">Semua Aset</option>\n          <option value=\"due\">Perawatan Jatuh Tempo</option>\n        </select>\n      </div>\n\n      <div className=\"bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm border dark:border-slate-700\">\n        {/* Desktop Table View */}\n        <div className=\"overflow-x-auto hidden md:block\">\n          <table className=\"w-full text-base text-left text-slate-500 dark:text-slate-400\">\n            <thead className=\"text-sm text-slate-700 uppercase bg-slate-50 dark:bg-slate-700 dark:text-slate-400\">\n              <tr>\n                <th className=\"px-6 py-3\">\n                  <button\n                    onClick={() => requestSort('name')}\n                    className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                  >\n                    Nama Aset {getSortIcon('name')}\n                  </button>\n                </th>\n                {currentUser &&\n                  currentUser.role === UserRole.SuperAdmin &&\n                  selectedStoreId === 'all' && (\n                    <th className=\"px-6 py-3\">\n                      <button\n                        onClick={() => requestSort('storeName')}\n                        className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                      >\n                        Toko {getSortIcon('storeName')}\n                      </button>\n                    </th>\n                  )}\n                <th className=\"px-6 py-3\">\n                  <button\n                    onClick={() => requestSort('purchaseDate')}\n                    className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                  >\n                    Tanggal Beli {getSortIcon('purchaseDate')}\n                  </button>\n                </th>\n                <th className=\"px-6 py-3 text-right\">\n                  <button\n                    onClick={() => requestSort('purchaseCost')}\n                    className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200 ml-auto\"\n                  >\n                    Biaya Beli {getSortIcon('purchaseCost')}\n                  </button>\n                </th>\n                <th className=\"px-6 py-3\">\n                  <button\n                    onClick={() => requestSort('status')}\n                    className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                  >\n                    Status {getSortIcon('status')}\n                  </button>\n                </th>\n                <th className=\"px-6 py-3\">Aksi</th>\n              </tr>\n            </thead>\n            <tbody>\n              {sortedAssets.length > 0 ? (\n                sortedAssets.map((asset) => (\n                  <tr key={asset.id} className=\"border-b dark:border-slate-700\">\n                    <td className=\"px-6 py-4 font-medium text-slate-900 dark:text-white\">\n                      {asset.name}\n                    </td>\n                    {currentUser &&\n                      currentUser.role === UserRole.SuperAdmin &&\n                      selectedStoreId === 'all' && <td className=\"px-6 py-4\">{asset.storeName}</td>}\n                    <td className=\"px-6 py-4\">\n                      {asset.purchaseDate\n                        ? new Date(asset.purchaseDate).toLocaleDateString('id-ID')\n                        : '-'}\n                    </td>\n                    <td className=\"px-6 py-4 text-right\">\n                      {asset.purchaseCost\n                        ? `Rp ${asset.purchaseCost.toLocaleString('id-ID')}`\n                        : '-'}\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      <span\n                        className={`px-2 py-1 text-sm font-medium rounded-full ${getStatusBadge(asset.status)}`}\n                      >\n                        {asset.status}\n                      </span>\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      <div className=\"flex items-center space-x-2\">\n                        <button\n                          onClick={() => handleOpenAssetForm(asset)}\n                          title=\"Edit Aset\"\n                          className=\"p-2.5 rounded-md text-blue-600 hover:text-blue-900 dark:text-blue-500 dark:hover:text-blue-400 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                        >\n                          <EditIcon className=\"w-5 h-5\" />\n                        </button>\n                        <button\n                          onClick={() => handleDelete(asset)}\n                          title=\"Hapus Aset\"\n                          className=\"p-2.5 rounded-md text-red-600 hover:text-red-900 dark:text-red-500 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                        >\n                          <Trash2Icon className=\"w-5 h-5\" />\n                        </button>\n                        <button\n                          onClick={() => handleOpenMaintenanceForm(asset)}\n                          title=\"Tambah Log Pemeliharaan\"\n                          className=\"p-2.5 rounded-md text-green-600 hover:text-green-900 dark:text-green-500 dark:hover:text-green-400 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                        >\n                          <PlusCircleIcon className=\"w-5 h-5\" />\n                        </button>\n                        <button\n                          onClick={() => handleOpenSchedule(asset)}\n                          title=\"Jadwal Perawatan\"\n                          className=\"p-2 rounded-md text-purple-600 hover:text-purple-900 dark:text-purple-500 dark:hover:text-purple-400 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                        >\n                          <CalendarIcon className=\"w-5 h-5\" />\n                        </button>\n                        <button\n                          onClick={() => handleOpenHistory(asset)}\n                          title=\"Lihat Riwayat Pemeliharaan\"\n                          className=\"p-2.5 rounded-md text-slate-600 hover:text-slate-900 dark:text-slate-500 dark:hover:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                        >\n                          <HistoryIcon className=\"w-5 h-5\" />\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n                ))\n              ) : (\n                <tr>\n                  <td\n                    colSpan={\n                      currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' ? 6 : 5\n                    }\n                  >\n                    <EmptyState\n                      icon={<WrenchIcon className=\"mx-auto w-12 h-12 text-slate-400\" />}\n                      title={\n                        searchTerm || maintenanceFilter !== 'all'\n                          ? 'Aset Tidak Ditemukan'\n                          : 'Belum Ada Aset'\n                      }\n                      description={\n                        searchTerm || maintenanceFilter !== 'all'\n                          ? 'Coba kata kunci atau filter lain.'\n                          : 'Mulai dengan menambahkan aset pertama Anda.'\n                      }\n                    />\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Mobile Card View */}\n        <div className=\"md:hidden space-y-4\">\n          {sortedAssets.length > 0 ? (\n            sortedAssets.map((asset) => (\n              <div\n                key={asset.id}\n                className=\"bg-slate-50 dark:bg-slate-700/50 p-4 rounded-lg shadow-sm\"\n              >\n                <div className=\"flex justify-between items-start\">\n                  <div>\n                    <p className=\"font-bold text-lg text-slate-800 dark:text-slate-200\">\n                      {asset.name}\n                    </p>\n                    <span\n                      className={`px-2 py-0.5 text-xs font-medium rounded-full ${getStatusBadge(asset.status)}`}\n                    >\n                      {asset.status}\n                    </span>\n                  </div>\n                  <div className=\"flex items-center space-x-0\">\n                    <button\n                      onClick={() => handleOpenAssetForm(asset)}\n                      title=\"Edit Aset\"\n                      className=\"p-2.5 rounded-md text-blue-600 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                    >\n                      <EditIcon className=\"w-5 h-5\" />\n                    </button>\n                    <button\n                      onClick={() => handleDelete(asset)}\n                      title=\"Hapus Aset\"\n                      className=\"p-2.5 rounded-md text-red-600 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                    >\n                      <Trash2Icon className=\"w-5 h-5\" />\n                    </button>\n                  </div>\n                </div>\n                {currentUser &&\n                  currentUser.role === UserRole.SuperAdmin &&\n                  selectedStoreId === 'all' && (\n                    <p className=\"text-sm text-slate-500 dark:text-slate-400\">{asset.storeName}</p>\n                  )}\n                <div className=\"mt-3 space-y-1 text-sm border-t dark:border-slate-600 pt-2\">\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500 dark:text-slate-400\">Tgl Beli:</span>\n                    <span className=\"font-medium\">\n                      {asset.purchaseDate\n                        ? new Date(asset.purchaseDate).toLocaleDateString('id-ID')\n                        : '-'}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500 dark:text-slate-400\">Biaya:</span>\n                    <span className=\"font-medium\">\n                      {asset.purchaseCost\n                        ? `Rp ${asset.purchaseCost.toLocaleString('id-ID')}`\n                        : '-'}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"mt-3 flex items-center justify-end gap-2 text-sm\">\n                  <button\n                    onClick={() => handleOpenMaintenanceForm(asset)}\n                    className=\"flex items-center gap-1 py-1 px-3 rounded-md bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300\"\n                  >\n                    <PlusCircleIcon className=\"w-4 h-4\" /> Log\n                  </button>\n                  <button\n                    onClick={() => handleOpenSchedule(asset)}\n                    className=\"flex items-center gap-1 py-1 px-3 rounded-md bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300\"\n                  >\n                    <CalendarIcon className=\"w-4 h-4\" /> Jadwal\n                  </button>\n                  <button\n                    onClick={() => handleOpenHistory(asset)}\n                    className=\"flex items-center gap-1 py-1 px-3 rounded-md bg-slate-200 text-slate-800 dark:bg-slate-600 dark:text-slate-200\"\n                  >\n                    <HistoryIcon className=\"w-4 h-4\" /> Riwayat\n                  </button>\n                </div>\n              </div>\n            ))\n          ) : (\n            <EmptyState\n              icon={<WrenchIcon className=\"mx-auto w-12 h-12 text-slate-400\" />}\n              title={\n                searchTerm || maintenanceFilter !== 'all'\n                  ? 'Aset Tidak Ditemukan'\n                  : 'Belum Ada Aset'\n              }\n              description={\n                searchTerm || maintenanceFilter !== 'all'\n                  ? 'Coba kata kunci atau filter lain.'\n                  : 'Mulai dengan menambahkan aset pertama Anda.'\n              }\n            />\n          )}\n        </div>\n      </div>\n\n      {isAssetFormModalOpen && (\n        <AssetFormModal\n          asset={currentAsset}\n          onClose={() => setIsAssetFormModalOpen(false)}\n          onSave={handleSaveAsset}\n        />\n      )}\n      {isMaintenanceFormModalOpen && currentAsset && (\n        <MaintenanceFormModal\n          assetName={currentAsset.name}\n          onClose={() => setIsMaintenanceFormModalOpen(false)}\n          onSave={handleAddMaintenance}\n        />\n      )}\n      {isHistoryModalOpen && currentAsset && (\n        <MaintenanceHistoryModal\n          asset={currentAsset}\n          onClose={() => setIsHistoryModalOpen(false)}\n        />\n      )}\n      {isScheduleModalOpen && currentAsset && (\n        <ScheduledMaintenanceModal\n          asset={currentAsset}\n          isOpen={isScheduleModalOpen}\n          onClose={() => setIsScheduleModalOpen(false)}\n        />\n      )}\n      {assetToDelete && (\n        <ConfirmationModal\n          isOpen={true}\n          onClose={() => setAssetToDelete(null)}\n          onConfirm={confirmDelete}\n          title=\"Hapus Aset\"\n          message={`Anda yakin ingin menghapus aset \"${assetToDelete.name}\"?`}\n        />\n      )}\n    </div>\n  );\n};\n\nexport default AssetsPage;\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\management\\CustomerDetailPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\management\\CustomersPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\management\\ExpensesPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isSavingExpense' is assigned a value but never used.","line":39,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":39,"endColumn":25},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":78,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":78,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2993,2996],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2993,2996],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":94,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":94,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3560,3563],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3560,3563],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'handleExport' is assigned a value but never used.","line":289,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":289,"endColumn":21}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo, useRef } from 'react';\nimport { SearchIcon, DownloadIcon, UploadIcon } from '../../components/icons';\nimport {\n  exportExpensesToExcel,\n  importExpensesFromExcel,\n  downloadExpenseTemplate,\n} from '../../utils/excelUtils';\nimport ConfirmationModal from '../../components/ConfirmationModal';\nimport { useExpenses } from '../../contexts/ExpenseContext';\nimport { useAssets } from '../../contexts/AssetContext';\nimport ExpenseFormModal from '../../components/ExpenseFormModal';\nimport useAppContext from '../../contexts/useAppContext';\nimport { useAuditLogs } from '../../contexts/AuditLogContext';\nimport useToasts from '../../contexts/useToasts';\nimport { Expense, UserRole } from '@/types';\n\ntype CombinedExpenseItem = {\n  id: string;\n  date: string;\n  description: string;\n  category: string;\n  amount: number;\n  source: 'expense' | 'asset';\n};\n\nconst ExpensesPage: React.FC = () => {\n  const { expenses, addExpense, updateExpense, deleteExpense } = useExpenses();\n  const { assets } = useAssets();\n  const { currentUser, selectedStoreId } = useAppContext();\n  const { addAuditLog } = useAuditLogs();\n  const { addToast, updateToast } = useToasts();\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const [isFormModalOpen, setIsFormModalOpen] = useState(false);\n  const [currentExpense, setCurrentExpense] = useState<Expense | null>(null);\n  const [expenseToDelete, setExpenseToDelete] = useState<Expense | null>(null);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [categoryFilter, setCategoryFilter] = useState('all');\n  const [isSavingExpense, setIsSavingExpense] = useState(false);\n\n  const handleOpenFormModal = (expense: Expense | null = null) => {\n    setCurrentExpense(expense);\n    setIsFormModalOpen(true);\n  };\n\n  const handleCloseFormModal = () => {\n    setIsFormModalOpen(false);\n    setCurrentExpense(null);\n  };\n\n  const handleSaveExpense = async (expense: Omit<Expense, 'id' | 'storeId'>) => {\n    if (!currentUser) {\n      addToast('User context tidak tersedia.', 'error');\n      return;\n    }\n    const storeId =\n      currentExpense?.storeId ||\n      (currentUser.role === UserRole.SuperAdmin ? selectedStoreId : currentUser.storeId);\n\n    if (!storeId || storeId === 'all') {\n      addToast('Silakan pilih cabang spesifik.', 'warning');\n      return;\n    }\n\n    const toastId = addToast('Menyimpan pengeluaran...', 'info');\n    setIsSavingExpense(true);\n    try {\n      if (currentExpense && typeof currentExpense.id === 'string') {\n        await updateExpense(currentExpense.id, { ...expense, storeId });\n        addAuditLog(`Update pengeluaran: \"${expense.description}\"`, storeId);\n        updateToast(toastId, 'Berhasil diperbarui!', 'success');\n      } else {\n        await addExpense({ ...expense, storeId });\n        addAuditLog(`Tambah pengeluaran: \"${expense.description}\"`, storeId);\n        updateToast(toastId, 'Berhasil disimpan!', 'success');\n      }\n      handleCloseFormModal();\n    } catch (error: any) {\n      updateToast(toastId, `Gagal: ${error.message || 'Error'}`, 'error');\n    } finally {\n      setIsSavingExpense(false);\n    }\n  };\n\n  const confirmDelete = async () => {\n    if (!expenseToDelete) return;\n    const toastId = addToast('Menghapus...', 'info');\n    setIsSavingExpense(true);\n    try {\n      await deleteExpense(expenseToDelete.id);\n      addAuditLog(`Hapus pengeluaran: \"${expenseToDelete.description}\"`, expenseToDelete.storeId);\n      setExpenseToDelete(null);\n      updateToast(toastId, 'Berhasil dihapus!', 'success');\n    } catch (error: any) {\n      updateToast(toastId, `Gagal: ${error.message}`, 'error');\n    } finally {\n      setIsSavingExpense(false);\n    }\n  };\n\n  // PERBAIKAN 2: Logika \"Smart Merge\" untuk mencegah duplikasi tampilan\n  const allFinancialItems: CombinedExpenseItem[] = useMemo(() => {\n    // 1. Data dari tabel expenses\n    const operationalExpenses: CombinedExpenseItem[] = expenses.map((item) => ({\n      id: item.id,\n      date: item.date instanceof Date ? item.date.toISOString() : String(item.date),\n      description: item.description,\n      category: item.category,\n      amount: Number(item.amount),\n      source: 'expense',\n    }));\n\n    // 2. Data dari tabel assets (hanya jika belum ada di expenses)\n    const assetExpenses: CombinedExpenseItem[] = assets\n      .filter((asset) => asset.purchaseCost && asset.purchaseCost > 0)\n      .filter((asset) => {\n        // FIXED: More strict duplicate detection - require exact description match or ID\n        const assetDateStr = asset.purchaseDate ? String(asset.purchaseDate).split('T')[0] : '';\n\n        const isDuplicate = operationalExpenses.some((exp) => {\n          const expDateStr = exp.date.split('T')[0];\n          const assetDescription = `Pembelian Aset: ${asset.name}`;\n          // Exact match on date AND (exact description OR contains asset ID)\n          return (\n            expDateStr === assetDateStr &&\n            (exp.description === assetDescription || exp.description.includes(asset.id))\n          );\n        });\n        return !isDuplicate; // Tampilkan hanya jika BUKAN duplikat\n      })\n      .map((asset) => ({\n        id: asset.id,\n        date: asset.purchaseDate ? String(asset.purchaseDate) : new Date().toISOString(),\n        description: `Pembelian Aset: ${asset.name}`,\n        category: 'Aset / Inventaris',\n        amount: Number(asset.purchaseCost),\n        source: 'asset',\n      }));\n\n    return [...operationalExpenses, ...assetExpenses].sort(\n      (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),\n    );\n  }, [expenses, assets]);\n\n  const filteredItems = useMemo(() => {\n    return allFinancialItems.filter((item) => {\n      const matchesSearch = item.description.toLowerCase().includes(searchTerm.toLowerCase());\n      const matchesCategory = categoryFilter === 'all' || item.category === categoryFilter;\n      return matchesSearch && matchesCategory;\n    });\n  }, [allFinancialItems, searchTerm, categoryFilter]);\n\n  const itemsPerPage = 10;\n  const [currentPage, setCurrentPage] = useState(1);\n  const totalPages = Math.ceil(filteredItems.length / itemsPerPage);\n  const paginatedItems = filteredItems.slice(\n    (currentPage - 1) * itemsPerPage,\n    currentPage * itemsPerPage,\n  );\n  const totalExpense = filteredItems.reduce((sum, item) => sum + item.amount, 0);\n\n  // Excel Export\n  const handleExportToExcel = async () => {\n    try {\n      await exportExpensesToExcel(expenses);\n      addToast('Data pengeluaran berhasil di-export ke Excel', 'success');\n    } catch (error) {\n      console.error('Export error:', error);\n      addToast('Gagal export data ke Excel', 'error');\n    }\n  };\n\n  // Excel Import\n  const handleImportFromExcel = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    setIsSavingExpense(true);\n    const toastId = addToast('Memproses import data...', 'info');\n\n    try {\n      const importedExpenses = await importExpensesFromExcel(file);\n\n      let successCount = 0;\n      let errorCount = 0;\n      let skipCount = 0;\n\n      for (const expense of importedExpenses) {\n        try {\n          if (expense.id) {\n            // Validate UUID format before UPDATE\n            const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n            if (!uuidRegex.test(expense.id)) {\n              console.warn('Invalid UUID skipped:', expense.id);\n              skipCount++;\n              continue;\n            }\n\n            // Update existing expense\n            await updateExpense(expense.id, {\n              date: expense.date!,\n              description: expense.description!,\n              category: expense.category!,\n              amount: expense.amount!,\n              storeId: selectedStoreId === 'all' ? undefined : selectedStoreId,\n            });\n            successCount++;\n          } else {\n            // Check for duplicate before adding new expense\n            const existingExpense = expenses.find(\n              (e) =>\n                e.date === expense.date! &&\n                e.description.toLowerCase() === expense.description!.toLowerCase(),\n            );\n            if (existingExpense) {\n              console.warn('Duplicate expense skipped:', expense.description);\n              skipCount++;\n              continue;\n            }\n\n            // Ensure storeId is set for INSERT (RLS policy requirement)\n            const storeId = selectedStoreId === 'all' ? currentUser?.storeId : selectedStoreId;\n\n            if (!storeId) {\n              console.error('storeId is required for new expenses');\n              errorCount++;\n              continue;\n            }\n\n            // Add new expense\n            await addExpense({\n              date: expense.date!,\n              description: expense.description!,\n              category: expense.category!,\n              amount: expense.amount!,\n              storeId: storeId,\n            });\n            successCount++;\n          }\n        } catch (error) {\n          console.error('Error importing expense:', expense, error);\n          errorCount++;\n        }\n      }\n\n      if (skipCount > 0) {\n        updateToast(\n          toastId,\n          `Import selesai: ${successCount} berhasil, ${errorCount} gagal, ${skipCount} dilewati (duplikat/invalid)`,\n          'warning',\n        );\n      } else if (errorCount > 0) {\n        updateToast(\n          toastId,\n          `Import selesai: ${successCount} berhasil, ${errorCount} gagal`,\n          'warning',\n        );\n      } else {\n        updateToast(toastId, `Berhasil import ${successCount} pengeluaran`, 'success');\n      }\n\n      addAuditLog(\n        `Import ${successCount} pengeluaran dari Excel`,\n        selectedStoreId === 'all' ? undefined : selectedStoreId,\n      );\n    } catch (error) {\n      console.error('Import error:', error);\n      updateToast(toastId, 'Gagal import data dari Excel', 'error');\n    } finally {\n      setIsSavingExpense(false);\n      // Reset file input\n      if (fileInputRef.current) {\n        fileInputRef.current.value = '';\n      }\n    }\n  };\n\n  // Download Template\n  const handleDownloadTemplate = async () => {\n    try {\n      await downloadExpenseTemplate();\n      addToast('Template Excel berhasil didownload', 'success');\n    } catch (error) {\n      console.error('Download template error:', error);\n      addToast('Gagal download template', 'error');\n    }\n  };\n\n  const handleExport = () => {\n    const dataToExport = filteredItems.map((item) => ({\n      Tanggal: new Date(item.date).toLocaleDateString('id-ID'),\n      Keterangan: item.description,\n      Kategori: item.category,\n      Jumlah: item.amount,\n      Sumber: item.source === 'asset' ? 'Tabel Aset' : 'Tabel Pengeluaran',\n    }));\n    addAuditLog(\n      `Export data pengeluaran (${dataToExport.length} item) ke Excel.`,\n      selectedStoreId !== 'all' ? selectedStoreId : undefined,\n    );\n    import('exceljs').then(({ Workbook }) => {\n      const workbook = new Workbook();\n      const worksheet = workbook.addWorksheet('Rincian Pengeluaran');\n\n      // Set columns\n      worksheet.columns = [\n        { header: 'Tanggal', key: 'Tanggal', width: 15 },\n        { header: 'Deskripsi', key: 'Deskripsi', width: 30 },\n        { header: 'Kategori', key: 'Kategori', width: 20 },\n        { header: 'Jumlah', key: 'Jumlah', width: 15 },\n        { header: 'Sumber', key: 'Sumber', width: 20 },\n      ];\n\n      // Add rows\n      worksheet.addRows(dataToExport);\n\n      // Generate and download\n      workbook.xlsx.writeBuffer().then((buffer) => {\n        const blob = new Blob([buffer], {\n          type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n        });\n        const url = URL.createObjectURL(blob);\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = 'Laporan_Pengeluaran.xlsx';\n        a.click();\n        URL.revokeObjectURL(url);\n      });\n    });\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col sm:flex-row justify-between gap-4\">\n        <h1 className=\"text-2xl font-bold text-slate-900 dark:text-white\">Manajemen Pengeluaran</h1>\n        <div className=\"flex gap-2\">\n          {/* Excel Import/Export Buttons */}\n          <button\n            onClick={handleDownloadTemplate}\n            className=\"flex items-center gap-2 px-3 py-2 text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 dark:bg-slate-700 dark:text-white dark:border-slate-600 dark:hover:bg-slate-600\"\n            title=\"Download Template Excel\"\n          >\n            <DownloadIcon className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline text-sm\">Template</span>\n          </button>\n\n          <input\n            ref={fileInputRef}\n            type=\"file\"\n            accept=\".xlsx,.xls\"\n            onChange={handleImportFromExcel}\n            className=\"hidden\"\n          />\n          <button\n            onClick={() => fileInputRef.current?.click()}\n            className=\"flex items-center gap-2 px-3 py-2 text-white bg-green-600 rounded-lg hover:bg-green-700\"\n            title=\"Import dari Excel\"\n          >\n            <UploadIcon className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline text-sm\">Import</span>\n          </button>\n\n          <button\n            onClick={handleExportToExcel}\n            disabled={expenses.length === 0}\n            className=\"flex items-center gap-2 px-3 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700 disabled:bg-blue-400 disabled:cursor-not-allowed\"\n            title=\"Export ke Excel\"\n          >\n            <DownloadIcon className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline text-sm\">Export</span>\n          </button>\n\n          <button\n            onClick={() => handleOpenFormModal()}\n            className=\"px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700\"\n          >\n            Tambah Pengeluaran\n          </button>\n        </div>\n      </div>\n\n      <div className=\"bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm border dark:border-slate-700\">\n        <h3 className=\"text-slate-500 dark:text-slate-400 font-medium mb-2\">Total Pengeluaran</h3>\n        <p className=\"text-3xl font-bold text-slate-900 dark:text-white\">\n          Rp {totalExpense.toLocaleString('id-ID')}\n        </p>\n      </div>\n\n      <div className=\"flex flex-col sm:flex-row gap-4\">\n        <div className=\"relative flex-1\">\n          <SearchIcon className=\"absolute left-3 top-3 w-5 h-5 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Cari...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"w-full pl-10 p-2 rounded-lg border dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n          />\n        </div>\n        <select\n          value={categoryFilter}\n          onChange={(e) => setCategoryFilter(e.target.value)}\n          className=\"w-full sm:w-48 p-2 rounded-lg border dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n        >\n          <option value=\"all\">Semua Kategori</option>\n          <option value=\"Aset / Inventaris\">Aset / Inventaris</option>\n          <option value=\"Operasional\">Operasional</option>\n          <option value=\"Pemeliharaan\">Pemeliharaan</option>\n          <option value=\"Gaji\">Gaji</option>\n          <option value=\"Lainnya\">Lainnya</option>\n        </select>\n      </div>\n\n      <div className=\"bg-white dark:bg-slate-800 rounded-lg shadow overflow-hidden\">\n        <table className=\"w-full text-left text-sm text-slate-500 dark:text-slate-400\">\n          <thead className=\"bg-slate-50 dark:bg-slate-700 text-slate-700 dark:text-slate-400 uppercase\">\n            <tr>\n              <th className=\"px-6 py-3\">Tanggal</th>\n              <th className=\"px-6 py-3\">Keterangan</th>\n              <th className=\"px-6 py-3\">Kategori</th>\n              <th className=\"px-6 py-3 text-right\">Jumlah</th>\n              <th className=\"px-6 py-3 text-center\">Sumber</th>\n              <th className=\"px-6 py-3 text-center\">Aksi</th>\n            </tr>\n          </thead>\n          <tbody>\n            {paginatedItems.length > 0 ? (\n              paginatedItems.map((item) => (\n                <tr\n                  key={`${item.source}-${item.id}`}\n                  className=\"border-b dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700\"\n                >\n                  <td className=\"px-6 py-4\">{new Date(item.date).toLocaleDateString('id-ID')}</td>\n                  <td className=\"px-6 py-4 font-medium text-slate-900 dark:text-white\">\n                    {item.description}\n                  </td>\n                  <td className=\"px-6 py-4\">\n                    <span\n                      className={`px-2 py-1 rounded-full text-xs ${item.category.includes('Aset') ? 'bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300' : 'bg-slate-100 text-slate-800 dark:bg-slate-700 dark:text-slate-300'}`}\n                    >\n                      {item.category}\n                    </span>\n                  </td>\n                  <td className=\"px-6 py-4 text-right text-slate-900 dark:text-white\">\n                    Rp {item.amount.toLocaleString('id-ID')}\n                  </td>\n                  <td className=\"px-6 py-4 text-center\">\n                    {item.source === 'asset' ? 'Aset' : 'Pengeluaran'}\n                  </td>\n                  <td className=\"px-6 py-4 text-center\">\n                    {item.source === 'expense' ? (\n                      <button\n                        onClick={() =>\n                          setExpenseToDelete(expenses.find((e) => e.id === item.id) || null)\n                        }\n                        className=\"text-red-600 hover:underline\"\n                      >\n                        Hapus\n                      </button>\n                    ) : (\n                      <span className=\"text-gray-400 italic\">Kelola di Aset</span>\n                    )}\n                  </td>\n                </tr>\n              ))\n            ) : (\n              <tr>\n                <td colSpan={6} className=\"px-6 py-8 text-center\">\n                  Tidak ada data.\n                </td>\n              </tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n\n      {/* Simple Pagination Controls */}\n      {totalPages > 1 && (\n        <div className=\"flex justify-center gap-2\">\n          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (\n            <button\n              key={page}\n              onClick={() => setCurrentPage(page)}\n              className={`px-3 py-1 rounded ${currentPage === page ? 'bg-blue-600 text-white' : 'bg-white border'}`}\n            >\n              {page}\n            </button>\n          ))}\n        </div>\n      )}\n\n      <ExpenseFormModal\n        isOpen={isFormModalOpen}\n        expense={currentExpense}\n        onClose={handleCloseFormModal}\n        onSave={handleSaveExpense}\n      />\n\n      <ConfirmationModal\n        isOpen={!!expenseToDelete}\n        onClose={() => setExpenseToDelete(null)}\n        onConfirm={confirmDelete}\n        title=\"Hapus Pengeluaran\"\n        message=\"Yakin ingin menghapus data ini?\"\n      />\n    </div>\n  );\n};\n\nexport default ExpensesPage;\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\management\\InventoryPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'PlusCircleIcon' is defined but never used.","line":6,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":6,"endColumn":17}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect, useMemo, useRef } from 'react';\nimport { useMutation } from '@tanstack/react-query';\nimport { useLocation, useNavigate, useSearchParams } from 'react-router-dom';\nimport { useQuery } from '@tanstack/react-query';\nimport {\n  PlusCircleIcon,\n  EditIcon,\n  Trash2Icon,\n  PackageIcon,\n  SearchIcon,\n  ArrowUpIcon,\n  ArrowDownIcon,\n  DownloadIcon,\n  UploadIcon,\n} from '../../components/icons';\nimport {\n  exportInventoryToExcel,\n  importInventoryFromExcel,\n  downloadInventoryTemplate,\n} from '../../utils/excelUtils';\nimport EmptyState from '../../components/EmptyState';\nimport ConfirmationModal from '../../components/ConfirmationModal';\nimport { fetchInventory, useInventoryMutations } from '../../contexts/InventoryContext';\nimport useAppContext from '../../contexts/useAppContext';\nimport InventoryFormModal from '../../components/InventoryFormModal';\nimport { useAuditLogs } from '../../contexts/AuditLogContext';\nimport useToasts from '../../contexts/useToasts';\nimport { useSortableData } from '../../hooks/useSortableData';\nimport { useDebounce } from '../../hooks/useDebounce';\n\nimport Pagination from '../../components/Pagination';\nimport { InventoryItem, UserRole } from '@/types';\n\nconst InventoryPage: React.FC = () => {\n  const { currentUser, selectedStoreId, stores } = useAppContext();\n  const [page, setPage] = useState(1);\n  const pageSize = 20;\n  const [searchTerm, setSearchTerm] = useState('');\n  const debouncedSearchTerm = useDebounce(searchTerm, 300);\n\n  const { data: result = { data: [], count: 0 } } = useQuery({\n    queryKey: [\n      'inventory',\n      { page, pageSize, searchTerm: debouncedSearchTerm, storeId: selectedStoreId },\n    ],\n    queryFn: () =>\n      fetchInventory({ page, pageSize, searchTerm: debouncedSearchTerm, storeId: selectedStoreId }),\n    placeholderData: (previousData) => previousData,\n  });\n  const inventory = result.data;\n  const totalCount = result.count;\n  const totalPages = Math.ceil(totalCount / pageSize);\n\n  const { addInventoryItem, updateInventoryItem, deleteInventoryItem } = useInventoryMutations();\n  const { addAuditLog } = useAuditLogs();\n  const { addToast, updateToast } = useToasts();\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  type InventoryInput = Omit<InventoryItem, 'id'>;\n  const addInventoryMutation = useMutation({\n    mutationFn: async (data: InventoryInput) => addInventoryItem(data),\n  });\n  const updateInventoryMutation = useMutation({\n    mutationFn: async ({ id, data }: { id: string; data: InventoryInput }) =>\n      updateInventoryItem(id, data),\n  });\n  const deleteInventoryMutation = useMutation({\n    mutationFn: async (id: string) => deleteInventoryItem(id),\n  });\n  const [isFormModalOpen, setIsFormModalOpen] = useState(false);\n  const [currentItem, setCurrentItem] = useState<InventoryItem | null>(null);\n  const [itemToDelete, setItemToDelete] = useState<InventoryItem | null>(null);\n  const location = useLocation();\n  const navigate = useNavigate();\n  const [searchParams, setSearchParams] = useSearchParams();\n  const [filter, setFilter] = useState<'all' | 'low_stock'>(() =>\n    searchParams.get('filter') === 'low_stock' ? 'low_stock' : 'all',\n  );\n\n  useEffect(() => {\n    if (location.state?.openModal) {\n      handleOpenFormModal();\n      navigate(location.pathname, { replace: true, state: {} });\n    }\n    const filterParam = searchParams.get('filter');\n    setFilter(filterParam === 'low_stock' ? 'low_stock' : 'all');\n  }, [location.state, location.pathname, navigate, searchParams]);\n\n  const handleOpenFormModal = (item: InventoryItem | null = null) => {\n    setCurrentItem(item);\n    setIsFormModalOpen(true);\n  };\n\n  const handleCloseFormModal = () => {\n    setIsFormModalOpen(false);\n    setCurrentItem(null);\n  };\n\n  const handleSaveItem = async (item: Omit<InventoryItem, 'id' | 'storeId'>) => {\n    const storeId =\n      currentItem?.storeId ||\n      (currentUser?.role === UserRole.SuperAdmin ? selectedStoreId : currentUser?.storeId);\n    if (!storeId || storeId === 'all') {\n      addToast('Silakan pilih cabang spesifik untuk menambah atau mengedit item.', 'warning');\n      return;\n    }\n    const toastId = addToast('Menyimpan item inventaris...', 'info');\n    try {\n      if (currentItem && currentItem.id) {\n        await updateInventoryMutation.mutateAsync({\n          id: currentItem.id,\n          data: { ...item, storeId },\n        });\n        addAuditLog(`Memperbarui item inventaris: \"${item.name}\".`, storeId);\n        updateToast(toastId, 'Data inventaris berhasil diperbarui!', 'success');\n      } else {\n        await addInventoryMutation.mutateAsync({ ...item, storeId });\n        addAuditLog(`Menambahkan item inventaris baru: \"${item.name}\".`, storeId);\n        updateToast(toastId, 'Item inventaris berhasil ditambahkan!', 'success');\n      }\n      handleCloseFormModal();\n    } catch (error: unknown) {\n      if (error && typeof error === 'object' && 'message' in error) {\n        updateToast(toastId, `Gagal menyimpan: ${(error as { message: string }).message}`, 'error');\n      } else {\n        updateToast(toastId, 'Gagal menyimpan: Unknown error', 'error');\n      }\n    }\n  };\n\n  const handleDelete = (item: InventoryItem) => {\n    setItemToDelete(item);\n  };\n\n  const confirmDelete = async () => {\n    if (itemToDelete) {\n      const toastId = addToast('Menghapus item inventaris...', 'info');\n      try {\n        await deleteInventoryMutation.mutateAsync(itemToDelete.id);\n        addAuditLog(`Menghapus item inventaris: \"${itemToDelete.name}\".`, itemToDelete.storeId!);\n        updateToast(toastId, 'Item inventaris berhasil dihapus!', 'success');\n      } catch (error: unknown) {\n        if (error && typeof error === 'object' && 'message' in error) {\n          updateToast(\n            toastId,\n            `Gagal menghapus: ${(error as { message: string }).message}`,\n            'error',\n          );\n        } else {\n          updateToast(toastId, 'Gagal menghapus: Unknown error', 'error');\n        }\n      } finally {\n        setItemToDelete(null);\n      }\n    }\n  };\n\n  const inventoryWithStore = useMemo(\n    () =>\n      inventory.map((item) => ({\n        ...item,\n        storeName: stores.find((s) => s.id === item.storeId)?.name || 'N/A',\n      })),\n    [inventory, stores],\n  );\n\n  type InventoryWithStore = (typeof inventoryWithStore)[0];\n\n  const filteredInventory = useMemo(\n    () =>\n      inventoryWithStore.filter((item) => {\n        if (filter === 'low_stock') {\n          // FIXED: Exclude items with threshold=0 (monitoring disabled)\n          return item.lowStockThreshold > 0 && item.stock <= item.lowStockThreshold;\n        }\n        return true;\n      }),\n    [inventoryWithStore, filter],\n  );\n\n  const {\n    items: sortedInventory,\n    requestSort,\n    sortConfig,\n  } = useSortableData<InventoryWithStore>(filteredInventory);\n  // Pagination handled by server, so just use sortedInventory\n\n  const getSortIcon = (key: keyof InventoryWithStore) => {\n    if (!sortConfig || sortConfig.key !== key) return null;\n    if (sortConfig.direction === 'ascending')\n      return <ArrowUpIcon className=\"w-4 h-4 inline ml-1\" />;\n    return <ArrowDownIcon className=\"w-4 h-4 inline ml-1\" />;\n  };\n\n  const canAddNewItem = !(currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all');\n\n  const handleFilterChange = (newFilter: 'all' | 'low_stock') => {\n    setFilter(newFilter);\n    if (newFilter === 'low_stock') {\n      searchParams.set('filter', 'low_stock');\n    } else {\n      searchParams.delete('filter');\n    }\n    setSearchParams(searchParams);\n  };\n\n  // Excel Export\n  const handleExportToExcel = async () => {\n    try {\n      await exportInventoryToExcel(inventory);\n      addToast('Data inventaris berhasil di-export ke Excel', 'success');\n    } catch (error) {\n      console.error('Export error:', error);\n      addToast('Gagal export data ke Excel', 'error');\n    }\n  };\n\n  // Excel Import\n  const handleImportFromExcel = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    const toastId = addToast('Memproses import data...', 'info');\n\n    try {\n      const importedItems = await importInventoryFromExcel(file);\n\n      let successCount = 0;\n      let errorCount = 0;\n      let skipCount = 0;\n\n      for (const item of importedItems) {\n        try {\n          if (item.id) {\n            // Validate UUID format before UPDATE\n            const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n            if (!uuidRegex.test(item.id)) {\n              console.warn('Invalid UUID skipped:', item.id);\n              skipCount++;\n              continue;\n            }\n\n            // Update existing item\n            await updateInventoryMutation.mutateAsync({\n              id: item.id,\n              data: {\n                name: item.name!,\n                stock: item.stock!,\n                unit: item.unit!,\n                lowStockThreshold: item.lowStockThreshold!,\n                storeId: selectedStoreId === 'all' ? undefined : selectedStoreId!,\n              } as InventoryInput,\n            });\n            successCount++;\n          } else {\n            // Check for duplicate before adding new item\n            const existingItem = inventory?.find(\n              (i) => i.name.toLowerCase() === item.name!.toLowerCase(),\n            );\n            if (existingItem) {\n              console.warn('Duplicate item skipped:', item.name);\n              skipCount++;\n              continue;\n            }\n\n            // Ensure storeId is set for INSERT (RLS policy requirement)\n            const storeId = selectedStoreId === 'all' ? currentUser?.storeId : selectedStoreId;\n\n            if (!storeId) {\n              console.error('storeId is required for new items');\n              errorCount++;\n              continue;\n            }\n\n            // Add new item\n            await addInventoryMutation.mutateAsync({\n              name: item.name!,\n              stock: item.stock!,\n              unit: item.unit!,\n              lowStockThreshold: item.lowStockThreshold!,\n              storeId: storeId!,\n            });\n            successCount++;\n          }\n        } catch (error) {\n          console.error('Error importing item:', item, error);\n          errorCount++;\n        }\n      }\n\n      if (skipCount > 0) {\n        updateToast(\n          toastId,\n          `Import selesai: ${successCount} berhasil, ${errorCount} gagal, ${skipCount} dilewati (duplikat/invalid)`,\n          'warning',\n        );\n      } else if (errorCount > 0) {\n        updateToast(\n          toastId,\n          `Import selesai: ${successCount} berhasil, ${errorCount} gagal`,\n          'warning',\n        );\n      } else {\n        updateToast(toastId, `Berhasil import ${successCount} item inventaris`, 'success');\n      }\n\n      addAuditLog(\n        `Import ${successCount} item inventaris dari Excel`,\n        selectedStoreId === 'all' ? undefined : selectedStoreId,\n      );\n    } catch (error) {\n      console.error('Import error:', error);\n      updateToast(toastId, 'Gagal import data dari Excel', 'error');\n    } finally {\n      // Reset file input\n      if (fileInputRef.current) {\n        fileInputRef.current.value = '';\n      }\n    }\n  };\n\n  // Download Template\n  const handleDownloadTemplate = async () => {\n    try {\n      await downloadInventoryTemplate();\n      addToast('Template Excel berhasil didownload', 'success');\n    } catch (error) {\n      console.error('Download template error:', error);\n      addToast('Gagal download template', 'error');\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col sm:flex-row justify-between gap-4\">\n        <h1 className=\"text-2xl font-bold text-slate-900 dark:text-white\">Manajemen Inventaris</h1>\n        <div className=\"flex gap-2\">\n          {/* Excel Import/Export Buttons */}\n          <button\n            onClick={handleDownloadTemplate}\n            className=\"flex items-center gap-2 px-3 py-2 text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 dark:bg-slate-700 dark:text-white dark:border-slate-600 dark:hover:bg-slate-600\"\n            title=\"Download Template Excel\"\n          >\n            <DownloadIcon className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline text-sm\">Template</span>\n          </button>\n\n          <input\n            ref={fileInputRef}\n            type=\"file\"\n            accept=\".xlsx,.xls\"\n            onChange={handleImportFromExcel}\n            className=\"hidden\"\n          />\n          <button\n            onClick={() => fileInputRef.current?.click()}\n            disabled={!canAddNewItem}\n            className=\"flex items-center gap-2 px-3 py-2 text-white bg-green-600 rounded-lg hover:bg-green-700 disabled:bg-green-400 disabled:cursor-not-allowed\"\n            title=\"Import dari Excel\"\n          >\n            <UploadIcon className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline text-sm\">Import</span>\n          </button>\n\n          <button\n            onClick={handleExportToExcel}\n            disabled={inventory.length === 0}\n            className=\"flex items-center gap-2 px-3 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700 disabled:bg-blue-400 disabled:cursor-not-allowed\"\n            title=\"Export ke Excel\"\n          >\n            <DownloadIcon className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline text-sm\">Export</span>\n          </button>\n\n          <button\n            onClick={() => handleOpenFormModal()}\n            disabled={!canAddNewItem}\n            className=\"px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:bg-blue-400 disabled:cursor-not-allowed\"\n          >\n            Tambah Item\n          </button>\n        </div>\n      </div>\n\n      <div className=\"flex flex-col sm:flex-row gap-4\">\n        <div className=\"relative flex-1\">\n          <SearchIcon className=\"absolute left-3 top-3 w-5 h-5 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Cari item...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"w-full pl-10 p-2 rounded-lg border dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n          />\n        </div>\n        <select\n          value={filter}\n          onChange={(e) => handleFilterChange(e.target.value as typeof filter)}\n          className=\"w-full sm:w-48 p-2 rounded-lg border dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n        >\n          <option value=\"all\">Semua Item</option>\n          <option value=\"low_stock\">Stok Rendah</option>\n        </select>\n      </div>\n\n      {!canAddNewItem && (\n        <p className=\"text-sm text-yellow-600 dark:text-yellow-400\">\n          Pilih cabang spesifik di header untuk menambah item baru.\n        </p>\n      )}\n\n      <div className=\"bg-white dark:bg-slate-800 rounded-lg shadow overflow-hidden hidden md:block\">\n        <table className=\"w-full text-left text-sm text-slate-500 dark:text-slate-400\">\n          <thead className=\"bg-slate-50 dark:bg-slate-700 text-slate-700 dark:text-slate-400 uppercase\">\n            <tr>\n              <th className=\"px-6 py-3\">\n                <button\n                  onClick={() => requestSort('name')}\n                  className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                >\n                  Nama Item {getSortIcon('name')}\n                </button>\n              </th>\n              {currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' && (\n                <th className=\"px-6 py-3\">\n                  <button\n                    onClick={() => requestSort('storeName')}\n                    className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                  >\n                    Toko {getSortIcon('storeName')}\n                  </button>\n                </th>\n              )}\n              <th className=\"px-6 py-3\">\n                <button\n                  onClick={() => requestSort('stock')}\n                  className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                >\n                  Stok {getSortIcon('stock')}\n                </button>\n              </th>\n              <th className=\"px-6 py-3\">Ambang Batas</th>\n              <th className=\"px-6 py-3\">Satuan</th>\n              <th className=\"px-6 py-3\">Status</th>\n              <th className=\"px-6 py-3\">Aksi</th>\n            </tr>\n          </thead>\n          <tbody>\n            {sortedInventory.length > 0 ? (\n              sortedInventory.map((item) => {\n                let stockStatus = '';\n                let statusClass = '';\n                if (item.stock === 0) {\n                  stockStatus = 'Stok Habis';\n                  statusClass = 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300';\n                } else if (item.stock > 0 && item.stock <= item.lowStockThreshold) {\n                  stockStatus = 'Stok Rendah';\n                  statusClass =\n                    'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/50 dark:text-yellow-300';\n                } else {\n                  stockStatus = 'Aman';\n                  statusClass =\n                    'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300';\n                }\n                return (\n                  <tr\n                    key={item.id}\n                    className=\"border-b dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700\"\n                  >\n                    <td className=\"px-6 py-4 font-medium text-slate-900 dark:text-white\">\n                      {item.name}\n                    </td>\n                    {currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' && (\n                      <td className=\"px-6 py-4\">{item.storeName}</td>\n                    )}\n                    <td\n                      className={`px-6 py-4 ${item.stock === 0 ? 'text-red-500 font-bold' : item.stock <= item.lowStockThreshold ? 'text-yellow-600 font-bold' : 'text-slate-900 dark:text-white'}`}\n                    >\n                      {item.stock}\n                    </td>\n                    <td className=\"px-6 py-4\">{item.lowStockThreshold}</td>\n                    <td className=\"px-6 py-4\">{item.unit}</td>\n                    <td className=\"px-6 py-4\">\n                      <span className={`px-2 py-1 text-sm font-medium rounded-full ${statusClass}`}>\n                        {stockStatus}\n                      </span>\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      <div className=\"flex items-center space-x-2\">\n                        <button\n                          onClick={() => handleOpenFormModal(item)}\n                          className=\"p-2.5 rounded-md text-blue-600 hover:text-blue-900 dark:text-blue-500 dark:hover:text-blue-400 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                        >\n                          <EditIcon className=\"w-5 h-5\" />\n                        </button>\n                        <button\n                          onClick={() => handleDelete(item)}\n                          className=\"p-2.5 rounded-md text-red-600 hover:text-red-900 dark:text-red-500 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                        >\n                          <Trash2Icon className=\"w-5 h-5\" />\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n                );\n              })\n            ) : (\n              <tr>\n                <td\n                  colSpan={\n                    currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' ? 7 : 6\n                  }\n                >\n                  <EmptyState\n                    icon={<PackageIcon className=\"mx-auto w-12 h-12 text-slate-400\" />}\n                    title={\n                      debouncedSearchTerm || filter !== 'all'\n                        ? 'Item Tidak Ditemukan'\n                        : 'Belum Ada Item Inventaris'\n                    }\n                    description={\n                      debouncedSearchTerm || filter !== 'all'\n                        ? 'Coba kata kunci atau filter lain.'\n                        : 'Mulai dengan menambahkan item pertama Anda.'\n                    }\n                  />\n                </td>\n              </tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n\n      <div className=\"md:hidden space-y-4\">\n        {sortedInventory.length > 0 ? (\n          sortedInventory.map((item) => {\n            let stockStatus = '';\n            let statusClass = '';\n            if (item.stock === 0) {\n              stockStatus = 'Stok Habis';\n              statusClass = 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300';\n            } else if (item.stock > 0 && item.stock <= item.lowStockThreshold) {\n              stockStatus = 'Stok Rendah';\n              statusClass =\n                'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/50 dark:text-yellow-300';\n            } else {\n              stockStatus = 'Aman';\n              statusClass = 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300';\n            }\n            return (\n              <div\n                key={item.id}\n                className=\"bg-slate-50 dark:bg-slate-700/50 p-4 rounded-lg shadow-sm\"\n              >\n                <div className=\"flex justify-between items-start\">\n                  <div>\n                    <p className=\"font-bold text-lg text-slate-800 dark:text-slate-200\">\n                      {item.name}\n                    </p>\n                    {currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' && (\n                      <p className=\"text-xs text-slate-400 dark:text-slate-500 mt-1\">\n                        {item.storeName}\n                      </p>\n                    )}\n                  </div>\n                  <div className=\"flex items-center space-x-1 flex-shrink-0\">\n                    <button\n                      onClick={() => handleOpenFormModal(item)}\n                      className=\"p-2.5 rounded-md text-blue-600 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                    >\n                      <EditIcon className=\"w-5 h-5\" />\n                    </button>\n                    <button\n                      onClick={() => handleDelete(item)}\n                      className=\"p-2.5 rounded-md text-red-600 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                    >\n                      <Trash2Icon className=\"w-5 h-5\" />\n                    </button>\n                  </div>\n                </div>\n                <div className=\"mt-3 grid grid-cols-2 gap-4 text-sm border-t dark:border-slate-600 pt-2\">\n                  <div>\n                    <p className=\"text-slate-500 dark:text-slate-400\">Stok Saat Ini</p>\n                    <p\n                      className={`font-semibold text-lg ${item.stock === 0 ? 'text-red-500' : item.stock <= item.lowStockThreshold ? 'text-yellow-600' : 'text-slate-800 dark:text-slate-200'}`}\n                    >\n                      {item.stock} {item.unit}\n                    </p>\n                  </div>\n                  <div>\n                    <p className=\"text-slate-500 dark:text-slate-400\">Status Stok</p>\n                    <span className={`px-2 py-0.5 text-xs font-medium rounded-full ${statusClass}`}>\n                      {stockStatus}\n                    </span>\n                  </div>\n                </div>\n              </div>\n            );\n          })\n        ) : (\n          <EmptyState\n            icon={<PackageIcon className=\"mx-auto w-12 h-12 text-slate-400\" />}\n            title={\n              debouncedSearchTerm || filter !== 'all'\n                ? 'Item Tidak Ditemukan'\n                : 'Belum Ada Item Inventaris'\n            }\n            description={\n              debouncedSearchTerm || filter !== 'all'\n                ? 'Coba kata kunci atau filter lain.'\n                : 'Mulai dengan menambahkan item pertama Anda.'\n            }\n          />\n        )}\n      </div>\n\n      <Pagination currentPage={page} totalPages={totalPages} onPageChange={setPage} />\n\n      {isFormModalOpen && (\n        <InventoryFormModal\n          item={currentItem}\n          onClose={handleCloseFormModal}\n          onSave={handleSaveItem}\n        />\n      )}\n\n      {itemToDelete && (\n        <ConfirmationModal\n          isOpen={true}\n          onClose={() => setItemToDelete(null)}\n          onConfirm={confirmDelete}\n          title=\"Hapus Item Inventaris\"\n          message={`Apakah Anda yakin ingin menghapus item \"${itemToDelete.name}\"?`}\n        />\n      )}\n    </div>\n  );\n};\n\nexport default InventoryPage;\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\management\\ServicesPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\management\\SettingsPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\management\\StoresPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\management\\UsersPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'PlusCircleIcon' is defined but never used.","line":4,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":4,"endColumn":17},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isSavingUser' is assigned a value but never used.","line":33,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":33,"endColumn":22}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo } from 'react';\nimport { useUsers } from '../../contexts/UserContext';\nimport {\n  PlusCircleIcon,\n  EditIcon,\n  PowerIcon,\n  UsersIcon,\n  SearchIcon,\n  ArrowUpIcon,\n  ArrowDownIcon,\n} from '../../components/icons';\nimport EmptyState from '../../components/EmptyState';\nimport ConfirmationModal from '../../components/ConfirmationModal';\nimport { useStores } from '../../contexts/StoreContext';\nimport useAppContext from '../../contexts/useAppContext';\nimport useToasts from '../../contexts/useToasts';\nimport UserFormModal from '../../components/UserFormModal';\nimport { useAuditLogs } from '../../contexts/AuditLogContext';\nimport { useSortableData } from '../../hooks/useSortableData';\nimport { User, UserRole } from '@/types';\n\nconst UsersPage: React.FC = () => {\n  const { currentUser, selectedStoreId } = useAppContext();\n  const { addToast, updateToast } = useToasts();\n  // Ambil data users dari Supabase (props/context/hook) sesuai implementasi fetch profiles\n  const { stores } = useStores();\n  const { addAuditLog } = useAuditLogs();\n  const { users, updateUser } = useUsers();\n\n  const [isFormModalOpen, setIsFormModalOpen] = useState(false);\n  const [currentUserToEdit, setCurrentUserToEdit] = useState<User | null>(null);\n  const [userToToggleStatus, setUserToToggleStatus] = useState<User | null>(null);\n  const [isSavingUser, setIsSavingUser] = useState(false);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [roleFilter, setRoleFilter] = useState<\n    'all' | 'superadmin' | 'admin' | 'kasir' | 'active' | 'inactive'\n  >('all');\n\n  const handleOpenFormModal = (user: User | null = null) => {\n    setCurrentUserToEdit(user);\n    setIsFormModalOpen(true);\n  };\n\n  const handleToggleStatus = (user: User) => {\n    setUserToToggleStatus(user);\n  };\n\n  const handleAddUser = () => {\n    addToast(\n      'Penambahan pengguna baru harus dilakukan via Supabase Dashboard (Authentication). Setelah itu, profil dapat diedit di halaman ini.',\n      'info',\n    );\n  };\n\n  const handleCloseFormModal = () => {\n    setIsFormModalOpen(false);\n    setCurrentUserToEdit(null);\n  };\n\n  const handleSaveUser = async (userData: Omit<User, 'id'>) => {\n    const finalData = { ...userData };\n    if (finalData.role === UserRole.SuperAdmin) {\n      finalData.storeId = undefined;\n      finalData.isActive = true;\n      finalData.canGiveDiscount = true;\n    } else if (!finalData.storeId) {\n      addToast('Silakan pilih cabang untuk peran ini.', 'warning');\n      return;\n    }\n\n    const toastId = addToast('Menyimpan pengguna...', 'info');\n    setIsSavingUser(true);\n    try {\n      if (currentUserToEdit && currentUserToEdit.id) {\n        await updateUser(currentUserToEdit.id, {\n          name: finalData.name,\n          role: finalData.role,\n          storeId: finalData.storeId,\n          isActive: finalData.isActive,\n          canGiveDiscount: finalData.canGiveDiscount,\n        });\n        addAuditLog(`Memperbarui data pengguna: \"${finalData.name}\".`);\n        updateToast(toastId, 'Pengguna berhasil diperbarui!', 'success');\n        handleCloseFormModal();\n      } else {\n        updateToast(\n          toastId,\n          'Penambahan pengguna baru harus dilakukan via Supabase Dashboard (Authentication).',\n          'info',\n        );\n      }\n    } catch (error: unknown) {\n      // Catatan: Penggunaan 'as any' hanya pada error object di catch block, bukan pada payload/data. Sudah aman.\n      const errMsg = error instanceof Error ? error.message : String(error);\n      updateToast(toastId, `Gagal menyimpan: ${errMsg}`, 'error');\n    } finally {\n      setIsSavingUser(false);\n    }\n  };\n\n  const confirmToggleStatus = async () => {\n    if (userToToggleStatus) {\n      const toastId = addToast(\n        `${userToToggleStatus.isActive ? 'Menonaktifkan' : 'Mengaktifkan'} pengguna...`,\n        'info',\n      );\n      setIsSavingUser(true);\n      try {\n        const newStatus = !userToToggleStatus.isActive;\n        await updateUser(userToToggleStatus.id, { isActive: newStatus });\n        addAuditLog(\n          `Mengubah status pengguna \"${userToToggleStatus.name}\" menjadi ${newStatus ? 'Aktif' : 'Tidak Aktif'}.`,\n        );\n        updateToast(\n          toastId,\n          `Status pengguna ${userToToggleStatus.name} diubah menjadi ${newStatus ? 'Aktif' : 'Tidak Aktif'}.`,\n          'success',\n        );\n      } catch (error: unknown) {\n        // Catatan: Penggunaan 'unknown' pada error object di catch block, bukan pada payload/data. Sudah aman.\n        const errMsg = error instanceof Error ? error.message : String(error);\n        updateToast(toastId, `Gagal mengubah status: ${errMsg}`, 'error');\n      } finally {\n        setUserToToggleStatus(null);\n        setIsSavingUser(false);\n      }\n    }\n  };\n  const usersWithStore = useMemo(\n    () =>\n      users.map((user) => ({\n        ...user,\n        storeName: stores.find((s) => s.id === user.storeId)?.name || 'N/A',\n      })),\n    [users, stores],\n  );\n\n  type UserWithStore = (typeof usersWithStore)[0];\n\n  const filteredUsers = useMemo(() => {\n    let filtered = usersWithStore.filter((user) =>\n      user.name.toLowerCase().includes(searchTerm.toLowerCase()),\n    );\n\n    if (roleFilter === 'superadmin') {\n      filtered = filtered.filter((user) => user.role === UserRole.SuperAdmin);\n    } else if (roleFilter === 'admin') {\n      filtered = filtered.filter((user) => user.role === UserRole.Admin);\n    } else if (roleFilter === 'kasir') {\n      filtered = filtered.filter((user) => user.role === UserRole.Cashier);\n    } else if (roleFilter === 'active') {\n      filtered = filtered.filter((user) => user.isActive === true);\n    } else if (roleFilter === 'inactive') {\n      filtered = filtered.filter((user) => user.isActive === false);\n    }\n\n    return filtered;\n  }, [usersWithStore, searchTerm, roleFilter]);\n\n  const {\n    items: sortedUsers,\n    requestSort,\n    sortConfig,\n  } = useSortableData<UserWithStore>(filteredUsers);\n\n  const getSortIcon = (key: keyof UserWithStore) => {\n    if (!sortConfig || sortConfig.key !== key) return null;\n    if (sortConfig.direction === 'ascending')\n      return <ArrowUpIcon className=\"w-4 h-4 inline ml-1\" />;\n    return <ArrowDownIcon className=\"w-4 h-4 inline ml-1\" />;\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col sm:flex-row justify-between gap-4\">\n        <h1 className=\"text-2xl font-bold text-slate-900 dark:text-white\">Manajemen Pengguna</h1>\n        <button\n          onClick={handleAddUser}\n          className=\"px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700\"\n        >\n          Tambah Pengguna\n        </button>\n      </div>\n\n      <div className=\"flex flex-col sm:flex-row gap-4\">\n        <div className=\"relative flex-1\">\n          <SearchIcon className=\"absolute left-3 top-3 w-5 h-5 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Cari pengguna...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"w-full pl-10 p-2 rounded-lg border dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n          />\n        </div>\n        <select\n          value={roleFilter}\n          onChange={(e) => setRoleFilter(e.target.value as typeof roleFilter)}\n          className=\"w-full sm:w-48 p-2 rounded-lg border dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n        >\n          <option value=\"all\">Semua Pengguna</option>\n          <option value=\"superadmin\">Super Admin</option>\n          <option value=\"admin\">Admin</option>\n          <option value=\"kasir\">Kasir</option>\n          <option value=\"active\">Aktif</option>\n          <option value=\"inactive\">Tidak Aktif</option>\n        </select>\n      </div>\n\n      <div className=\"bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm border dark:border-slate-700\">\n        {/* Desktop Table View */}\n        <div className=\"overflow-x-auto hidden md:block\">\n          <table className=\"w-full text-base text-left text-slate-500 dark:text-slate-400\">\n            <thead className=\"text-sm text-slate-700 uppercase bg-slate-50 dark:bg-slate-700 dark:text-slate-400\">\n              <tr>\n                <th className=\"px-6 py-3\">\n                  <button\n                    onClick={() => requestSort('name')}\n                    className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                  >\n                    Nama {getSortIcon('name')}\n                  </button>\n                </th>\n                <th className=\"px-6 py-3\">\n                  <button\n                    onClick={() => requestSort('role')}\n                    className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                  >\n                    Peran {getSortIcon('role')}\n                  </button>\n                </th>\n                {currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' && (\n                  <th className=\"px-6 py-3\">\n                    <button\n                      onClick={() => requestSort('storeName')}\n                      className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                    >\n                      Cabang {getSortIcon('storeName')}\n                    </button>\n                  </th>\n                )}\n                <th className=\"px-6 py-3\">\n                  <button\n                    onClick={() => requestSort('isActive')}\n                    className=\"flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-200\"\n                  >\n                    Status {getSortIcon('isActive')}\n                  </button>\n                </th>\n                <th className=\"px-6 py-3\">Aksi</th>\n              </tr>\n            </thead>\n            <tbody>\n              {sortedUsers.length > 0 ? (\n                sortedUsers.map((user) => {\n                  const isSuperAdmin = user.role === UserRole.SuperAdmin;\n                  return (\n                    <tr key={user.id} className=\"border-b dark:border-slate-700\">\n                      <td className=\"px-6 py-4 font-medium text-slate-900 dark:text-white\">\n                        {user.name}\n                      </td>\n                      <td className=\"px-6 py-4\">{user.role}</td>\n                      {currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' && (\n                        <td className=\"px-6 py-4\">\n                          {user.role !== UserRole.SuperAdmin ? user.storeName : '-'}\n                        </td>\n                      )}\n                      <td className=\"px-6 py-4\">\n                        <span\n                          className={`px-2 py-1 text-sm font-medium rounded-full ${user.isActive ? 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300' : 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300'}`}\n                        >\n                          {user.isActive ? 'Aktif' : 'Tidak Aktif'}\n                        </span>\n                      </td>\n                      <td className=\"px-6 py-4\">\n                        <div className=\"flex items-center space-x-2\">\n                          <button\n                            onClick={() => handleOpenFormModal(user)}\n                            title=\"Edit\"\n                            className=\"p-2.5 rounded-md text-blue-600 hover:text-blue-900 dark:text-blue-500 dark:hover:text-blue-400 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                          >\n                            <EditIcon className=\"w-5 h-5\" />\n                          </button>\n                          <button\n                            onClick={() => handleToggleStatus(user)}\n                            title={\n                              isSuperAdmin\n                                ? 'Super Admin tidak bisa dinonaktifkan'\n                                : user.isActive\n                                  ? 'Nonaktifkan'\n                                  : 'Aktifkan'\n                            }\n                            disabled={isSuperAdmin}\n                            className={`p-2.5 rounded-md hover:bg-slate-100 dark:hover:bg-slate-700 ${user.isActive ? 'text-yellow-600 hover:text-yellow-900 dark:text-yellow-500 dark:hover:text-yellow-400' : 'text-green-600 hover:text-green-900 dark:text-green-500 dark:hover:text-green-400'} disabled:opacity-50 disabled:cursor-not-allowed`}\n                          >\n                            <PowerIcon className=\"w-5 h-5\" />\n                          </button>\n                        </div>\n                      </td>\n                    </tr>\n                  );\n                })\n              ) : (\n                <tr>\n                  <td\n                    colSpan={\n                      currentUser?.role === UserRole.SuperAdmin && selectedStoreId === 'all' ? 5 : 4\n                    }\n                  >\n                    <EmptyState\n                      icon={<UsersIcon className=\"mx-auto w-12 h-12 text-slate-400\" />}\n                      title={searchTerm ? 'Pengguna Tidak Ditemukan' : 'Belum Ada Pengguna'}\n                      description={\n                        searchTerm\n                          ? 'Coba kata kunci lain atau tambahkan pengguna baru.'\n                          : 'Mulai dengan menambahkan pengguna pertama Anda.'\n                      }\n                    />\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Mobile Card View */}\n        <div className=\"md:hidden space-y-4\">\n          {sortedUsers.length > 0 ? (\n            sortedUsers.map((user) => {\n              const isSuperAdmin = user.role === UserRole.SuperAdmin;\n              return (\n                <div\n                  key={user.id}\n                  className=\"bg-slate-50 dark:bg-slate-700/50 p-4 rounded-lg shadow-sm\"\n                >\n                  <div className=\"flex justify-between items-start\">\n                    <div>\n                      <p className=\"font-bold text-lg text-slate-800 dark:text-slate-200\">\n                        {user.name}\n                      </p>\n                      <p className=\"text-sm text-slate-500 dark:text-slate-400\">{user.role}</p>\n                      {currentUser?.role === UserRole.SuperAdmin &&\n                        selectedStoreId === 'all' &&\n                        user.role !== UserRole.SuperAdmin && (\n                          <p className=\"text-xs text-slate-400 dark:text-slate-500 mt-1\">\n                            {user.storeName}\n                          </p>\n                        )}\n                    </div>\n                    <span\n                      className={`px-2 py-0.5 text-xs font-medium rounded-full ${user.isActive ? 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300' : 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300'}`}\n                    >\n                      {user.isActive ? 'Aktif' : 'Tidak Aktif'}\n                    </span>\n                  </div>\n                  <div className=\"mt-3 flex items-center justify-end gap-2 border-t dark:border-slate-600 pt-2\">\n                    <button\n                      onClick={() => {\n                        setCurrentUserToEdit(user);\n                        setIsFormModalOpen(true);\n                      }}\n                      title=\"Edit\"\n                      className=\"p-2.5 rounded-md text-blue-600 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                    >\n                      <EditIcon className=\"w-5 h-5\" />\n                    </button>\n                    <button\n                      onClick={() => setUserToToggleStatus(user)}\n                      title={\n                        isSuperAdmin\n                          ? 'Super Admin tidak bisa dinonaktifkan'\n                          : user.isActive\n                            ? 'Nonaktifkan'\n                            : 'Aktifkan'\n                      }\n                      disabled={isSuperAdmin}\n                      className={`p-2.5 rounded-md ${user.isActive ? 'text-yellow-600' : 'text-green-600'} hover:bg-slate-100 dark:hover:bg-slate-700 disabled:opacity-50`}\n                    >\n                      <PowerIcon className=\"w-5 h-5\" />\n                    </button>\n                  </div>\n                </div>\n              );\n            })\n          ) : (\n            <EmptyState\n              icon={<UsersIcon className=\"mx-auto w-12 h-12 text-slate-400\" />}\n              title={searchTerm ? 'Pengguna Tidak Ditemukan' : 'Belum Ada Pengguna'}\n              description={\n                searchTerm\n                  ? 'Coba kata kunci lain atau tambahkan pengguna baru.'\n                  : 'Mulai dengan menambahkan pengguna pertama Anda.'\n              }\n            />\n          )}\n        </div>\n      </div>\n\n      {isFormModalOpen && (\n        <UserFormModal\n          user={currentUserToEdit}\n          onClose={handleCloseFormModal}\n          onSave={handleSaveUser}\n          stores={stores.filter((s) => s.isActive)}\n        />\n      )}\n\n      {userToToggleStatus && (\n        <ConfirmationModal\n          isOpen={true}\n          onClose={() => setUserToToggleStatus(null)}\n          onConfirm={confirmToggleStatus}\n          title={`${userToToggleStatus.isActive ? 'Nonaktifkan' : 'Aktifkan'} Pengguna`}\n          message={`Apakah Anda yakin ingin ${userToToggleStatus.isActive ? 'menonaktifkan' : 'mengaktifkan'} pengguna \"${userToToggleStatus.name}\"?`}\n          confirmText={userToToggleStatus.isActive ? 'Nonaktifkan' : 'Aktifkan'}\n          confirmColor={\n            userToToggleStatus.isActive\n              ? 'bg-yellow-500 hover:bg-yellow-600'\n              : 'bg-green-500 hover:bg-green-600'\n          }\n        />\n      )}\n    </div>\n  );\n};\n\nexport default UsersPage;\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\transactions\\NewTransactionPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'finalTotal' is assigned a value but never used.","line":492,"column":13,"nodeType":null,"messageId":"unusedVar","endLine":492,"endColumn":23}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// --- TAMBAHAN: Interface lokal untuk menangani P & L ---\ninterface ExtendedTransactionItem extends TransactionItem {\n  length?: number;\n  width?: number;\n}\nimport React, { useState, useMemo, useEffect, useCallback } from 'react';\nimport { useQuery, useQueryClient } from '@tanstack/react-query';\nimport { useNavigate } from 'react-router-dom';\nimport { generateUUID } from '../../utils';\nimport { supabase } from '../../utils/supabaseClient';\nimport { Trash2Icon, MessageSquareIcon, TagIcon, SpinnerIcon } from '../../components/icons';\nimport SuccessModal from '../../components/SuccessModal';\nimport { useSettings } from '../../contexts/SettingsContext';\nimport { useTransactions } from '../../contexts/TransactionContext';\nimport { fetchCustomers, useCustomerMutations } from '../../contexts/CustomerContext';\nimport { useServices } from '../../contexts/ServiceContext';\nimport ItemNotesModal from '../../components/ItemNotesModal';\nimport useAppContext from '../../contexts/useAppContext';\nimport { formatRupiah, parseRupiah, roundPrice } from '../../utils/formatting';\nimport CustomerSelector from '../../components/CustomerSelector';\nimport ServiceSelector from '../../components/ServiceSelector';\nimport CustomerFormModal from '../../components/CustomerFormModal';\nimport { useAuditLogs } from '../../contexts/AuditLogContext';\nimport useToasts from '../../contexts/useToasts';\n\nimport WhatsAppModal from '../../components/WhatsAppModal';\nimport KiloanTaggingModal from '../../components/KiloanTaggingModal';\nimport {\n  TransactionItem,\n  PaymentStatus,\n  OrderStatus,\n  Customer,\n  ServiceCategory,\n  UserRole,\n  PaymentMethod,\n  Transaction,\n  Service,\n} from '@/types';\n\nconst NewTransactionPage: React.FC = () => {\n  // --- SEMUA HOOK HARUS DI ATAS SINI ---\n  const navigate = useNavigate();\n  const { settings, isLoading: isLoadingSettings } = useSettings();\n  const { addTransaction } = useTransactions();\n  const queryClient = useQueryClient();\n  const { data: customersData } = useQuery({\n    queryKey: ['customers', { page: 1, pageSize: 1000 }],\n    queryFn: () => fetchCustomers({ page: 1, pageSize: 1000 }),\n    // PENTING: nonaktifkan auto-refetch saat user sedang input data\n    refetchOnWindowFocus: false,\n    staleTime: 10 * 60 * 1000, // 10 menit - data customer jarang berubah\n  });\n  const customers: Customer[] = Array.isArray(customersData)\n    ? customersData\n    : (customersData?.data ?? []);\n  const { addCustomer } = useCustomerMutations();\n  const { services } = useServices();\n  const { currentUser, selectedStoreId } = useAppContext();\n  const { addAuditLog } = useAuditLogs();\n  const { addToast, updateToast } = useToasts();\n  const [selectedCustomer, setSelectedCustomer] = useState<Customer | null>(null);\n  // Ganti tipe state items menjadi ExtendedTransactionItem[]\n  const [items, setItems] = useState<ExtendedTransactionItem[]>([]);\n  const [notes, setNotes] = useState('');\n  const [discountType, setDiscountType] = useState<'percent' | 'fixed'>('percent');\n  const [discountValue, setDiscountValue] = useState<number | ''>(0);\n  const [isCustomerModalOpen, setIsCustomerModalOpen] = useState(false);\n  const [isSuccessModalOpen, setIsSuccessModalOpen] = useState(false);\n  const [isNotesModalOpen, setIsNotesModalOpen] = useState(false);\n  const [editingNotes, setEditingNotes] = useState<{ note: string }[]>([]);\n  const [isKiloanTaggingModalOpen, setIsKiloanTaggingModalOpen] = useState(false);\n  const [editingItemIndex, setEditingItemIndex] = useState<number | null>(null);\n  const [isWhatsAppModalOpen, setIsWhatsAppModalOpen] = useState(false);\n  const [newlyCreatedTransaction, setNewlyCreatedTransaction] = useState<Transaction | null>(null);\n  const [isSaving, setIsSaving] = useState(false);\n  const [isPayingNow, setIsPayingNow] = useState(false);\n  const [paymentMethod, setPaymentMethod] = useState<PaymentMethod | undefined>(undefined);\n  const [tenderedAmountStr, setTenderedAmountStr] = useState('');\n  // State untuk idempotencyKey\n  const [idempotencyKey, setIdempotencyKey] = useState<string>(generateUUID());\n\n  // Semua useMemo, useEffect, useCallback juga di sini\n  const canEditDiscount = useMemo(() => {\n    if (!currentUser) return false;\n    if (currentUser.role === UserRole.SuperAdmin) return true;\n    return currentUser.canGiveDiscount === true;\n  }, [currentUser]);\n  const canApplyDiscount = useMemo(() => {\n    if (!currentUser) return false;\n    if (currentUser.role === UserRole.SuperAdmin) return true;\n    if (currentUser.role === UserRole.Admin || currentUser.role === UserRole.Cashier) {\n      if (currentUser.canGiveDiscount) return true;\n      if (\n        selectedCustomer &&\n        selectedCustomer.defaultDiscount &&\n        selectedCustomer.defaultDiscount > 0\n      )\n        return true;\n    }\n    return false;\n  }, [currentUser, selectedCustomer]);\n  // Semua hook turunannya juga harus dipanggil di level atas\n  // (dipindahkan dari bawah) agar Rules of Hooks tidak dilanggar.\n\n  const subtotal = useMemo(() => {\n    return items.reduce((sum, item) => sum + item.subtotal, 0);\n  }, [items]);\n\n  const discountAmount = useMemo(() => {\n    let val = 0;\n    let type = discountType;\n    if (!canApplyDiscount) {\n      // Pakai diskon dari pengaturan jika tidak boleh diskon\n      val = settings?.discountRate ?? 0;\n      type = 'percent';\n    } else {\n      // Ensure discountValue is a valid number\n      const parsedValue = Number(discountValue);\n      val = isNaN(parsedValue) ? 0 : Math.max(0, parsedValue);\n    }\n    let rawDiscount = 0;\n    if (type === 'percent') {\n      rawDiscount = subtotal * (val / 100);\n    } else {\n      rawDiscount = Math.min(val, subtotal);\n    }\n    return Math.round(rawDiscount);\n  }, [subtotal, discountValue, discountType, canApplyDiscount, settings?.discountRate]);\n\n  const taxAmount = useMemo(() => {\n    const taxableAmount = subtotal - discountAmount;\n    return Math.round(taxableAmount * ((settings?.taxRate ?? 0) / 100));\n  }, [subtotal, discountAmount, settings?.taxRate]);\n\n  const grandTotal = useMemo(() => {\n    return subtotal - discountAmount + taxAmount;\n  }, [subtotal, discountAmount, taxAmount]);\n\n  // --- TAMBAHAN LOGIKA PEMBULATAN ---\n  const finalTotalToPay = useMemo(() => {\n    // Pembulatan hanya berlaku jika Bayar Sekarang DAN Tunai\n    if (isPayingNow && paymentMethod === PaymentMethod.Cash) {\n      return roundPrice(grandTotal);\n    }\n    return grandTotal;\n  }, [grandTotal, isPayingNow, paymentMethod]);\n\n  const roundingDifference = useMemo(() => {\n    return grandTotal - finalTotalToPay;\n  }, [grandTotal, finalTotalToPay]);\n  // ----------------------------------\n\n  // GANTI baris ini:\n  // const amountToPay = grandTotal;\n  // MENJADI:\n  const amountToPay = finalTotalToPay;\n\n  // Place handleAddService after all hooks, before conditional rendering\n  const [showKiloanToast, setShowKiloanToast] = useState(false);\n  // --- MODIFIKASI: handleAddService ---\n  const handleAddService = useCallback((service: Service) => {\n    const isKiloan = service.category === ServiceCategory.Kiloan;\n    const isMeter = service.unit.toLowerCase() === 'm2' || service.unit.toLowerCase() === 'meter';\n    let shouldShowToast = false;\n    setItems((currentItems) => {\n      const existingItemIndex = currentItems.findIndex((item) => item.serviceId === service.id);\n      if (existingItemIndex > -1) {\n        if (isKiloan) {\n          shouldShowToast = true;\n          return currentItems;\n        }\n        const updatedItems = [...currentItems];\n        const currentItem = updatedItems[existingItemIndex];\n        currentItem.quantity += 1;\n        currentItem.subtotal = currentItem.price * currentItem.quantity;\n        // FIX: Sinkronkan itemDetails jika kategori Satuan\n        if (!isKiloan && !isMeter) {\n          const currentNotes = currentItem.itemDetails || [];\n          if (currentNotes.length < currentItem.quantity) {\n            currentItem.itemDetails = [...currentNotes, { note: '' }];\n          }\n        }\n        return updatedItems;\n      } else {\n        const newItem: ExtendedTransactionItem = {\n          serviceId: service.id,\n          serviceName: service.name,\n          price: service.price,\n          unit: service.unit,\n          quantity: 1,\n          subtotal: service.price * 1,\n          length: isMeter ? 1 : undefined,\n          width: isMeter ? 1 : undefined,\n          // Tambahkan itemDetails kosong jika Satuan\n          ...(!isKiloan && !isMeter ? { itemDetails: [{ note: '' }] } : {}),\n        };\n        return [...currentItems, newItem];\n      }\n    });\n    if (isKiloan) setShowKiloanToast(shouldShowToast);\n  }, []);\n\n  useEffect(() => {\n    if (showKiloanToast) {\n      addToast('Item kiloan sudah ada. Ubah beratnya di keranjang.', 'info');\n      setShowKiloanToast(false);\n    }\n  }, [showKiloanToast, addToast]);\n\n  // (Deklarasi duplikat finalTotalToPay, roundingDifference, amountToPay dihapus. Sudah ada di atas.)\n  const tenderedAmount = useMemo(() => parseRupiah(tenderedAmountStr), [tenderedAmountStr]);\n\n  const changeAmount = useMemo(() => {\n    if (!isPayingNow || paymentMethod !== PaymentMethod.Cash || tenderedAmount < amountToPay) {\n      return 0;\n    }\n    return tenderedAmount - amountToPay;\n  }, [isPayingNow, paymentMethod, tenderedAmount, amountToPay]);\n\n  const actualAmountPaid = useMemo(() => {\n    if (!isPayingNow) return 0;\n    return amountToPay; // Menggunakan nilai yang sudah dibulatkan\n  }, [isPayingNow, amountToPay]);\n\n  const paymentStatus = useMemo(() => {\n    if (!isPayingNow) return PaymentStatus.Unpaid;\n    if (grandTotal <= 0) return PaymentStatus.Paid;\n\n    // Toleransi untuk floating point arithmetic\n    const paid = actualAmountPaid;\n    const total = grandTotal;\n\n    if (Math.abs(paid - total) < 0.01) return PaymentStatus.Paid;\n    if (paid >= total) return PaymentStatus.Paid;\n    if (paid > 0) return PaymentStatus.Unpaid; // Partial payment still counts as Unpaid\n\n    return PaymentStatus.Unpaid;\n  }, [isPayingNow, grandTotal, actualAmountPaid]);\n\n  const currentStoreId = useMemo(() => {\n    return currentUser && currentUser.role === UserRole.SuperAdmin\n      ? selectedStoreId\n      : currentUser?.storeId;\n  }, [currentUser, selectedStoreId]);\n\n  // --- PERBAIKAN 1: Logika useEffect Diskon ---\n  // Catatan: Dependensi useEffect ini sudah aman, logika hanya berjalan saat selectedCustomer atau setting diskon berubah.\n  useEffect(() => {\n    if (!canApplyDiscount) {\n      setDiscountType('percent');\n      setDiscountValue(settings?.discountRate ?? 0);\n    } else if (\n      selectedCustomer &&\n      selectedCustomer.defaultDiscount &&\n      selectedCustomer.defaultDiscount > 0\n    ) {\n      setDiscountType('percent');\n      setDiscountValue(selectedCustomer.defaultDiscount);\n    } else {\n      setDiscountType('percent');\n      setDiscountValue(settings?.discountRate ?? 0);\n    }\n  }, [canApplyDiscount, selectedCustomer, settings?.discountRate]);\n\n  // --- LOGIKA KONDISIONAL DIMULAI DI SINI ---\n  // Show error toast if settings failed to load\n  useEffect(() => {\n    if (!settings && !isLoadingSettings) {\n      addToast(\n        'Tidak dapat memuat data pajak, diskon, dan lainnya. Pastikan Anda memiliki koneksi dan hak akses yang benar untuk melihat tabel settings.',\n        'error',\n      );\n    }\n  }, [settings, isLoadingSettings, addToast]);\n\n  if (isLoadingSettings) {\n    return (\n      <div className=\"flex justify-center items-center w-full h-96\">\n        <SpinnerIcon className=\"w-16 h-16\" />\n        <span className=\"sr-only\">Memuat pengaturan...</span>\n      </div>\n    );\n  }\n\n  if (!settings) {\n    return (\n      <div className=\"bg-white dark:bg-slate-800 p-6 rounded-lg shadow-md text-center\">\n        <h2 className=\"text-2xl font-semibold text-red-600 dark:text-red-400 mb-4\">\n          Gagal Memuat Pengaturan Aplikasi\n        </h2>\n        <p className=\"text-lg text-slate-700 dark:text-slate-300\">\n          Tidak dapat memuat data pajak, diskon, dan lainnya. Pastikan Anda memiliki koneksi dan hak\n          akses yang benar untuk melihat tabel 'settings'.\n        </p>\n      </div>\n    );\n  }\n\n  // --- MODIFIKASI: handleItemChange ---\n  const handleItemChange = (\n    index: number,\n    field: 'quantity' | 'taggedItems' | 'itemDetails' | 'length' | 'width',\n    value: number | string | Array<{ note: string }>,\n  ) => {\n    const newItems = [...items];\n    const item = newItems[index];\n    const service = services.find((s) => s.id === item.serviceId);\n\n    if ((field === 'length' || field === 'width') && typeof value === 'number') {\n      const val = value >= 0 ? value : 0;\n      if (field === 'length') item.length = val;\n      if (field === 'width') item.width = val;\n      const l = item.length || 0;\n      const w = item.width || 0;\n      // FIXED: Prevent submitting with zero area\n      const area = l > 0 && w > 0 ? parseFloat((l * w).toFixed(2)) : 0;\n      item.quantity = area;\n      item.subtotal = item.price * item.quantity;\n    } else if (field === 'quantity' && typeof value === 'number') {\n      const newQuantity = value >= 0 ? value : 0;\n      item.quantity = newQuantity;\n      const price = typeof item.price === 'number' ? item.price : Number(item.price) || 0;\n      item.subtotal = price * item.quantity;\n      if (service && service.category === ServiceCategory.Satuan) {\n        const currentNotes = item.itemDetails || [];\n        if (currentNotes.length < newQuantity) {\n          const newNotes = [\n            ...currentNotes,\n            ...Array.from({ length: newQuantity - currentNotes.length }, () => ({ note: '' })),\n          ];\n          item.itemDetails = newNotes;\n        } else {\n          item.itemDetails = currentNotes;\n        }\n      }\n    } else if (field === 'taggedItems' && typeof value === 'string') {\n      item.taggedItems = value;\n    } else if (field === 'itemDetails' && Array.isArray(value)) {\n      item.itemDetails = value as { note: string }[];\n    }\n    setItems(newItems);\n  };\n\n  const handleOpenNotesModal = (index: number) => {\n    setEditingItemIndex(index);\n    const item = items[index];\n    const allNotes = item?.itemDetails || [];\n    const initialNotes = Array.from(\n      { length: item.quantity },\n      (_, i) => allNotes[i] || { note: '' },\n    );\n    setEditingNotes(initialNotes);\n    setIsNotesModalOpen(true);\n  };\n\n  const handleOpenKiloanTaggingModal = (index: number) => {\n    setEditingItemIndex(index);\n    setIsKiloanTaggingModalOpen(true);\n  };\n\n  const handleSaveNotes = (notes: { note: string }[]) => {\n    if (editingItemIndex !== null) {\n      handleItemChange(editingItemIndex, 'itemDetails', notes);\n    }\n    setEditingItemIndex(null);\n    setIsNotesModalOpen(false);\n    setEditingNotes([]);\n  };\n\n  const handleSaveKiloanTags = (tags: string) => {\n    if (editingItemIndex !== null) {\n      handleItemChange(editingItemIndex, 'taggedItems', tags);\n    }\n    setEditingItemIndex(null);\n    setIsKiloanTaggingModalOpen(false);\n  };\n\n  const handleRemoveItem = (index: number) => {\n    setItems(items.filter((_, i) => i !== index));\n  };\n\n  const handleSaveCustomer = async (customer: Omit<Customer, 'id' | 'storeId'>) => {\n    if (!currentStoreId || currentStoreId === 'all') {\n      addToast('Silakan pilih cabang spesifik untuk menambah pelanggan.', 'warning');\n      return;\n    }\n    const toastId = addToast('Menambah pelanggan...', 'info');\n    try {\n      const newCustomer = await addCustomer({ ...customer, storeId: currentStoreId });\n      if (newCustomer) {\n        // Map Supabase customer (nullable fields) to app Customer type\n        setSelectedCustomer({\n          id: newCustomer.id,\n          name: newCustomer.name,\n          phone: newCustomer.phone ?? '',\n          address: newCustomer.address ?? '',\n          notes: newCustomer.notes ?? '',\n          storeId: newCustomer.storeId ?? '',\n          defaultDiscount: newCustomer.defaultDiscount ?? 0,\n          createdAt: newCustomer.createdAt ? new Date(newCustomer.createdAt) : new Date(),\n        });\n        setIsCustomerModalOpen(false);\n        updateToast(toastId, 'Pelanggan berhasil ditambahkan!', 'success');\n      } else {\n        updateToast(toastId, 'Gagal menambah pelanggan: Data tidak valid.', 'error');\n      }\n    } catch (error: unknown) {\n      let msg = 'Unknown error';\n      if (\n        error &&\n        typeof error === 'object' &&\n        'message' in error &&\n        typeof (error as { message?: string }).message === 'string'\n      ) {\n        msg = (error as { message: string }).message;\n      }\n      updateToast(toastId, `Gagal menambah pelanggan: ${msg}`, 'error');\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (isSaving) {\n      addToast('Transaksi sedang disimpan, mohon tunggu...', 'warning');\n      return;\n    }\n\n    if (!currentStoreId || currentStoreId === 'all') {\n      const msg =\n        currentUser?.role === UserRole.SuperAdmin\n          ? 'Super Admin harus memilih cabang spesifik.'\n          : 'Data cabang Anda tidak valid. Silakan relogin.';\n      addToast(msg, 'warning');\n      return;\n    }\n    if (!selectedCustomer) {\n      addToast('Pelanggan harus dipilih.', 'warning');\n      return;\n    }\n    if (items.length === 0) {\n      addToast('Minimal satu layanan harus ditambahkan.', 'warning');\n      return;\n    }\n\n    // Prevent double submission\n    setIsSaving(true);\n\n    if (isPayingNow) {\n      if (!paymentMethod) {\n        addToast('Pilih metode pembayaran.', 'error');\n        setIsSaving(false);\n        return;\n      }\n      if (paymentMethod === PaymentMethod.Cash && tenderedAmount < grandTotal) {\n        addToast('Jumlah uang diterima tidak boleh kurang dari total tagihan.', 'error');\n        setIsSaving(false);\n        return;\n      }\n    }\n\n    const toastId = addToast('Menyimpan transaksi ke database...', 'info');\n    try {\n      // --- PERBAIKAN: Hitung waktu saat tombol ditekan ---\n      const now = new Date(); // Waktu Masuk (Real-time)\n\n      // Hitung Estimasi Selesai berdasarkan item yang dipilih\n      let maxDurationDays = 0;\n      if (items.length === 0) {\n        maxDurationDays = 1; // Default 1 hari jika tidak ada item\n      } else {\n        maxDurationDays = Math.max(\n          ...items.map((item) => {\n            const service = services.find((s) => s.id === item.serviceId);\n            return service && service.durationDays ? service.durationDays : 0;\n          }),\n        );\n      }\n      const completionDate = new Date(now);\n      completionDate.setDate(completionDate.getDate() + maxDurationDays);\n      // ---------------------------------------------------\n\n      // Sanitasi itemDetails agar tidak ada zombie notes\n      const cleanedItems = items.map((item) => ({\n        ...item,\n        itemDetails: item.itemDetails\n          ? item.itemDetails.slice(0, item.quantity).map((detail) => ({ note: detail.note || '' }))\n          : [],\n      }));\n      // Hitung total diskon akhir (diskon manual + diskon pembulatan)\n      const finalDiscount = discountAmount + roundingDifference;\n      // Pastikan total yang disimpan ke database adalah total setelah pembulatan\n      const finalTotal = grandTotal - roundingDifference;\n\n      const newTransaction: Omit<Transaction, 'id'> = {\n        customerId: selectedCustomer.id,\n        items: cleanedItems,\n        subtotal,\n        discount: finalDiscount,\n        tax: taxAmount,\n        total: subtotal - finalDiscount + taxAmount, // FIXED: Calculate total consistently with displayed grandTotal\n        paymentStatus,\n        orderStatus: OrderStatus.Processing,\n        // --- UPDATE: Gunakan variabel waktu yang baru dihitung ---\n        createdAt: now,\n        estimatedCompletionDate: completionDate.toISOString(),\n        // --------------------------------------------------------\n        notes,\n        amountPaid: actualAmountPaid,\n        change: changeAmount,\n        paymentMethod: isPayingNow && actualAmountPaid > 0 ? paymentMethod : undefined,\n        createdByUserId: currentUser?.id ?? '',\n        storeId: currentStoreId,\n        idempotencyKey: idempotencyKey,\n      };\n      const savedTransaction = await addTransaction(newTransaction);\n\n      // Update toast untuk verifikasi\n      updateToast(toastId, 'Memverifikasi data tersimpan...', 'info');\n\n      if (savedTransaction) {\n        // Map Supabase transaction (JSON fields, dates) to app Transaction type\n        const tx: Transaction = {\n          ...savedTransaction,\n          customerId: savedTransaction.customerId ?? '',\n          createdByUserId: savedTransaction.createdByUserId ?? '',\n          storeId: savedTransaction.storeId ?? '',\n          notes: savedTransaction.notes ?? undefined,\n          idempotencyKey: savedTransaction.idempotencyKey ?? undefined,\n          items: Array.isArray(savedTransaction.items)\n            ? (savedTransaction.items as unknown as import('../../types').TransactionItem[]).map(\n                (item) => ({\n                  ...item,\n                  itemDetails: item.itemDetails ?? [],\n                }),\n              )\n            : [],\n          createdAt: savedTransaction.createdAt ? new Date(savedTransaction.createdAt) : new Date(),\n          estimatedCompletionDate: savedTransaction.estimatedCompletionDate ?? '',\n          invoiceCode: savedTransaction.invoice_code ?? undefined,\n          paymentStatus: savedTransaction.paymentStatus as PaymentStatus,\n          orderStatus: savedTransaction.orderStatus as OrderStatus,\n          paymentMethod: savedTransaction.paymentMethod\n            ? (savedTransaction.paymentMethod as PaymentMethod)\n            : undefined,\n        };\n        addAuditLog(\n          `Membuat transaksi baru untuk pelanggan ${selectedCustomer.name}.`,\n          currentStoreId,\n        );\n        await queryClient.invalidateQueries({ queryKey: ['transaction', tx.id] });\n        setNewlyCreatedTransaction(tx);\n        setIsWhatsAppModalOpen(true);\n        updateToast(toastId, 'Γ£ô Transaksi berhasil disimpan dan terverifikasi.', 'success');\n      } else {\n        throw new Error('Tidak ada data yang dikembalikan dari server');\n      }\n    } catch (error: unknown) {\n      // Tangani error duplikat idempotencyKey\n      if (\n        error &&\n        typeof error === 'object' &&\n        'code' in error &&\n        (error as { code?: string }).code === '23505' &&\n        'message' in error &&\n        typeof (error as { message?: string }).message === 'string' &&\n        (error as { message: string }).message.includes('idempotencyKey')\n      ) {\n        // Fetch ulang transaksi existing berdasarkan idempotencyKey\n        const { data: existingTx } = await supabase\n          .from('transactions')\n          .select('*')\n          .eq('idempotencyKey', idempotencyKey)\n          .single();\n        if (existingTx) {\n          // Map Supabase transaction (JSON fields, dates) to app Transaction type\n          const tx: Transaction = {\n            ...existingTx,\n            customerId: existingTx.customerId ?? '',\n            createdByUserId: existingTx.createdByUserId ?? '',\n            storeId: existingTx.storeId ?? '',\n            notes: existingTx.notes ?? undefined,\n            idempotencyKey: existingTx.idempotencyKey ?? undefined,\n            items: Array.isArray(existingTx.items)\n              ? (existingTx.items as unknown as import('../../types').TransactionItem[]).map(\n                  (item) => ({\n                    ...item,\n                    itemDetails: item.itemDetails ?? [],\n                  }),\n                )\n              : [],\n            createdAt: existingTx.createdAt ? new Date(existingTx.createdAt) : new Date(),\n            estimatedCompletionDate: existingTx.estimatedCompletionDate ?? '',\n            invoiceCode: existingTx.invoice_code ?? undefined,\n            paymentStatus: existingTx.paymentStatus as PaymentStatus,\n            orderStatus: existingTx.orderStatus as OrderStatus,\n            paymentMethod: existingTx.paymentMethod\n              ? (existingTx.paymentMethod as PaymentMethod)\n              : undefined,\n          };\n          setNewlyCreatedTransaction(tx);\n          setIsWhatsAppModalOpen(true);\n        }\n        updateToast(toastId, 'Transaksi berhasil disimpan (terdeteksi duplikat).', 'success');\n        // setIsSuccessModalOpen(true); // Tetap biarkan di handleCloseWhatsAppModal\n      } else {\n        let msg = 'Unknown error';\n        if (\n          error &&\n          typeof error === 'object' &&\n          'message' in error &&\n          typeof (error as { message?: string }).message === 'string'\n        ) {\n          msg = (error as { message: string }).message;\n        }\n        updateToast(toastId, `Gagal menyimpan transaksi: ${msg}`, 'error');\n      }\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  const handleCloseWhatsAppModal = () => {\n    setIsWhatsAppModalOpen(false);\n    setIsSuccessModalOpen(true);\n  };\n\n  // --- PERBAIKAN 2: Logika Reset Diskon ---\n  const handleNewTransaction = () => {\n    // Reset all transaction-related state\n    setSelectedCustomer(null);\n    setItems([]);\n    setNotes('');\n    setDiscountType('percent');\n    setDiscountValue(settings?.discountRate ?? 0);\n    setIsCustomerModalOpen(false);\n    setIsSuccessModalOpen(false);\n    setIsNotesModalOpen(false);\n    setIsKiloanTaggingModalOpen(false);\n    setEditingItemIndex(null);\n    setIsWhatsAppModalOpen(false);\n    setNewlyCreatedTransaction(null);\n    setIsSaving(false);\n    setIsPayingNow(false);\n    setPaymentMethod(undefined);\n    setTenderedAmountStr('');\n    setIdempotencyKey(generateUUID()); // Generate kunci baru untuk transaksi berikutnya\n  };\n\n  const handleViewTransactions = () => {\n    setIsSuccessModalOpen(false);\n    navigate('/transactions');\n  };\n\n  const handleDiscountTypeChange = (type: 'percent' | 'fixed') => {\n    setDiscountType(type);\n    setDiscountValue(0);\n  };\n\n  const handlePaymentOptionChange = (paying: boolean) => {\n    setIsPayingNow(paying);\n    if (!paying) {\n      setPaymentMethod(undefined);\n      setTenderedAmountStr('');\n    }\n  };\n\n  return (\n    <>\n      <form onSubmit={handleSubmit} className=\"space-y-6\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          <div className=\"lg:col-span-2 space-y-6\">\n            <div className=\"bg-white dark:bg-slate-800 p-6 rounded-lg shadow-md\">\n              <h2 className=\"text-2xl font-semibold text-slate-900 dark:text-white mb-4\">\n                Pilih Layanan\n              </h2>\n              <ServiceSelector services={services} onAddService={handleAddService} />\n            </div>\n\n            <div className=\"bg-white dark:bg-slate-800 p-6 rounded-lg shadow-md\">\n              <h2 className=\"text-2xl font-semibold mb-4 text-slate-900 dark:text-white\">\n                Item Transaksi\n              </h2>\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full text-lg text-left text-slate-500 dark:text-slate-400\">\n                  <thead className=\"text-sm text-slate-700 uppercase bg-slate-50 dark:bg-slate-700 dark:text-slate-400\">\n                    <tr>\n                      <th className=\"px-4 py-3\">Layanan</th>\n                      <th className=\"px-4 py-3\">Jumlah</th>\n                      <th className=\"px-4 py-3 text-center\">Aksi</th>\n                      <th className=\"px-4 py-3 text-right\">Subtotal</th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    {items.length > 0 ? (\n                      items.map((item, index) => {\n                        const service = services.find((s) => s.id === item.serviceId);\n                        const isSatuan = service?.category === ServiceCategory.Satuan;\n                        const isKiloan = service?.category === ServiceCategory.Kiloan;\n\n                        return (\n                          <tr key={index} className=\"border-b dark:border-slate-700\">\n                            <td className=\"px-4 py-2 font-medium text-slate-900 dark:text-white\">\n                              {item.serviceName}\n                            </td>\n                            <td className=\"px-4 py-2 w-48\">\n                              {item.unit.toLowerCase() === 'm2' ||\n                              item.unit.toLowerCase() === 'meter' ? (\n                                <div className=\"flex flex-col gap-2\">\n                                  <div className=\"flex items-center gap-2\">\n                                    <span className=\"text-xs font-bold text-slate-500 w-4\">P:</span>\n                                    <input\n                                      type=\"number\"\n                                      min=\"0\"\n                                      step=\"0.1\"\n                                      placeholder=\"P\"\n                                      value={item.length}\n                                      onChange={(e) =>\n                                        handleItemChange(\n                                          index,\n                                          'length',\n                                          parseFloat(e.target.value) || 0,\n                                        )\n                                      }\n                                      className=\"w-20 bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg p-2 dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n                                    />\n                                    <span className=\"text-sm text-slate-500\">m</span>\n                                  </div>\n                                  <div className=\"flex items-center gap-2\">\n                                    <span className=\"text-xs font-bold text-slate-500 w-4\">L:</span>\n                                    <input\n                                      type=\"number\"\n                                      min=\"0\"\n                                      step=\"0.1\"\n                                      placeholder=\"L\"\n                                      value={item.width}\n                                      onChange={(e) =>\n                                        handleItemChange(\n                                          index,\n                                          'width',\n                                          parseFloat(e.target.value) || 0,\n                                        )\n                                      }\n                                      className=\"w-20 bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg p-2 dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n                                    />\n                                    <span className=\"text-sm text-slate-500\">m</span>\n                                  </div>\n                                  <div className=\"text-sm font-bold text-blue-600 mt-1\">\n                                    = {item.quantity} {item.unit}\n                                  </div>\n                                </div>\n                              ) : (\n                                <div className=\"flex items-center\">\n                                  <input\n                                    type=\"number\"\n                                    min=\"0\"\n                                    step={item.unit === 'kg' ? '0.01' : '1'}\n                                    value={item.quantity}\n                                    onChange={(e) =>\n                                      handleItemChange(\n                                        index,\n                                        'quantity',\n                                        parseFloat(e.target.value) || 0,\n                                      )\n                                    }\n                                    className=\"w-24 bg-slate-50 border border-slate-300 text-slate-900 text-lg rounded-lg p-2.5 dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n                                  />\n                                  <span className=\"ml-2 text-base text-slate-500 dark:text-slate-400\">\n                                    {item.unit}\n                                  </span>\n                                </div>\n                              )}\n                            </td>\n                            <td className=\"px-4 py-2 text-center\">\n                              <div className=\"flex items-center justify-center\">\n                                {isSatuan && (\n                                  <button\n                                    type=\"button\"\n                                    onClick={() => handleOpenNotesModal(index)}\n                                    title=\"Catatan per Item\"\n                                    className=\"p-2 text-blue-600 hover:text-blue-900 relative rounded-md hover:bg-slate-100 dark:hover:bg-slate-700\"\n                                  >\n                                    <MessageSquareIcon className=\"w-6 h-6\" />\n                                    {item.itemDetails\n                                      ?.slice(0, item.quantity)\n                                      .some((d) => d.note) && (\n                                      <span className=\"absolute top-1 right-1 block h-2.5 w-2.5 rounded-full bg-green-500 ring-2 ring-white dark:ring-slate-800\"></span>\n                                    )}\n                                  </button>\n                                )}\n                                {isKiloan && (\n                                  <button\n                                    type=\"button\"\n                                    onClick={() => handleOpenKiloanTaggingModal(index)}\n                                    title=\"Tag Item Kiloan\"\n                                    className=\"p-2 text-purple-600 hover:text-purple-900 relative rounded-md hover:bg-slate-100 dark:hover:bg-slate-700\"\n                                  >\n                                    <TagIcon className=\"w-6 h-6\" />\n                                    {item.taggedItems && (\n                                      <span className=\"absolute top-1 right-1 block h-2.5 w-2.5 rounded-full bg-green-500 ring-2 ring-white dark:ring-slate-800\"></span>\n                                    )}\n                                  </button>\n                                )}\n                                <button\n                                  type=\"button\"\n                                  onClick={() => handleRemoveItem(index)}\n                                  title=\"Hapus Item\"\n                                  className=\"p-2 text-red-600 hover:text-red-900 rounded-md hover:bg-slate-100 dark:hover:bg-slate-700\"\n                                >\n                                  <Trash2Icon className=\"w-6 h-6\" />\n                                </button>\n                              </div>\n                            </td>\n                            <td className=\"px-4 py-2 text-right\">\n                              Rp {item.subtotal.toLocaleString('id-ID')}\n                            </td>\n                          </tr>\n                        );\n                      })\n                    ) : (\n                      <tr>\n                        <td\n                          colSpan={4}\n                          className=\"text-center py-4 text-slate-500 dark:text-slate-400\"\n                        >\n                          Belum ada layanan yang ditambahkan.\n                        </td>\n                      </tr>\n                    )}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"lg:col-span-1 space-y-6\">\n            <div className=\"bg-white dark:bg-slate-800 p-6 rounded-lg shadow-md sticky top-24 overflow-visible\">\n              <h2 className=\"text-2xl font-semibold mb-4 text-slate-900 dark:text-white\">\n                Detail & Total\n              </h2>\n              <div className=\"space-y-4\">\n                <CustomerSelector\n                  customers={customers}\n                  selectedCustomer={selectedCustomer}\n                  onSelectCustomer={setSelectedCustomer}\n                  onAddNewCustomer={() => setIsCustomerModalOpen(true)}\n                />\n                {/* Banner info diskon otomatis */}\n                {selectedCustomer &&\n                  selectedCustomer.defaultDiscount &&\n                  selectedCustomer.defaultDiscount > 0 && (\n                    <div className=\"mb-4 p-3 rounded-lg bg-blue-50 border border-blue-200 text-blue-800 text-base font-medium flex items-center\">\n                      <TagIcon className=\"w-5 h-5 mr-2 text-blue-400\" />\n                      Diskon {selectedCustomer.defaultDiscount}% otomatis diterapkan untuk{' '}\n                      {selectedCustomer.name}.\n                    </div>\n                  )}\n                <div>\n                  <label\n                    htmlFor=\"notes\"\n                    className=\"block mb-2 text-base font-medium text-slate-900 dark:text-white\"\n                  >\n                    Catatan (Opsional)\n                  </label>\n                  <textarea\n                    id=\"notes\"\n                    value={notes}\n                    onChange={(e) => setNotes(e.target.value)}\n                    rows={2}\n                    className=\"bg-slate-50 border border-slate-300 text-slate-900 text-base rounded-lg block w-full p-3 dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n                  ></textarea>\n                </div>\n                <div className=\"space-y-3 pt-4 border-t dark:border-slate-700\">\n                  <div className=\"flex justify-between items-center text-lg\">\n                    <span className=\"text-slate-600 dark:text-slate-300\">Subtotal:</span>\n                    <span className=\"font-medium text-slate-800 dark:text-slate-200\">\n                      Rp {subtotal.toLocaleString('id-ID')}\n                    </span>\n                  </div>\n                  <div\n                    className={`flex justify-between items-center text-lg ${!canApplyDiscount ? 'opacity-50' : ''}`}\n                    title={\n                      !canApplyDiscount ? 'Anda tidak memiliki izin untuk memberikan diskon.' : ''\n                    }\n                  >\n                    <label htmlFor=\"discountValue\" className=\"text-slate-600 dark:text-slate-300\">\n                      Diskon:\n                    </label>\n                    <div className=\"flex items-center gap-2\">\n                      <div className=\"flex items-center bg-slate-100 dark:bg-slate-800 rounded-lg p-0.5\">\n                        <button\n                          type=\"button\"\n                          disabled={!canApplyDiscount}\n                          onClick={() => handleDiscountTypeChange('percent')}\n                          className={`px-2 py-1 text-sm rounded-md ${discountType === 'percent' ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow' : 'text-slate-600 dark:text-slate-300'}`}\n                        >\n                          %\n                        </button>\n                        <button\n                          type=\"button\"\n                          disabled={!canApplyDiscount}\n                          onClick={() => handleDiscountTypeChange('fixed')}\n                          className={`px-2 py-1 text-sm rounded-md ${discountType === 'fixed' ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow' : 'text-slate-600 dark:text-slate-300'}`}\n                        >\n                          Rp\n                        </button>\n                      </div>\n                      <input\n                        type=\"number\"\n                        id=\"discountValue\"\n                        min=\"0\"\n                        value={discountValue}\n                        onChange={(e) =>\n                          setDiscountValue(\n                            e.target.value === ''\n                              ? ''\n                              : Math.max(0, parseFloat(e.target.value) || 0),\n                          )\n                        }\n                        className=\"w-24 bg-slate-50 border border-slate-300 text-slate-900 text-lg rounded-lg p-1.5 text-right dark:bg-slate-700 dark:border-slate-600 dark:text-white disabled:bg-slate-200 dark:disabled:bg-slate-600\"\n                        disabled={!canEditDiscount}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"flex justify-between items-center text-lg\">\n                    <span />\n                    <span className=\"font-medium text-red-600 dark:text-red-400\">\n                      - Rp {discountAmount.toLocaleString('id-ID')}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between items-center text-lg\">\n                    <span className=\"text-slate-600 dark:text-slate-300\">\n                      Pajak ({settings.taxRate}%):\n                    </span>\n                    <span className=\"font-medium text-slate-800 dark:text-slate-200\">\n                      + Rp {taxAmount.toLocaleString('id-ID')}\n                    </span>\n                  </div>\n                  {/* Tambahkan blok ini di atas Grand Total */}\n                  {isPayingNow &&\n                    paymentMethod === PaymentMethod.Cash &&\n                    roundingDifference > 0 && (\n                      <div className=\"flex justify-between items-center text-lg text-slate-500 dark:text-slate-400 italic\">\n                        <span>Pembulatan:</span>\n                        <span>- Rp {formatRupiah(roundingDifference)}</span>\n                      </div>\n                    )}\n\n                  <div className=\"flex justify-between items-center text-2xl font-semibold text-slate-900 dark:text-white pt-3 border-t dark:border-slate-600\">\n                    <span>Grand Total:</span>\n                    <span>Rp {formatRupiah(amountToPay)}</span>\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"block mb-2 text-base font-medium text-slate-900 dark:text-white\">\n                    Opsi Pembayaran\n                  </label>\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => handlePaymentOptionChange(false)}\n                      className={`p-3 rounded-lg text-base border-2 ${!isPayingNow ? 'border-blue-600 bg-blue-50 dark:bg-blue-900/50' : 'border-slate-300 dark:border-slate-600'}`}\n                    >\n                      Bayar Nanti\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => handlePaymentOptionChange(true)}\n                      className={`p-3 rounded-lg text-base border-2 ${isPayingNow ? 'border-blue-600 bg-blue-50 dark:bg-blue-900/50' : 'border-slate-300 dark:border-slate-600'}`}\n                    >\n                      Bayar Sekarang\n                    </button>\n                  </div>\n                </div>\n\n                {isPayingNow && (\n                  <div className=\"border-t-2 border-dashed border-slate-300 dark:border-slate-600 pt-4 mt-4 space-y-4\">\n                    <h3 className=\"text-xl font-semibold text-slate-900 dark:text-white\">\n                      Pembayaran\n                    </h3>\n                    <div>\n                      <label className=\"block mb-2 text-base font-medium text-slate-900 dark:text-white\">\n                        Metode Pembayaran\n                      </label>\n                      <div className=\"grid grid-cols-2 gap-2\">\n                        {Object.values(PaymentMethod).map((m) => (\n                          <button\n                            type=\"button\"\n                            key={m}\n                            onClick={() => setPaymentMethod(m)}\n                            className={`p-3 rounded-lg text-base border-2 font-semibold transition-colors duration-200\n                              ${\n                                paymentMethod === m\n                                  ? 'border-blue-600 bg-blue-50 dark:bg-blue-900/50 text-slate-900 dark:text-white'\n                                  : 'border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800'\n                              }\n                            `}\n                          >\n                            {m}\n                          </button>\n                        ))}\n                      </div>\n                    </div>\n                    {paymentMethod === PaymentMethod.Cash && (\n                      <div>\n                        <label\n                          htmlFor=\"tenderedAmount\"\n                          className=\"block mb-2 text-base font-medium text-slate-900 dark:text-white\"\n                        >\n                          Uang Diterima (Rp)\n                        </label>\n                        <input\n                          type=\"text\"\n                          id=\"tenderedAmount\"\n                          value={tenderedAmountStr}\n                          onChange={(e) => {\n                            const val = parseRupiah(e.target.value);\n                            setTenderedAmountStr(val === 0 ? '' : formatRupiah(val));\n                          }}\n                          className=\"bg-slate-50 border border-slate-300 text-slate-900 text-lg rounded-lg block w-full p-3 dark:bg-slate-700 dark:border-slate-600 dark:text-white\"\n                          placeholder=\"0\"\n                          disabled={false}\n                        />\n                      </div>\n                    )}\n                    {changeAmount > 0 && (\n                      <div className=\"flex justify-between items-center text-lg\">\n                        <span className=\"text-slate-600 dark:text-slate-300\">Kembalian:</span>\n                        <span className=\"font-medium text-green-600 dark:text-green-400\">\n                          Rp {formatRupiah(changeAmount)}\n                        </span>\n                      </div>\n                    )}\n                  </div>\n                )}\n\n                <button\n                  type=\"submit\"\n                  disabled={\n                    isSaving ||\n                    (currentUser &&\n                      currentUser.role === UserRole.SuperAdmin &&\n                      selectedStoreId === 'all')\n                      ? true\n                      : undefined\n                  }\n                  className=\"w-full flex justify-center items-center text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-xl px-8 py-4 text-center transition-colors disabled:bg-blue-400 disabled:cursor-not-allowed\"\n                >\n                  {isSaving ? <SpinnerIcon className=\"w-7 h-7\" /> : 'Simpan Transaksi'}\n                </button>\n                {currentUser &&\n                  currentUser.role === UserRole.SuperAdmin &&\n                  selectedStoreId === 'all' && (\n                    <p className=\"text-center text-sm text-yellow-600 dark:text-yellow-400\">\n                      Pilih cabang spesifik di header untuk membuat transaksi.\n                    </p>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n        {isCustomerModalOpen && (\n          <CustomerFormModal\n            customer={null}\n            onClose={() => setIsCustomerModalOpen(false)}\n            onSave={handleSaveCustomer}\n          />\n        )}\n      </form>\n      <SuccessModal\n        isOpen={isSuccessModalOpen}\n        onClose={handleViewTransactions}\n        title=\"Transaksi Berhasil!\"\n        message={\n          newlyCreatedTransaction?.invoiceCode\n            ? `Transaksi (No. ${newlyCreatedTransaction.invoiceCode}) telah berhasil dibuat.`\n            : 'Transaksi baru telah berhasil dibuat.'\n        }\n        actions={[\n          { text: 'Buat Transaksi Baru Lagi', onClick: handleNewTransaction, type: 'primary' },\n          { text: 'Lihat Daftar Transaksi', onClick: handleViewTransactions, type: 'secondary' },\n        ]}\n      />\n      <ItemNotesModal\n        isOpen={isNotesModalOpen}\n        onClose={() => {\n          setIsNotesModalOpen(false);\n          setEditingNotes([]);\n        }}\n        item={editingItemIndex !== null ? items[editingItemIndex] : null!}\n        notes={editingNotes}\n        setNotes={setEditingNotes}\n        onSave={handleSaveNotes}\n      />\n      <KiloanTaggingModal\n        isOpen={isKiloanTaggingModalOpen}\n        onClose={() => setIsKiloanTaggingModalOpen(false)}\n        item={editingItemIndex !== null ? items[editingItemIndex] : null!}\n        onSave={handleSaveKiloanTags}\n      />\n      <WhatsAppModal\n        isOpen={isWhatsAppModalOpen}\n        onClose={handleCloseWhatsAppModal}\n        transaction={newlyCreatedTransaction}\n        customer={selectedCustomer}\n      />\n    </>\n  );\n};\n\nexport default NewTransactionPage;\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\pages\\transactions\\ReceiptPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":30,"column":70,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":30,"endColumn":73,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1301,1304],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1301,1304],"text":"never"},"desc":"Use `never` instead, this