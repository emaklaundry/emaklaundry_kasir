[{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\eslint.config.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\postcss.config.cjs","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\App.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'useToasts' is defined but never used.","line":4,"column":8,"nodeType":null,"messageId":"unusedVar","endLine":4,"endColumn":17}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { Suspense, lazy } from 'react';\nimport { BrowserRouter as Router, Routes, Route, Navigate } from 'react-router-dom';\nimport { registerSW } from 'virtual:pwa-register';\nimport useToasts from './contexts/useToasts';\nimport { UserRole } from './types';\nimport useAppContext from './contexts/useAppContext';\nimport Layout from './components/Layout';\nimport MaintenanceMode from './components/MaintenanceMode';\nimport { useSettings } from './contexts/SettingsContext';\n\nimport useTheme from './hooks/useTheme';\nimport { AppProviders } from './contexts/AppProviders';\nimport CommandPalette from './components/CommandPalette';\nimport QuickActionsPage from './pages/QuickActionsPage';\n\n// Lazy load pages for code splitting\nconst Dashboard = lazy(() => import('./pages/Dashboard'));\nconst TransactionPage = lazy(() => import('./pages/transactions/TransactionPage'));\nconst NewTransactionPage = lazy(() => import('./pages/transactions/NewTransactionPage'));\nconst ServicesPage = lazy(() => import('./pages/management/ServicesPage'));\nconst InventoryPage = lazy(() => import('./pages/management/InventoryPage'));\nconst AssetsPage = lazy(() => import('./pages/management/AssetsPage'));\nconst ExpensesPage = lazy(() => import('./pages/management/ExpensesPage'));\nconst UsersPage = lazy(() => import('./pages/management/UsersPage'));\nconst ReportsPage = lazy(() => import('./pages/ReportsPage'));\nconst AuditLogPage = lazy(() => import('./pages/AuditLogPage'));\nconst SettingsPage = lazy(() => import('./pages/management/SettingsPage'));\nconst CustomersPage = lazy(() => import('./pages/management/CustomersPage'));\nconst CustomerDetailPage = lazy(() => import('./pages/management/CustomerDetailPage'));\nconst ReceiptPage = lazy(() => import('./pages/transactions/ReceiptPage'));\nconst TransactionDetailPage = lazy(() => import('./pages/transactions/TransactionDetailPage'));\nconst StoresPage = lazy(() => import('./pages/management/StoresPage'));\n\nconst AdminRoute: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const { currentUser } = useAppContext();\n  if (!currentUser) return <Navigate to=\"/login\" />;\n  const isAdmin = currentUser.role === UserRole.SuperAdmin || currentUser.role === UserRole.Admin;\n  return isAdmin ? <>{children}</> : <Navigate to=\"/\" />;\n};\n\nconst SuperAdminRoute: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const { currentUser } = useAppContext();\n  if (!currentUser) return <Navigate to=\"/login\" />;\n  return currentUser.role === UserRole.SuperAdmin ? <>{children}</> : <Navigate to=\"/\" />;\n};\n\nconst PageLoader: React.FC = () => (\n  <div className=\"flex justify-center items-center w-full h-96\">\n    <div\n      className=\"animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-brand-blue-500\"\n      role=\"status\"\n    >\n      <span className=\"sr-only\">Loading...</span>\n    </div>\n  </div>\n);\n\nconst LoginPage = lazy(() => import('./pages/LoginPage'));\n\n// Komponen untuk menangani pendaftaran PWA\nconst PwaStatusHandler: React.FC = () => {\n  React.useEffect(() => {\n    const updateSW = registerSW({\n      onOfflineReady() {\n        // PWA ready for offline use - status ditampilkan di Header\n      },\n      onNeedRefresh() {\n        // Auto update service worker saat ada versi baru\n        if (updateSW) {\n          updateSW(); // Trigger update (reloadPage is configured in vite.config.ts)\n        }\n      },\n      immediate: true, // Check for updates immediately\n    });\n\n    // Check for updates setiap 1 jam\n    const interval = setInterval(\n      () => {\n        if (updateSW) {\n          updateSW(); // Check for updates without forcing reload\n        }\n      },\n      60 * 60 * 1000,\n    ); // 1 hour\n\n    return () => clearInterval(interval);\n  }, []);\n\n  return null;\n};\n\n// Versi aplikasi otomatis dari package.json\n// Pastikan resolveJsonModule diaktifkan di tsconfig.json\nimport pkg from '../package.json';\nconst APP_VERSION = `v${pkg.version}`;\n\nconst AppRoutes: React.FC = () => {\n  const { currentUser, signOut } = useAppContext();\n  const { settings, isLoading: isLoadingSettings } = useSettings();\n  const [isAuthChecking, setIsAuthChecking] = React.useState(true);\n\n  // Tunggu auth check selesai\n  React.useEffect(() => {\n    const checkAuth = async () => {\n      // Beri waktu untuk auth check selesai\n      await new Promise((resolve) => setTimeout(resolve, 100));\n      setIsAuthChecking(false);\n    };\n    checkAuth();\n  }, []);\n\n  // Handler untuk logout dari maintenance mode\n  const handleMaintenanceLogout = React.useCallback(async () => {\n    await signOut();\n    window.location.href = '/login';\n  }, [signOut]);\n\n  // Tampilkan loader saat checking auth ATAU loading settings\n  if (isAuthChecking || isLoadingSettings) {\n    return <PageLoader />;\n  }\n\n  // Jika belum login, tampilkan halaman login (jangan cek maintenance mode)\n  if (currentUser === null) {\n    return (\n      <Suspense fallback={<PageLoader />}>\n        <Routes>\n          <Route path=\"/settings\" element={<Navigate to=\"/management/settings\" replace />} />\n          <Route path=\"/login\" element={<LoginPage />} />\n          <Route path=\"*\" element={<Navigate to=\"/login\" />} />\n        </Routes>\n      </Suspense>\n    );\n  }\n\n  // Setelah login, cek maintenance mode (kecuali Super Admin)\n  const isMaintenanceMode =\n    settings?.isMaintenanceMode && currentUser?.role !== UserRole.SuperAdmin;\n\n  if (isMaintenanceMode) {\n    return (\n      <MaintenanceMode message={settings?.maintenanceMessage} onLogout={handleMaintenanceLogout} />\n    );\n  }\n\n  return (\n    <>\n      <Layout>\n        <Suspense fallback={<PageLoader />}>\n          <Routes>\n            <Route path=\"/settings\" element={<Navigate to=\"/management/settings\" replace />} />\n            <Route path=\"/login\" element={<Navigate to=\"/\" />} />\n            <Route path=\"/\" element={<Dashboard />} />\n            <Route path=\"/quick-actions\" element={<QuickActionsPage />} />\n            <Route path=\"/transactions\" element={<TransactionPage />} />\n            <Route path=\"/transactions/new\" element={<NewTransactionPage />} />\n            <Route path=\"/transactions/:id/receipt\" element={<ReceiptPage />} />\n            <Route path=\"/transactions/:id/details\" element={<TransactionDetailPage />} />\n            {/* Admin Routes */}\n            <Route\n              path=\"/management/customers\"\n              element={\n                <AdminRoute>\n                  <CustomersPage />\n                </AdminRoute>\n              }\n            />\n            <Route\n              path=\"/management/customers/:id\"\n              element={\n                <AdminRoute>\n                  <CustomerDetailPage />\n                </AdminRoute>\n              }\n            />\n            <Route\n              path=\"/management/assets\"\n              element={\n                <AdminRoute>\n                  <AssetsPage />\n                </AdminRoute>\n              }\n            />\n            <Route\n              path=\"/management/inventory\"\n              element={\n                <AdminRoute>\n                  <InventoryPage />\n                </AdminRoute>\n              }\n            />\n            <Route\n              path=\"/management/services\"\n              element={\n                <AdminRoute>\n                  <ServicesPage />\n                </AdminRoute>\n              }\n            />\n            <Route\n              path=\"/management/expenses\"\n              element={\n                <AdminRoute>\n                  <ExpensesPage />\n                </AdminRoute>\n              }\n            />\n            <Route\n              path=\"/management/stores\"\n              element={\n                <SuperAdminRoute>\n                  <StoresPage />\n                </SuperAdminRoute>\n              }\n            />\n            <Route\n              path=\"/management/users\"\n              element={\n                <AdminRoute>\n                  <UsersPage />\n                </AdminRoute>\n              }\n            />\n            <Route\n              path=\"/management/settings\"\n              element={\n                <AdminRoute>\n                  <SettingsPage />\n                </AdminRoute>\n              }\n            />\n            <Route\n              path=\"/reports\"\n              element={\n                <AdminRoute>\n                  <ReportsPage />\n                </AdminRoute>\n              }\n            />\n            <Route\n              path=\"/audit-log\"\n              element={\n                <AdminRoute>\n                  <AuditLogPage />\n                </AdminRoute>\n              }\n            />\n            {/* Tambahkan catch-all route di bawah ini */}\n            <Route path=\"*\" element={<Navigate to=\"/\" replace />} />\n          </Routes>\n        </Suspense>\n        <CommandPalette />\n        {/* Tampilkan versi aplikasi di pojok kanan bawah */}\n        <div\n          style={{\n            position: 'fixed',\n            right: 12,\n            bottom: 8,\n            zIndex: 50,\n            fontSize: 12,\n            color: '#64748b',\n            opacity: 0.7,\n            pointerEvents: 'none',\n            userSelect: 'none',\n          }}\n        >\n          {APP_VERSION}\n        </div>\n      </Layout>\n      <PwaStatusHandler />\n    </>\n  );\n};\n\nconst App: React.FC = () => {\n  useTheme(); // Initialize and apply theme\n  return (\n    <AppProviders>\n      <Router future={{ v7_startTransition: true, v7_relativeSplatPath: true }}>\n        <AppRoutes />\n      </Router>\n    </AppProviders>\n  );\n};\n\nexport default App;\n","usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\__tests__\\components\\AssetFormModal.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\__tests__\\components\\BottomNavBar.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\__tests__\\components\\CommandPalette.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src\\__tests__\\components\\ConfirmationModal.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\.github_mhmdnvn18@gmail.com\\emaklaundry_kasir\\src